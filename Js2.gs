"   <div style=\"padding:10px 22px 16px;border-top:1px solid #edf1f6;margin-top:8px;font-size:11px;color:#8a97a8;text-align:center\">\u062a\u0645 \u0625\u0631\u0633\u0627\u0644 \u0647\u0630\u0627 \u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u0628\u0648\u0627\u0633\u0637\u0629 ${senderTitle()}: ${esc(me&&me.name||\"\")}<br>${dmy(todayISO())}</div></div>`;",
"}",
"async function noticePNG(day,i){",
"  await loadLib(\"h2c\");try{await document.fonts.ready}catch(e){}",
"  const st=$(\"#stage\");st.className=\"\";st.innerHTML=noticeCardHTML(day,i);",
"  const c=await html2canvas(st.firstElementChild,{scale:2,backgroundColor:\"#ffffff\",logging:false});st.innerHTML=\"\";",
"  return await new Promise(r=>c.toBlob(r,\"image/png\"));",
"}",
"const blobURL=b=>new Promise(r=>{const f=new FileReader();f.onload=()=>r(f.result);f.readAsDataURL(b)});",
"/* the image goes straight to the employee's own WhatsApp chat: it is copied, her chat opens with the message,",
"   and the supervisor pastes it. Without a phone number the phone's share sheet is used instead. */",
"async function copyImage(blob){try{if(navigator.clipboard&&window.ClipboardItem){await navigator.clipboard.write([new ClipboardItem({\"image/png\":blob})]);return true}}catch(e){}return false}",
"async function sendAsImage(date,i,bt){",
"  const day=leadDay(date);if(!day)return;const t=bt.innerHTML;bt.disabled=true;bt.textContent=\"\u062c\u0627\u0631\u064d \u0627\u0644\u062a\u062c\u0647\u064a\u0632\u2026\";",
"  try{const tk=newTk(),b=day.boxes[i],ph=intlPhone(phoneOf(b.cashier)),msg=shortMsg(day,i,tk),blob=await noticePNG(day,i),name=`\u0627\u0634\u0639\u0627\u0631-${BN(i)}-${date}.png`;",
"    if(!ph){const r=await shareImage(blob,name,\"\u0625\u0634\u0639\u0627\u0631 \u0627\u0644\u0635\u0646\u062f\u0648\u0642\",msg);if(r!==\"cancel\")await markSent(date,i,tk)}",
"    else{",
"      const copied=await copyImage(blob);if(!copied)await saveFile(name,blob);",
"      const url=`https://wa.me/${ph}?text=${encodeURIComponent(msg)}`;let w=null;try{w=window.open(url,\"_blank\")}catch(e){}",
"      await markSent(date,i,tk);",
"      const s=sheet(\"\u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u0644\u0640 \"+esc(b.cashier||\"\"),`<div class=\"imgsteps\">",
"        <div class=\"st1\"><b>1</b><span>${copied?\"\u062a\u0645 \u0646\u0633\u062e \u0635\u0648\u0631\u0629 \u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u2713\":\"\u062a\u0645 \u062d\u0641\u0638 \u0635\u0648\u0631\u0629 \u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u0641\u064a \u062c\u0647\u0627\u0632\u0643 \u2713\"}</span></div>",
"        <div class=\"st1\"><b>2</b><span>${w?`\u0627\u0646\u0641\u062a\u062d\u062a \u0645\u062d\u0627\u062f\u062b\u0629 ${G(b.cashier,\"\u0627\u0644\u0645\u0648\u0638\u0641\u0629\",\"\u0627\u0644\u0645\u0648\u0638\u0641\")} \u0641\u064a \u0648\u0627\u062a\u0633\u0627\u0628`:`${meF(\"\u0627\u0641\u062a\u062d\u064a\",\"\u0627\u0641\u062a\u062d\")} \u0645\u062d\u0627\u062f\u062b\u0629 ${G(b.cashier,\"\u0627\u0644\u0645\u0648\u0638\u0641\u0629\",\"\u0627\u0644\u0645\u0648\u0638\u0641\")} \u0645\u0646 \u0627\u0644\u0632\u0631 \u062a\u062d\u062a`}\u060c \u0648\u0631\u0633\u0627\u0644\u0629 \u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u0645\u0643\u062a\u0648\u0628\u0629 \u0641\u064a\u0647\u0627</span></div>",
"        <div class=\"st1\"><b>3</b><span>${copied?meF(\"\u0627\u0636\u063a\u0637\u064a \u0645\u0637\u0648\u0644\u0627\u064b \u0641\u064a \u062e\u0627\u0646\u0629 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0648\u0627\u062e\u062a\u0627\u0631\u064a \u00ab\u0644\u0635\u0642\u00bb \u0644\u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0635\u0648\u0631\u0629\u060c \u062b\u0645 \u0623\u0631\u0633\u0644\u064a\",\"\u0627\u0636\u063a\u0637 \u0645\u0637\u0648\u0644\u0627\u064b \u0641\u064a \u062e\u0627\u0646\u0629 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0648\u0627\u062e\u062a\u0631 \u00ab\u0644\u0635\u0642\u00bb \u0644\u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0635\u0648\u0631\u0629\u060c \u062b\u0645 \u0623\u0631\u0633\u0644\"):meF(\"\u0627\u0636\u063a\u0637\u064a \ud83d\udcce \u0648\u0627\u062e\u062a\u0627\u0631\u064a \u0627\u0644\u0635\u0648\u0631\u0629 \u0645\u0646 \u0627\u0644\u0645\u0639\u0631\u0636\u060c \u062b\u0645 \u0623\u0631\u0633\u0644\u064a\",\"\u0627\u0636\u063a\u0637 \ud83d\udcce \u0648\u0627\u062e\u062a\u0631 \u0627\u0644\u0635\u0648\u0631\u0629 \u0645\u0646 \u0627\u0644\u0645\u0639\u0631\u0636\u060c \u062b\u0645 \u0623\u0631\u0633\u0644\")}</span></div></div>`,",
"        `<a class=\"btn primary\" href=\"${url}\" target=\"_blank\" rel=\"noopener\">\u0641\u062a\u062d \u0648\u0627\u062a\u0633\u0627\u0628 ${esc(b.cashier||\"\")}</a><button class=\"btn\" data-close>\u062a\u0645</button>`);",
"    }}",
"  catch(e){toast(\"\u062a\u0639\u0630\u0651\u0631 \u062a\u062c\u0647\u064a\u0632 \u0627\u0644\u0635\u0648\u0631\u0629\")}",
"  bt.disabled=false;bt.innerHTML=t;",
"}",
"/* ---------- attendance from closings ---------- */",
"const WEEK=[\"\u0627\u0644\u0633\u0628\u062a\",\"\u0627\u0644\u0623\u062d\u062f\",\"\u0627\u0644\u0625\u062b\u0646\u064a\u0646\",\"\u0627\u0644\u062b\u0644\u0627\u062b\u0627\u0621\",\"\u0627\u0644\u0623\u0631\u0628\u0639\u0627\u0621\",\"\u0627\u0644\u062e\u0645\u064a\u0633\",\"\u0627\u0644\u062c\u0645\u0639\u0629\"];",
"const ATT={p:[\"\u062d\u0627\u0636\u0631\",\"ok\"],po:[\"\u062d\u0627\u0636\u0631 \u064a\u0648\u0645 \u0627\u0644\u0623\u0648\u0641\",\"over\"],a:[\"\u063a\u064a\u0627\u0628\",\"short\"],o:[\"\u0623\u0648\u0641\",\"off\"]};",
"let att=Object.assign(mkP(),{});",
"function staffOf(n){return(settings.staff||{})[n]||null}",
"function schedAt(n,date){const st=staffOf(n);if(!st||!st.sched)return null;const m=date.slice(0,7);let best=null;Object.keys(st.sched).sort().forEach(k=>{if(k<=m)best=st.sched[k]});return best}",
"function namesIn(b){return String(b.cashier||\"\").split(\" / \").map(s=>s.trim()).filter(Boolean)}",
"function attBuild(from,to){",
"  const t=todayISO(),pres={},boxesOf={},dates=[];",
"  for(let d=from;d<=to;d=addDays(d,1)){dates.push(d);const raw=days.get(d);if(!raw||raw.namesOnly)continue;",
"    normDay(raw).boxes.forEach((b,i)=>{if(!hasData(b))return;namesIn(b).forEach(n=>{(pres[d]||(pres[d]={}))[n]=1;((boxesOf[d]||(boxesOf[d]={}))[n]||(boxesOf[d][n]=[])).push(BN(i))})})}",
"  const names=new Set(Object.keys(settings.staff||{}));Object.values(pres).forEach(o=>Object.keys(o).forEach(n=>names.add(n)));",
"  const rows=[];",
"  names.forEach(n=>{const st=staffOf(n)||{};const cells=[];const c={p:0,po:0,a:0,o:0};",
"    dates.forEach(d=>{const here=!!(pres[d]&&pres[d][n]);let s=\"\";",
"      const out=(st.start&&d<st.start)||(st.end&&d>st.end);const sc=schedAt(n,d);const off=!!(sc&&sc.off&&sc.off===dayName(d));",
"      if(here)s=off?\"po\":\"p\";",
"      else if(out||d>=t||!pres[d]||(sc&&sc.type===\"\u0628\u062f\u064a\u0644\"))s=\"\";",
"      else s=off?\"o\":\"a\";",
"      if(s)c[s]++;cells.push({d,s,box:here?(boxesOf[d][n]||[]).join(\"\u060c \"):\"\"})});",
"    if(c.p+c.po+c.a+c.o===0)return;",
"    const sc=schedAt(n,to);rows.push({name:n,c,cells,off:sc&&sc.off||\"\",type:sc&&sc.type||\"\"})});",
"  rows.sort((a,b)=>b.c.a-a.c.a||a.name.localeCompare(b.name,\"ar\"));",
"  return{rows,dates};",
"}",
"function renderAtt(){",
"  const [from,to,label]=periodRange(att);const A0=attBuild(from,to),V=attView(),A=attFilter(A0,V);",
"  const T=A.rows.reduce((s,r)=>{[\"p\",\"po\",\"a\",\"o\"].forEach(k=>s[k]+=r.c[k]);return s},{p:0,po:0,a:0,o:0});",
"  $(\"#view\").innerHTML=`${periodCtrl(att)}",
"  <div class=\"info\">\u0627\u0644\u062d\u0636\u0648\u0631 \u0645\u0646 \u062d\u0631\u0643\u0629 \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631: \u064a\u0648\u0645 \u0641\u064a\u0647 \u062a\u0642\u0631\u064a\u0631 \u0644\u0644\u0645\u0648\u0638\u0641\u0629 = \u062d\u0627\u0636\u0631\u060c \u0648\u064a\u0648\u0645 \u0628\u062f\u0648\u0646 \u062a\u0642\u0631\u064a\u0631 = \u063a\u064a\u0627\u0628\u060c \u0625\u0644\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646 \u064a\u0648\u0645 \u0627\u0644\u0623\u0648\u0641 \u0627\u0644\u062e\u0627\u0635 \u0628\u0647\u0627. \u0623\u064a\u0627\u0645 \u0627\u0644\u062f\u0648\u0627\u0645 \u0627\u0644\u0628\u062f\u064a\u0644 \u0648\u0623\u064a\u0627\u0645 \u0642\u0628\u0644 \u0627\u0644\u0645\u0628\u0627\u0634\u0631\u0629 \u0623\u0648 \u0628\u0639\u062f \u0622\u062e\u0631 \u064a\u0648\u0645 \u0639\u0645\u0644 \u0644\u0627 \u062a\u064f\u062d\u0633\u0628.</div>",
"  ${A.rows.length?`<div class=\"strip\">",
"   <div class=\"stat ok\"><span>\u0623\u064a\u0627\u0645 \u062d\u0636\u0648\u0631</span><b class=\"num\">${T.p+T.po}</b></div>",
"   <div class=\"stat short\"><span>\u0623\u064a\u0627\u0645 \u063a\u064a\u0627\u0628</span><b class=\"num\">${T.a}</b></div>",
"   <div class=\"stat\"><span>\u0623\u064a\u0627\u0645 \u0623\u0648\u0641</span><b class=\"num\">${T.o}</b></div>",
"   <div class=\"stat over\"><span>\u0639\u0645\u0644 \u0641\u064a \u064a\u0648\u0645 \u0627\u0644\u0623\u0648\u0641</span><b class=\"num\">${T.po}</b></div></div>",
"  ${attBar(A0,A,V)}<div class=\"row-btns\"><button class=\"btn primary\" id=\"attPdf\">\u0637\u0628\u0627\u0639\u0629 \u0627\u0644\u062a\u0642\u0631\u064a\u0631</button><button class=\"btn\" id=\"attCsv\">\u062a\u0635\u062f\u064a\u0631 Excel</button></div>",
"  <div class=\"tbl-wrap\"><table><thead><tr><th>\u0627\u0644\u0645\u0648\u0638\u0641\u0629</th><th>\u0627\u0644\u0623\u0648\u0641</th><th class=\"n\">\u062d\u0636\u0648\u0631</th><th class=\"n\">\u063a\u064a\u0627\u0628</th><th class=\"n\">\u0623\u0648\u0641</th><th class=\"n\">\u0639\u0645\u0644 \u0628\u0627\u0644\u0623\u0648\u0641</th></tr></thead><tbody>",
"   ${A.rows.map((r,k)=>`<tr class=\"click\" data-att=\"${k}\"><td>${esc(r.name)}${r.type===\"\u0628\u062f\u064a\u0644\"?' <span class=\"note\">(\u0628\u062f\u064a\u0644)</span>':\"\"}</td><td>${esc(r.off)||\"\u2014\"}</td><td class=\"n num\">${r.c.p+r.c.po}</td><td class=\"n num ${r.c.a?\"neg\":\"\"}\">${r.c.a}</td><td class=\"n num\">${r.c.o}</td><td class=\"n num ${r.c.po?\"pos\":\"\"}\">${r.c.po}</td></tr>`).join(\"\")}</tbody></table></div>",
"  <p class=\"note\">\u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641\u0629 \u0644\u0639\u0631\u0636 \u0623\u064a\u0627\u0645\u0647\u0627 \u064a\u0648\u0645\u0627\u064b \u0628\u064a\u0648\u0645.</p>`",
"  :A0.rows.length?`${attBar(A0,A,V)}<div class=\"card empty\">\u0643\u0644 \u0627\u0644\u0645\u0648\u0638\u0641\u0627\u062a \u0645\u062e\u0641\u064a\u0627\u062a \u0628\u0633\u0628\u0628 \u0627\u0644\u062a\u062e\u0635\u064a\u0635.</div>`:`<div class=\"card empty\">\u0644\u0627 \u062a\u0648\u062c\u062f \u0628\u064a\u0627\u0646\u0627\u062a \u062d\u0636\u0648\u0631 \u0641\u064a ${label}.</div>`}`;",
"  bindPeriod(att,renderAtt);const vb=$(\"#attView\");if(vb)vb.onclick=()=>attViewEdit(A0);const va=$(\"#attAll\");if(va)va.onclick=()=>attViewSave({hide:[],boxes:[]});",
"  $(\"#view\").querySelectorAll(\"[data-att]\").forEach(tr=>tr.onclick=()=>attDetail(A.rows[+tr.dataset.att],label));",
"  const p=$(\"#attPdf\");if(p)p.onclick=()=>preview(\"\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u062d\u0636\u0648\u0631\",rcptAtt(A,label),`\u0627\u0644\u062d\u0636\u0648\u0631-${label.replace(/[\\s/]+/g,\"-\")}.pdf`);",
"  const c=$(\"#attCsv\");if(c)c.onclick=()=>xlsxAtt(A,label);",
"}",
"function attDetail(r,label){",
"  const list=r.cells.filter(x=>x.s).map(x=>`<div class=\"calc\" style=\"font-weight:400\"><span>${dayName(x.d)} <span class=\"num\">${dmy(x.d)}</span></span><span class=\"pill ${({p:\"saved\",po:\"dirty\",a:\"err\",o:\"new\"})[x.s]}\">${ATT[x.s][0]}${x.box?` \u2014 <span class=\"num\">${x.box}</span>`:\"\"}</span></div>`).join(\"\");",
"  const s=sheet(esc(r.name),`<p class=\"note\" style=\"margin:8px 0\">${label}${r.off?` \u2014 \u064a\u0648\u0645 \u0627\u0644\u0623\u0648\u0641: <b>${esc(r.off)}</b>`:\"\"}</p>",
"   <div class=\"strip\" style=\"margin-bottom:8px\"><div class=\"stat ok\"><span>\u062d\u0636\u0648\u0631</span><b class=\"num\">${r.c.p+r.c.po}</b></div><div class=\"stat short\"><span>\u063a\u064a\u0627\u0628</span><b class=\"num\">${r.c.a}</b></div></div>${list}`,",
"   `<button class=\"btn primary\" id=\"attOne\">\u0637\u0628\u0627\u0639\u0629</button><button class=\"btn\" data-close>\u0625\u063a\u0644\u0627\u0642</button>`);",
"  $(\"#attOne\").onclick=()=>preview(\"\u062d\u0636\u0648\u0631 \"+r.name,rcptAttOne(r,label),`\u062d\u0636\u0648\u0631-${r.name}-${label.replace(/[\\s/]+/g,\"-\")}.pdf`);",
"}",
"function rcptAtt(A,label){",
"  return`<div class=\"rcpt\">${head(\"\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u062d\u0636\u0648\u0631 \u0648\u0627\u0644\u063a\u064a\u0627\u0628\",`<div class=\"c\" style=\"font-weight:700\">${label}</div>`)}",
"  <table><thead><tr><th>\u0627\u0644\u0645\u0648\u0638\u0641\u0629</th><th class=\"n\">\u062d\u0636\u0648\u0631</th><th class=\"n\">\u063a\u064a\u0627\u0628</th><th class=\"n\">\u0623\u0648\u0641</th></tr></thead><tbody>",
"  ${A.rows.map(r=>`<tr><td class=\"who\" style=\"max-width:130px\">${esc(r.name)}</td><td class=\"n\">${r.c.p+r.c.po}</td><td class=\"n\">${r.c.a}</td><td class=\"n\">${r.c.o}</td></tr>`).join(\"\")}</tbody></table>",
"  ${sigs()}<div class=\"foot\">\u0634\u0643\u0631\u0627\u064b \u0644\u0643\u0645</div></div>`;",
"}",
"function rcptAttOne(r,label){",
"  return`<div class=\"rcpt\">${head(\"\u0643\u0634\u0641 \u062d\u0636\u0648\u0631 \u0645\u0648\u0638\u0641\u0629\",`<div class=\"c\" style=\"font-weight:700\">${esc(r.name)} \u2014 ${label}</div>`)}",
"  ${R(\"\u064a\u0648\u0645 \u0627\u0644\u0623\u0648\u0641\",esc(r.off)||\"\u2014\")}${R(\"\u0623\u064a\u0627\u0645 \u0627\u0644\u062d\u0636\u0648\u0631\",r.c.p+r.c.po)}${R(\"\u0623\u064a\u0627\u0645 \u0627\u0644\u063a\u064a\u0627\u0628\",r.c.a)}${R(\"\u0623\u064a\u0627\u0645 \u0627\u0644\u0623\u0648\u0641\",r.c.o)}${R(\"\u0639\u0645\u0644 \u0641\u064a \u064a\u0648\u0645 \u0627\u0644\u0623\u0648\u0641\",r.c.po)}",
"  <table><thead><tr><th>\u0627\u0644\u064a\u0648\u0645</th><th>\u0627\u0644\u062a\u0627\u0631\u064a\u062e</th><th>\u0627\u0644\u062d\u0627\u0644\u0629</th></tr></thead><tbody>",
"  ${r.cells.filter(x=>x.s).map(x=>`<tr><td>${dayName(x.d)}</td><td>${dmy(x.d)}</td><td>${ATT[x.s][0]}</td></tr>`).join(\"\")}</tbody></table>",
"  <div class=\"sig\"><div>\u062a\u0648\u0642\u064a\u0639 \u0627\u0644\u0645\u0648\u0638\u0641\u0629</div><div>${esc(settings.signB)}</div></div><div class=\"foot\">\u0634\u0643\u0631\u0627\u064b \u0644\u0643\u0645</div></div>`;",
"}",
"function attCSV(A,label){",
"  const q=v=>{v=String(v??\"\");return/[\",\\n]/.test(v)?'\"'+v.replace(/\"/g,'\"\"')+'\"':v};",
"  const lines=[[\"\u0627\u0644\u0645\u0648\u0638\u0641\u0629\",\"\u0627\u0644\u062a\u0627\u0631\u064a\u062e\",\"\u0627\u0644\u064a\u0648\u0645\",\"\u0627\u0644\u062d\u0627\u0644\u0629\",\"\u0627\u0644\u0635\u0646\u062f\u0648\u0642\"].map(q).join(\",\")];",
"  A.rows.forEach(r=>r.cells.forEach(x=>{if(x.s)lines.push([r.name,x.d,dayName(x.d),ATT[x.s][0],x.box].map(q).join(\",\"))}));",
"  saveFile(`\u0627\u0644\u062d\u0636\u0648\u0631-${label.replace(/[\\s/]+/g,\"-\")}.csv`,new Blob([\"\\ufeff\"+lines.join(\"\\r\\n\")],{type:\"text/csv\"}));",
"}",
"",
"",
"/* ---------- attendance: choose employees / boxes ---------- */",
"function attView(){",
"  if(effectiveRole()===\"acc\")return{hide:settings.attHide||[],boxes:settings.attBoxes||[]};",
"  const v=ls.get(\"ccd-attview\");return{hide:(v&&v.hide)||[],boxes:(v&&v.boxes)||[]};",
"}",
"function rowBoxes(r){const set=new Set();r.cells.forEach(x=>String(x.box||\"\").split(/[\u060c,]\\s*/).forEach(b=>{if(b.trim())set.add(+b.trim())}));",
"  (settings.boxNames||[]).forEach((n,i)=>{if(n&&String(n).split(\" / \").map(s=>s.trim()).indexOf(r.name)>=0)set.add(BN(i))});return set}",
"function attFilter(A,V){",
"  const H=new Set(V.hide),B=V.boxes.map(Number);",
"  return Object.assign({},A,{rows:A.rows.filter(r=>!H.has(r.name)&&(!B.length||[...rowBoxes(r)].some(b=>B.indexOf(b)>=0)))});",
"}",
"function attBar(A0,A,V){",
"  const on=V.hide.length||V.boxes.length;",
"  return`<div class=\"info lgbar\"><span>${on?`\u0645\u0639\u0631\u0648\u0636 <b class=\"num\">${A.rows.length}</b> \u0645\u0646 <b class=\"num\">${A0.rows.length}</b> \u0645\u0648\u0638\u0641\u0629${V.boxes.length?` \u2014 \u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642: <span class=\"num\">${V.boxes.join(\"\u060c \")}</span>`:\"\"}`:`\u0645\u0639\u0631\u0648\u0636 \u0643\u0644 \u0627\u0644\u0645\u0648\u0638\u0641\u0627\u062a (<b class=\"num\">${A0.rows.length}</b>)`}</span>",
"   <span style=\"display:flex;gap:6px\">${on?`<button class=\"btn small\" id=\"attAll\">\u0625\u0638\u0647\u0627\u0631 \u0627\u0644\u0643\u0644</button>`:\"\"}<button class=\"btn small\" id=\"attView\">\u062a\u062e\u0635\u064a\u0635</button></span></div>`;",
"}",
"async function attViewSave(v){",
"  if(effectiveRole()===\"acc\"){settings.attHide=v.hide;settings.attBoxes=v.boxes;await saveSettings()}",
"  else ls.set(\"ccd-attview\",v);",
"  if(!layerOpen())renderAtt();",
"}",
"function attViewEdit(A0){",
"  const V=attView(),names=[...new Set(A0.rows.map(r=>r.name).concat(V.hide))].sort((a,b)=>a.localeCompare(b,\"ar\"));",
"  const boxes=Array.from({length:BOXES},(_,i)=>i).filter(i=>!boxHidden(i)).map(BN);",
"  const s=sheet(\"\u062a\u062e\u0635\u064a\u0635 \u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u062d\u0636\u0648\u0631\",`<p class=\"note\" style=\"margin:8px 0\">\u0627\u062e\u062a\u0631 \u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642 \u0627\u0644\u0644\u064a \u062a\u0628\u063a\u0649 \u062a\u0634\u0648\u0641 \u0645\u0648\u0638\u0641\u0627\u062a\u0647\u0627\u060c \u0648\u0634\u064a\u0644 \u0627\u0644\u0635\u062d \u0639\u0646 \u0623\u064a \u0645\u0648\u0638\u0641\u0629 \u062a\u0628\u063a\u0649 \u062a\u062e\u0641\u064a\u0647\u0627 \u0645\u0646 \u0627\u0644\u062a\u0642\u0631\u064a\u0631.</p>",
"   <div class=\"sec-h\"><b>\u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642</b><span class=\"note\">\u0628\u062f\u0648\u0646 \u0627\u062e\u062a\u064a\u0627\u0631 = \u0643\u0644 \u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642</span></div>",
"   <div class=\"bxpick\">${boxes.map(b=>`<label class=\"chip\"><input type=\"checkbox\" data-vb=\"${b}\" ${V.boxes.indexOf(b)>=0?\"checked\":\"\"}><span class=\"num\">${b}</span></label>`).join(\"\")}</div>",
"   <div class=\"sec-h\" style=\"margin-top:12px\"><b>\u0627\u0644\u0645\u0648\u0638\u0641\u0627\u062a</b><span style=\"display:flex;gap:6px\"><button class=\"btn small\" id=\"vAllOn\" type=\"button\">\u0627\u0644\u0643\u0644</button><button class=\"btn small\" id=\"vAllOff\" type=\"button\">\u0644\u0627 \u0623\u062d\u062f</button></span></div>",
"   <input class=\"inp\" id=\"vFind\" placeholder=\"\u0628\u062d\u062b \u0628\u0627\u0644\u0627\u0633\u0645\" style=\"margin-bottom:8px\">",
"   <div class=\"ulist\" id=\"vNames\">${names.map(n=>`<label class=\"chk vrow\"><input type=\"checkbox\" data-vn=\"${esc(n)}\" ${V.hide.indexOf(n)<0?\"checked\":\"\"}>${esc(n)}</label>`).join(\"\")}</div>`,",
"   `<button class=\"btn primary\" id=\"vSave\">\u062d\u0641\u0638</button><button class=\"btn\" data-close>\u0625\u0644\u063a\u0627\u0621</button>`);",
"  $(\"#vFind\").oninput=e=>{const q=e.target.value.trim();s.el.querySelectorAll(\".vrow\").forEach(r=>r.hidden=q&&r.textContent.indexOf(q)<0)};",
"  $(\"#vAllOn\").onclick=()=>s.el.querySelectorAll(\"[data-vn]\").forEach(x=>{if(!x.closest(\".vrow\").hidden)x.checked=true});",
"  $(\"#vAllOff\").onclick=()=>s.el.querySelectorAll(\"[data-vn]\").forEach(x=>{if(!x.closest(\".vrow\").hidden)x.checked=false});",
"  $(\"#vSave\").onclick=async()=>{const v={hide:[...s.el.querySelectorAll(\"[data-vn]\")].filter(x=>!x.checked).map(x=>x.dataset.vn),boxes:[...s.el.querySelectorAll(\"[data-vb]\")].filter(x=>x.checked).map(x=>+x.dataset.vb)};",
"    s.close();await attViewSave(v)};",
"}",
"/* ---------- edit history ---------- */",
"let logP=Object.assign(mkP(),{mode:\"week\"}),logF={box:\"\",by:\"\"},logRows=null,logKey=\"\";",
"function logTime(at){const m=String(at||\"\").match(/(\\d{4})\\/(\\d{2})\\/(\\d{2}) (\\d{2}):(\\d{2})/);if(!m)return esc(at||\"\");let h=+m[4];const ap=h<12?\"\u0635\":\"\u0645\";h=h%12||12;return`<span class=\"num\">${m[3]}/${m[2]} ${h}:${m[5]}</span> ${ap}`}",
"function logChange(c){return String(c||\"\").split(\" | \").map(x=>`<div>${esc(x)}</div>`).join(\"\")}",
"async function loadLog(force){",
"  const [f,t]=periodRange(logP),k=f+\"|\"+t;",
"  if(!force&&logRows&&logKey===k)return;",
"  logRows=null;logKey=k;",
"  try{const r=await api(\"audit\",{from:f,to:t});if(logKey===k)logRows=r}catch(e){if(logKey===k){logRows=[];toast(e.msg||\"\u062a\u0639\u0630\u0651\u0631 \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0633\u062c\u0644\")}}",
"}",
"function logFiltered(){return(logRows||[]).filter(r=>(!logF.box||String(r.box)===logF.box)&&(!logF.by||r.by===logF.by))}",
"function renderLog(){",
"  const [,,label]=periodRange(logP);",
"  if(!logRows||logKey!==periodRange(logP).slice(0,2).join(\"|\")){",
"    $(\"#view\").innerHTML=`${periodCtrl(logP)}<div class=\"card empty\">\u062c\u0627\u0631\u064d \u062a\u062d\u0645\u064a\u0644 \u0633\u062c\u0644 \u0627\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a\u2026</div>`;bindPeriod(logP,renderLog);",
"    loadLog().then(()=>{if(tab===\"log\"&&!layerOpen())renderLog()});return}",
"  const L=logFiltered(),boxes=[...new Set(logRows.map(r=>String(r.box)))].sort(),users=[...new Set(logRows.map(r=>r.by))].sort();",
"  const byUser={},byBox={};L.forEach(r=>{byUser[r.by]=(byUser[r.by]||0)+1;byBox[r.box]=(byBox[r.box]||0)+1});",
"  const top=Object.entries(byBox).sort((a,b)=>b[1]-a[1]).slice(0,5);",
"  $(\"#view\").innerHTML=`${periodCtrl(logP)}",
"  <div class=\"info\">\u0643\u0644 \u062a\u0639\u062f\u064a\u0644 \u0639\u0644\u0649 \u0635\u0646\u062f\u0648\u0642 \u0623\u0648 \u0645\u0631\u062a\u062c\u0639 \u0628\u0639\u062f \u062d\u0641\u0638\u0647 \u0623\u0648\u0644 \u0645\u0631\u0629 \u064a\u064f\u0633\u062c\u064e\u0651\u0644 \u0647\u0646\u0627: \u0627\u0644\u0642\u064a\u0645\u0629 \u0642\u0628\u0644 \u0648\u0628\u0639\u062f\u060c \u0648\u0645\u0646 \u0639\u062f\u0651\u0644\u0647\u0627\u060c \u0648\u0648\u0642\u062a \u0627\u0644\u062a\u0639\u062f\u064a\u0644.</div>",
"  <div class=\"period\"><select class=\"inp\" id=\"lgBox\" aria-label=\"\u0627\u0644\u0635\u0646\u062f\u0648\u0642\"><option value=\"\">\u0643\u0644 \u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642</option>${boxes.map(b=>`<option ${b===logF.box?\"selected\":\"\"}>${esc(b)}</option>`).join(\"\")}</select>",
"   <select class=\"inp\" id=\"lgBy\" aria-label=\"\u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\"><option value=\"\">\u0643\u0644 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646</option>${users.map(u=>`<option ${u===logF.by?\"selected\":\"\"}>${esc(u)}</option>`).join(\"\")}</select></div>",
"  ${L.length?`<div class=\"strip\"><div class=\"stat\"><span>\u0639\u062f\u062f \u0627\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a</span><b class=\"num\">${L.length}</b></div>",
"   ${Object.entries(byUser).map(([u,n])=>`<div class=\"stat\"><span>${esc(u)}</span><b class=\"num\">${n}</b></div>`).join(\"\")}</div>",
"   ${top.length>1?`<p class=\"note\">\u0627\u0644\u0623\u0643\u062b\u0631 \u062a\u0639\u062f\u064a\u0644\u0627\u064b: ${top.map(([b,n])=>`<b>${esc(b)}</b> (<span class=\"num\">${n}</span>)`).join(\"\u060c \")}</p>`:\"\"}",
"   <div class=\"row-btns\"><button class=\"btn primary\" id=\"lgPdf\">\u0637\u0628\u0627\u0639\u0629 \u0627\u0644\u0633\u062c\u0644</button><button class=\"btn\" id=\"lgX\">\u062a\u0635\u062f\u064a\u0631 Excel</button><button class=\"btn\" id=\"lgR\">\u062a\u062d\u062f\u064a\u062b</button></div>",
"   <div class=\"tbl-wrap\"><table class=\"lg\"><thead><tr><th>\u0627\u0644\u062a\u0627\u0631\u064a\u062e</th><th>\u0627\u0644\u0635\u0646\u062f\u0648\u0642</th><th>\u0627\u0644\u062a\u0639\u062f\u064a\u0644 (\u0642\u0628\u0644 \u2190 \u0628\u0639\u062f)</th><th>\u0639\u062f\u0651\u0644\u0647</th><th>\u0627\u0644\u0648\u0642\u062a</th></tr></thead><tbody>",
"   ${L.map(r=>`<tr><td class=\"num\">${dmy(r.date).slice(0,5)}</td><td><b class=\"num\">${esc(r.box)}</b>${r.cashier?`<div class=\"note\">${esc(r.cashier)}</div>`:\"\"}</td><td class=\"chg\">${logChange(r.change)}</td><td>${esc(r.by)}</td><td>${logTime(r.at)}</td></tr>`).join(\"\")}</tbody></table></div>`",
"  :`<div class=\"card empty\">\u0644\u0627 \u062a\u0648\u062c\u062f \u062a\u0639\u062f\u064a\u0644\u0627\u062a \u0641\u064a ${label}.<br><br><button class=\"btn small\" id=\"lgR\">\u062a\u062d\u062f\u064a\u062b</button></div>`}`;",
"  bindPeriod(logP,renderLog);",
"  $(\"#lgBox\").onchange=e=>{logF.box=e.target.value;renderLog()};",
"  $(\"#lgBy\").onchange=e=>{logF.by=e.target.value;renderLog()};",
"  $(\"#lgR\").onclick=async()=>{await loadLog(true);renderLog()};",
"  const p=$(\"#lgPdf\");if(p)p.onclick=()=>preview(\"\u0633\u062c\u0644 \u0627\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a\",rcptLog(L,label),`\u0633\u062c\u0644-\u0627\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a-${xname(label)}.pdf`);",
"  const x=$(\"#lgX\");if(x)x.onclick=()=>{const rows=[[\"\u0627\u0644\u062a\u0627\u0631\u064a\u062e\",\"\u0627\u0644\u0635\u0646\u062f\u0648\u0642\",\"\u0627\u0644\u0643\u0627\u0634\u064a\u0631\",\"\u0627\u0644\u062a\u0639\u062f\u064a\u0644 (\u0642\u0628\u0644 \u2190 \u0628\u0639\u062f)\",\"\u0639\u062f\u0651\u0644\u0647\",\"\u0648\u0642\u062a \u0627\u0644\u062a\u0639\u062f\u064a\u0644\"]];",
"    L.forEach(r=>rows.push([xd(r.date),r.box,r.cashier,r.change,r.by,r.at]));",
"    xlsxSave(`\u0633\u062c\u0644-\u0627\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a-${xname(label)}.xlsx`,[{name:\"\u0633\u062c\u0644 \u0627\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a\",rows,cols:[12,10,16,60,16,20]}])};",
"}",
"function rcptLog(L,label){",
"  return`<div class=\"rcpt\">${head(\"\u0633\u062c\u0644 \u0627\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a\",`<div class=\"c\" style=\"font-weight:700\">${label}${logF.box?\" \u2014 \u0635\u0646\u062f\u0648\u0642 \"+esc(logF.box):\"\"}${logF.by?\" \u2014 \"+esc(logF.by):\"\"}</div><div class=\"c\">\u0639\u062f\u062f \u0627\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a: ${L.length}</div>`)}",
"  ${L.map(r=>`<div style=\"border-top:1px dashed #999;padding:4px 0\"><div style=\"display:flex;justify-content:space-between\"><b>${dmy(r.date)} \u2014 ${esc(r.box)}</b><span>${esc(r.by)}</span></div>",
"   ${r.cashier?`<div>${esc(r.cashier)}</div>`:\"\"}<div>${logChange(r.change)}</div><div style=\"font-size:.85em\">${esc(r.at)}</div></div>`).join(\"\")}</div>`;",
"}",
"/* history of a single box, from inside its sheet */",
"async function boxHistory(i){",
"  const box=String(BN(i)),d=cur.date;let rows=[];",
"  try{rows=await api(\"audit\",{from:d,to:d,box})}catch(e){toast(e.msg||\"\u062a\u0639\u0630\u0651\u0631 \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0633\u062c\u0644\");return}",
"  const back=()=>openBox(i);",
"  sheet(`\u0633\u062c\u0644 \u0627\u0644\u0635\u0646\u062f\u0648\u0642 ${box}`,rows.length?`<p class=\"note\" style=\"margin:8px 0\">${dayName(d)} ${dmy(d)} \u2014 \u0639\u062f\u062f \u0627\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a: <b class=\"num\">${rows.length}</b></p>",
"   ${rows.map(r=>`<div class=\"lgi\"><div class=\"lgh\"><b>${esc(r.by)}</b><span>${logTime(r.at)}</span></div><div class=\"chg\">${logChange(r.change)}</div></div>`).join(\"\")}`",
"   :`<div class=\"card empty\">\u0644\u0627 \u062a\u0648\u062c\u062f \u062a\u0639\u062f\u064a\u0644\u0627\u062a \u0639\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u0628\u0639\u062f \u062d\u0641\u0638\u0647.</div>`,",
"   `<button class=\"btn primary\" id=\"hBack\">\u0631\u062c\u0648\u0639 \u0644\u0644\u0635\u0646\u062f\u0648\u0642</button><button class=\"btn\" data-close>\u0625\u063a\u0644\u0627\u0642</button>`,afterSheet);",
"  $(\"#hBack\").onclick=back;",
"}",
"function timesAr(n){return n===1?\"\u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629\":n===2?\"\u0645\u0631\u062a\u064a\u0646\":n<=10?n+\" \u0645\u0631\u0627\u062a\":n+\" \u0645\u0631\u0629\"}",
"function isoTime(iso){try{return new Date(iso).toLocaleString(\"ar-SA-u-nu-latn-ca-gregory\",{timeZone:\"Asia/Riyadh\",day:\"2-digit\",month:\"2-digit\",hour:\"numeric\",minute:\"2-digit\"}).replace(/[\\u200e\\u200f]/g,\"\")}catch(e){return\"\"}}",
"function editInfo(i){",
"  const r=effectiveRole();if(r!==\"acc\"&&r!==\"mgr\")return\"\";",
"  const sv=days.get(cur.date),b=sv&&!sv.namesOnly&&sv.boxes?sv.boxes[i]:null;if(!b||!hasData(b))return\"\";",
"  const n=+b.edits||0;",
"  return`<div class=\"info lgbar\"><span>${n?`\u0639\u064f\u062f\u0651\u0644 <b>${timesAr(n)}</b> \u2014 \u0622\u062e\u0631 \u062a\u0639\u062f\u064a\u0644: <b>${esc(b.editedBy||\"\")}</b>${b.editedAt?` <span class=\"num\">${isoTime(b.editedAt)}</span>`:\"\"}`:\"\u0644\u0645 \u064a\u064f\u0639\u062f\u064e\u0651\u0644 \u0628\u0639\u062f \u0623\u0648\u0644 \u062d\u0641\u0638\"}${b.by?`<br><span class=\"note\">\u0623\u062f\u062e\u0644\u0647: ${esc(b.by)}${b.firstAt?` <span class=\"num\">${isoTime(b.firstAt)}</span>`:\"\"}</span>`:\"\"}</span>${n?`<button class=\"btn small\" id=\"bHist\">\u0627\u0644\u0633\u062c\u0644</button>`:\"\"}</div>`;",
"}",
"function editBadge(i){const r=effectiveRole();if(r!==\"acc\"&&r!==\"mgr\")return\"\";const sv=days.get(cur.date),b=sv&&!sv.namesOnly&&sv.boxes?sv.boxes[i]:null;const n=b?+b.edits||0:0;return n?`<span class=\"ed\" title=\"\u0639\u062f\u062f \u0627\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a\">\u270e<span class=\"num\">${n}</span></span>`:\"\"}",
"/* ---------- approval of the supervisor's entries ---------- */",
"const RQF=[\"cashier\",\"shift\",\"cash\",\"report\",\"notes\"];",
"const rqVals=rq=>{const o={};RQF.concat(NV().map(n=>n[0])).forEach(k=>{if(rq[k]!==undefined)o[k]=rq[k]});return o};",
"const rawBox=(date,i)=>{const d=days.get(date);return d&&!d.namesOnly&&d.boxes?d.boxes[i]:null};",
"function rqList(date){",
"  const d=days.get(date);if(!d||d.namesOnly)return{boxes:[],rets:[]};",
"  return{boxes:(d.boxes||[]).map((b,i)=>({b,i})).filter(x=>x.b&&x.b.rq),rets:(d.returns||[]).filter(r=>r.rq)};",
"}",
"function rqBadge(i){",
"  const r=effectiveRole();if(r!==\"acc\"&&r!==\"sup\")return\"\";const b=rawBox(cur.date,i);if(!b)return\"\";",
"  if(b.rq)return`<span class=\"rq\">\u23f3 \u0644\u0644\u0627\u0639\u062a\u0645\u0627\u062f</span>`;",
"  if(r===\"sup\"&&b.apAt&&hasData(b))return`<span class=\"rq ok\">\u2713 \u0645\u0639\u062a\u0645\u062f</span>`;return\"\";",
"}",
"function rqStrip(){",
"  if(effectiveRole()!==\"acc\")return\"\";const L=rqList(cur.date);const n=L.boxes.length,m=L.rets.length;if(!n&&!m)return\"\";",
"  return`<div class=\"info lgbar rqstrip\"><span>\u0628\u0627\u0646\u062a\u0638\u0627\u0631 \u0627\u0639\u062a\u0645\u0627\u062f\u0643: ${n?`<b class=\"num\">${n}</b> \u0635\u0646\u062f\u0648\u0642`:\"\"}${n&&m?\" \u0648\":\"\"}${m?`<b class=\"num\">${m}</b> \u0645\u0631\u062a\u062c\u0639`:\"\"}<br><span class=\"note\">\u0645\u0627 \u062a\u062f\u062e\u0644 \u0641\u064a \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0625\u0644\u0627 \u0628\u0639\u062f \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f.</span></span>",
"   <span style=\"display:flex;gap:6px\"><button class=\"btn small\" id=\"rqRev\">\u0645\u0631\u0627\u062c\u0639\u0629</button><button class=\"btn small primary\" id=\"rqAll\">\u0627\u0639\u062a\u0645\u0627\u062f \u0627\u0644\u0643\u0644</button></span></div>`;",
"}",
"function bindRqStrip(){const a=$(\"#rqAll\");if(a)a.onclick=()=>approveAsk({boxes:\"all\"});const v=$(\"#rqRev\");if(v)v.onclick=openReview}",
"const fldName=k=>({cashier:\"\u0627\u0644\u0643\u0627\u0634\u064a\u0631\",shift:\"\u0627\u0644\u0648\u0631\u062f\u064a\u0629\",cash:\"\u0627\u0644\u0643\u0627\u0634\",report:\"\u0627\u0644\u062a\u0642\u0631\u064a\u0631\",notes:\"\u0645\u0644\u0627\u062d\u0638\u0627\u062a\"})[k]||(NETS.find(n=>n[0]===k)||[,k])[1];",
"function rqRows(b){",
"  const rq=b.rq,show=v=>v===\"\"||v==null?\"\u2014\":typeof v===\"number\"?fmt(v):esc(v);",
"  return RQF.concat(NV().map(n=>n[0])).filter(k=>rq[k]!==undefined&&String(rq[k]??\"\")!==String(b[k]??\"\")).map(k=>`<tr><td>${fldName(k)}</td><td class=\"n num\">${show(b[k])}</td><td class=\"n num\"><b>${show(rq[k])}</b></td></tr>`).join(\"\");",
"}",
"function rqPanel(i){",
"  const r=effectiveRole(),b=rawBox(cur.date,i);if(!b)return\"\";",
"  if(r===\"sup\"){if(b.rq)return`<div class=\"banner over\" style=\"margin:8px 0\">\u0628\u0627\u0646\u062a\u0638\u0627\u0631 \u0627\u0639\u062a\u0645\u0627\u062f \u0627\u0644\u0645\u062d\u0627\u0633\u0628 \u2014 \u0645\u0627 \u064a\u062f\u062e\u0644 \u0641\u064a \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0625\u0644\u0627 \u0628\u0639\u062f \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f</div>`;",
"    if(b.apAt&&hasData(b))return`<div class=\"info\" style=\"margin:8px 0\">\u2713 \u0645\u0639\u062a\u0645\u062f \u0645\u0646 ${esc(b.apBy||\"\")}</div>`;return\"\"}",
"  if(r!==\"acc\"||!b.rq)return\"\";",
"  const c=boxCalc(Object.assign(emptyBox(i),b,rqVals(b.rq))),rows=rqRows(b);",
"  return`<div class=\"rqbox\"><div class=\"sec-h\"><b>\u0637\u0644\u0628 \u0627\u0639\u062a\u0645\u0627\u062f \u0645\u0646 ${esc(b.rq.by||\"\")}</b><span class=\"note num\">${esc(isoTime(b.rq.at))}</span></div>",
"   ${rows?`<div class=\"tbl-wrap\"><table><thead><tr><th>\u0627\u0644\u0628\u0646\u062f</th><th class=\"n\">\u0627\u0644\u0645\u0639\u062a\u0645\u062f</th><th class=\"n\">\u0627\u0644\u0645\u0637\u0644\u0648\u0628</th></tr></thead><tbody>${rows}</tbody></table></div>`:\"\"}",
"   <div class=\"calc\"><span>\u0627\u0644\u0641\u0631\u0642 \u0628\u0639\u062f \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f</span><span class=\"num ${cls(c.diff)}\">${fmtS(c.diff)}</span></div>",
"   <div class=\"row-btns\"><button class=\"btn primary\" data-rqok=\"${i}\">\u0627\u0639\u062a\u0645\u0627\u062f</button><button class=\"btn\" data-rqno=\"${i}\">\u0631\u0641\u0636</button></div></div><div class=\"group-h\">\u0627\u0644\u0642\u064a\u0645 \u0627\u0644\u0645\u0639\u062a\u0645\u062f\u0629 \u062d\u0627\u0644\u064a\u0627\u064b</div>`;",
"}",
"function bindRqPanel(el,i){",
"  const a=el.querySelector(\"[data-rqok]\");if(a)a.onclick=()=>doApprove({boxes:[i]},false,()=>openBox(i));",
"  const n=el.querySelector(\"[data-rqno]\");if(n)n.onclick=()=>approveAsk({boxes:[i]},true,()=>openBox(i));",
"}",
"async function approveAsk(p,reject,after){",
"  const L=rqList(cur.date),n=p.boxes===\"all\"?L.boxes.length+L.rets.length:(p.boxes||[]).length+(p.returns||[]).length;",
"  const v=await ask(reject?\"\u0631\u0641\u0636 \u0627\u0644\u0637\u0644\u0628\u061f \u064a\u0631\u062c\u0639 \u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u0644\u0622\u062e\u0631 \u0642\u064a\u0645 \u0645\u0639\u062a\u0645\u062f\u0629.\":`\u0627\u0639\u062a\u0645\u0627\u062f ${n} ${n===1?\"\u0637\u0644\u0628\":\"\u0637\u0644\u0628\u0627\u062a\"}\u061f \u0628\u0639\u062f\u0647\u0627 \u062a\u062f\u062e\u0644 \u0641\u064a \u0643\u0644 \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631.`,[{t:reject?\"\u0631\u0641\u0636\":\"\u0627\u0639\u062a\u0645\u0627\u062f\",v:1,cls:reject?\"danger\":\"\"},{t:\"\u0625\u0644\u063a\u0627\u0621\",v:0}]);",
"  if(!v){if(after)after();return}doApprove(p,reject,after);",
"}",
"async function doApprove(p,reject,after){",
"  try{const doc=await api(\"approve\",Object.assign({date:cur.date,reject:!!reject},p));days.set(doc.date,doc);cacheSave();",
"    $(\"#layer\").innerHTML=\"\";if(!hasPend())loadDate(cur.date);else mergeCur();render();",
"    toast(reject?\"\u062a\u0645 \u0631\u0641\u0636 \u0627\u0644\u0637\u0644\u0628\":(doc.done>1?`\u062a\u0645 \u0627\u0639\u062a\u0645\u0627\u062f ${doc.done} \u0637\u0644\u0628\u0627\u062a`:\"\u062a\u0645 \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f\"));if(after&&p.boxes!==\"all\")after()}",
"  catch(e){toast(e.msg||\"\u062a\u0639\u0630\u0651\u0631 \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f\");if(after)after()}",
"}",
"function openReview(){",
"  const L=rqList(cur.date);",
"  const body=(L.boxes.length||L.rets.length)?`<p class=\"note\" style=\"margin:8px 0\">${dayName(cur.date)} <span class=\"num\">${dmy(cur.date)}</span> \u2014 \u0631\u0627\u062c\u0639 \u0625\u062f\u062e\u0627\u0644\u0627\u062a \u0645\u0633\u0624\u0648\u0644 \u0627\u0644\u0643\u0627\u0634\u064a\u0631\u0627\u062a \u0648\u0627\u0639\u062a\u0645\u062f\u0647\u0627.</p>",
"   ${L.boxes.map(({b,i})=>{const c=boxCalc(Object.assign(emptyBox(i),b,rqVals(b.rq)));return`<div class=\"rqrow\"><div class=\"sec-h\"><b>\u0635\u0646\u062f\u0648\u0642 <span class=\"num\">${BN(i)}</span> \u2014 ${esc(b.rq.cashier||b.cashier||\"\")}</b><span class=\"pill ${statusOf(c.diff)[0]===\"ok\"?\"saved\":c.diff<0?\"err\":\"dirty\"}\">${fmtS(c.diff)}</span></div>",
"     <div class=\"mini\"><span>\u0627\u0644\u0643\u0627\u0634 <b class=\"num\">${fmt(b.rq.cash)}</b></span><span>\u0627\u0644\u0634\u0628\u0643\u0627\u062a <b class=\"num\">${fmt(c.net)}</b></span><span>\u0627\u0644\u062a\u0642\u0631\u064a\u0631 <b class=\"num\">${fmt(b.rq.report)}</b></span></div>",
"     ${hasData(b)?`<p class=\"note\">\u062a\u0639\u062f\u064a\u0644 \u0639\u0644\u0649 \u0642\u064a\u0645 \u0645\u0639\u062a\u0645\u062f\u0629 \u0633\u0627\u0628\u0642\u0627\u064b</p>`:\"\"}",
"     <div class=\"row-btns\"><button class=\"btn small primary\" data-ok=\"${i}\">\u0627\u0639\u062a\u0645\u0627\u062f</button><button class=\"btn small\" data-open=\"${i}\">\u0641\u062a\u062d</button><button class=\"btn small\" data-no=\"${i}\">\u0631\u0641\u0636</button></div></div>`}).join(\"\")}",
"   ${L.rets.map(r=>`<div class=\"rqrow\"><div class=\"sec-h\"><b>\u0645\u0631\u062a\u062c\u0639 <span class=\"num neg\">${fmt(r.amount)}</span></b><span class=\"note\">${r.box?\"\u0645\u0646 \u0635\u0646\u062f\u0648\u0642 \"+BN(r.box-1):\"\"}</span></div>${r.note?`<p class=\"note\">${esc(r.note)}</p>`:\"\"}",
"     <div class=\"row-btns\"><button class=\"btn small primary\" data-rok=\"${esc(r.id)}\">\u0627\u0639\u062a\u0645\u0627\u062f</button><button class=\"btn small\" data-rno=\"${esc(r.id)}\">\u0631\u0641\u0636</button></div></div>`).join(\"\")}`",
"   :`<div class=\"card empty\">\u0644\u0627 \u062a\u0648\u062c\u062f \u0637\u0644\u0628\u0627\u062a \u0628\u0627\u0646\u062a\u0638\u0627\u0631 \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f.</div>`;",
"  const s=sheet(\"\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f\",body,`${L.boxes.length+L.rets.length>1?`<button class=\"btn primary\" id=\"rvAll\">\u0627\u0639\u062a\u0645\u0627\u062f \u0627\u0644\u0643\u0644</button>`:\"\"}<button class=\"btn\" data-close>\u0625\u063a\u0644\u0627\u0642</button>`);",
"  s.el.querySelectorAll(\"[data-ok]\").forEach(b=>b.onclick=()=>doApprove({boxes:[+b.dataset.ok],returns:[]},false,openReview));",
"  s.el.querySelectorAll(\"[data-no]\").forEach(b=>b.onclick=()=>doApprove({boxes:[+b.dataset.no],returns:[]},true,openReview));",
"  s.el.querySelectorAll(\"[data-open]\").forEach(b=>b.onclick=()=>{$(\"#layer\").innerHTML=\"\";openBox(+b.dataset.open)});",
"  s.el.querySelectorAll(\"[data-rok]\").forEach(b=>b.onclick=()=>doApprove({boxes:[],returns:[b.dataset.rok]},false,openReview));",
"  s.el.querySelectorAll(\"[data-rno]\").forEach(b=>b.onclick=()=>doApprove({boxes:[],returns:[b.dataset.rno]},true,openReview));",
"  const a=$(\"#rvAll\");if(a)a.onclick=()=>doApprove({boxes:\"all\"},false);",
"}",
"/* a new request arriving while the accountant has the system open */",
"function noticeNewRq(r){",
"  if(effectiveRole()!==\"acc\"||!r.days)return;",
"  r.days.forEach(d=>{const old=days.get(d.date);(d.boxes||[]).forEach((b,i)=>{if(b&&b.rq&&(!old||!old.boxes||!old.boxes[i]||!old.boxes[i].rq||old.boxes[i].rq.at!==b.rq.at))toast(`\u0637\u0644\u0628 \u0627\u0639\u062a\u0645\u0627\u062f: \u0635\u0646\u062f\u0648\u0642 ${BN(i)}${b.rq.cashier?\" \u2014 \"+b.rq.cashier:\"\"} \u0645\u0646 ${b.rq.by}`)})});",
"}",
"/* ---------- moving a whole saved day to another date ---------- */",
"function canMoveDay(){return effectiveRole()===\"acc\"&&cur&&cur.isSaved&&periodOpen(cur.date)}",
"const dayHasData=date=>{const d=days.get(date);return!!(d&&!d.namesOnly&&((d.boxes||[]).some((b,i)=>b&&hasData(Object.assign(emptyBox(i),b)))||(d.returns||[]).some(r=>r&&(r.amount||r.note))))};",
"function moveDayUI(){",
