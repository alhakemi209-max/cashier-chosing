"/* foreign currencies */",
"function secFx(){const F=fxCfg(),C=F.cur||{};return`<div class=\"card\"><h3 class=\"set-h\">\u0627\u0644\u0639\u0645\u0644\u0627\u062a \u0627\u0644\u0623\u062c\u0646\u0628\u064a\u0629</h3>",
"   <label class=\"chk\"><input type=\"checkbox\" id=\"s-fxOn\" ${F.on?\"checked\":\"\"}>\u0627\u0633\u062a\u0642\u0628\u0627\u0644 \u0639\u0645\u0644\u0627\u062a \u0623\u062c\u0646\u0628\u064a\u0629 \u0641\u064a \u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642</label>",
"   <div id=\"fxBody\" ${F.on?\"\":\"hidden\"}><div class=\"fx-list\">${FXL.map(([c,n,d])=>{const o=C[c]||{};return`<div class=\"fx-row\"><label class=\"chk\"><input type=\"checkbox\" id=\"fx-on-${c}\" ${o.on?\"checked\":\"\"}><span>${n} <span class=\"note\" dir=\"ltr\">${c}</span></span></label>",
"     <label class=\"fx-rate\"><span class=\"note\">\u0633\u0639\u0631 \u0627\u0644\u0635\u0631\u0641</span><input class=\"inp money\" id=\"fx-r-${c}\" inputmode=\"decimal\" dir=\"ltr\" value=\"${esc(o.rate||d)}\"></label></div>`}).join(\"\")}</div>",
"    <p class=\"note\">\u0633\u0639\u0631 \u0627\u0644\u0635\u0631\u0641 = \u0643\u0645 \u0631\u064a\u0627\u0644 \u062a\u0633\u0627\u0648\u064a \u0648\u062d\u062f\u0629 \u0648\u0627\u062d\u062f\u0629 \u0645\u0646 \u0627\u0644\u0639\u0645\u0644\u0629. \u064a\u064f\u062d\u0641\u0638 \u0627\u0644\u0633\u0639\u0631 \u0645\u0639 \u0643\u0644 \u0635\u0646\u062f\u0648\u0642 \u0648\u0642\u062a \u0625\u062f\u062e\u0627\u0644\u0647\u060c \u0641\u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0633\u0639\u0631 \u0644\u0627\u062d\u0642\u0627\u064b \u0645\u0627 \u064a\u063a\u064a\u0651\u0631 \u0627\u0644\u0623\u064a\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642\u0629.</p></div></div>",
"  <div class=\"card\" id=\"fxModeCard\" ${F.on?\"\":\"hidden\"}><h3 class=\"set-h\">\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u0627\u062d\u062a\u0633\u0627\u0628</h3>",
"   <label class=\"radio-row\"><input type=\"radio\" name=\"fxm\" id=\"s-fxConv\" ${F.mode!==\"track\"?\"checked\":\"\"}><span><b>\u062a\u064f\u0635\u0631\u0641 \u0644\u0644\u0643\u0627\u0634 \u0645\u0628\u0627\u0634\u0631\u0629</b><span class=\"note\">\u062a\u062a\u062d\u0648\u0644 \u0628\u0633\u0639\u0631 \u0627\u0644\u0635\u0631\u0641 \u0648\u062a\u0646\u0636\u0627\u0641 \u0644\u0643\u0627\u0634 \u0627\u0644\u0635\u0646\u062f\u0648\u0642\u060c \u0648\u062a\u0638\u0647\u0631 \u0645\u0639 \u0645\u0628\u064a\u0639\u0627\u062a \u0627\u0644\u0643\u0627\u0634.</span></span></label>",
"   <label class=\"radio-row\"><input type=\"radio\" name=\"fxm\" id=\"s-fxTrack\" ${F.mode===\"track\"?\"checked\":\"\"}><span><b>\u0645\u062a\u0627\u0628\u0639\u0629 \u0645\u0646\u0641\u0635\u0644\u0629</b><span class=\"note\">\u062a\u0646\u062d\u0633\u0628 \u0636\u0645\u0646 \u0645\u0637\u0627\u0628\u0642\u0629 \u0627\u0644\u0635\u0646\u062f\u0648\u0642\u060c \u0648\u062a\u0638\u0647\u0631 \u0644\u062d\u0627\u0644\u0647\u0627 \u0641\u064a \u0645\u0644\u062e\u0635 \u0627\u0644\u064a\u0648\u0645 \u0648\u0641\u064a \u062a\u0635\u0641\u064a\u0629 \u0627\u0644\u0635\u0646\u062f\u0648\u0642.</span></span></label></div>`}",
"function bindFx(){$(\"#s-fxOn\").onchange=e=>{$(\"#fxBody\").hidden=!e.target.checked;$(\"#fxModeCard\").hidden=!e.target.checked}}",
"/* ---------- import from Excel ---------- */",
"function loadXLSX(){return window.XLSX?Promise.resolve():new Promise((res,rej)=>{const s=document.createElement(\"script\");",
"  s.src=\"https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js\";s.onload=res;s.onerror=()=>rej(new Error(\"\u062a\u0639\u0630\u0651\u0631 \u062a\u062d\u0645\u064a\u0644 \u0642\u0627\u0631\u0626 \u0645\u0644\u0641\u0627\u062a Excel\u060c \u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a\"));document.head.appendChild(s)})}",
"const IMP_ORDER=[\"date\",\"cashier\",\"shift\",\"gulf\",\"master\",\"mada\",\"visa\",\"amex\",\"report\",\"notes\",\"amount\",\"cash\",\"box\"];",
"const IMP_RX={date:/\u062a\u0627\u0631\u064a\u062e|date/i,cashier:/\u0643\u0627\u0634\u064a\u0631|\u0623\u0645\u064a\u0646|\u0627\u0645\u064a\u0646|cashier/i,shift:/\u0648\u0631\u062f\u064a|shift/i,gulf:/\u062e\u0644\u064a\u062c/i,master:/\u0645\u0627\u0633\u062a\u0631|master/i,mada:/\u0645\u062f\u0649|mada/i,visa:/\u0641\u064a\u0632\u0627|visa/i,",
"  amex:/\u0623\u0645\u0631\u064a\u0643\u0627\u0646|\u0627\u0645\u0631\u064a\u0643\u0627\u0646|amex|american/i,report:/\u062a\u0642\u0631\u064a\u0631|\u0627\u0644\u0646\u0638\u0627\u0645|report/i,notes:/\u0645\u0644\u0627\u062d\u0638|note/i,amount:/\u0642\u064a\u0645\u0629|\u0645\u0628\u0644\u063a|amount/i,cash:/\u0643\u0627\u0634|\u0646\u0642\u062f|cash/i,box:/\u0635\u0646\u062f\u0648\u0642|box/i};",
"const TPL_HEAD=[\"\u0627\u0644\u062a\u0627\u0631\u064a\u062e\",\"\u0631\u0642\u0645 \u0627\u0644\u0635\u0646\u062f\u0648\u0642\",\"\u0623\u0645\u064a\u0646 \u0627\u0644\u0635\u0646\u062f\u0648\u0642\",\"\u0627\u0644\u0648\u0631\u062f\u064a\u0629\",\"\u0627\u0644\u0643\u0627\u0634\",\"\u0634\u0628\u0643\u0629 \u062e\u0644\u064a\u062c\u064a\u0629\",\"\u0645\u0627\u0633\u062a\u0631\u0643\u0627\u0631\u062f\",\"\u0634\u0628\u0643\u0629 \u0633\u0639\u0648\u062f\u064a\u0629 (\u0645\u062f\u0649)\",\"\u0641\u064a\u0632\u0627\",\"\u0623\u0645\u0631\u064a\u0643\u0627\u0646 \u0625\u0643\u0633\u0628\u0631\u0633\",\"\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u062a\u0642\u0631\u064a\u0631 (\u0627\u0644\u0646\u0638\u0627\u0645)\",\"\u0645\u0644\u0627\u062d\u0638\u0627\u062a\"];",
"function mapHeader(row){const map={};(row||[]).forEach((h,ci)=>{h=String(h==null?\"\":h).trim();if(!h)return;",
"  for(const k of IMP_ORDER){if(map[k]!=null)continue;if(IMP_RX[k].test(h)){map[k]=ci;break}}});return map}",
"function impDate(v){",
"  if(v instanceof Date&&!isNaN(v))return v.getFullYear()+\"-\"+String(v.getMonth()+1).padStart(2,\"0\")+\"-\"+String(v.getDate()).padStart(2,\"0\");",
"  if(typeof v===\"number\"&&v>20000&&v<80000){const d=XLSX.SSF.parse_date_code(v);return d.y+\"-\"+String(d.m).padStart(2,\"0\")+\"-\"+String(d.d).padStart(2,\"0\")}",
"  let s=String(v==null?\"\":v).replace(/[\u0660-\u0669]/g,d=>\"\u0660\u0661\u0662\u0663\u0664\u0665\u0666\u0667\u0668\u0669\".indexOf(d)).trim();let m;",
"  if((m=s.match(/^(\\d{4})[-/.](\\d{1,2})[-/.](\\d{1,2})/)))return m[1]+\"-\"+m[2].padStart(2,\"0\")+\"-\"+m[3].padStart(2,\"0\");",
"  if((m=s.match(/^(\\d{1,2})[-/.](\\d{1,2})[-/.](\\d{4})/)))return m[3]+\"-\"+m[2].padStart(2,\"0\")+\"-\"+m[1].padStart(2,\"0\");",
"  return null;",
"}",
"function impBox(v){const x=parseInt(num(v),10);if(!x)return null;const st=parseInt(settings.boxStart,10)||1;",
"  for(let i=0;i<BOXES;i++)if(BN(i)===x)return i;if(x>=st&&x<st+BOXES)return x-st;if(x>=1&&x<=BOXES)return x-1;return null}",
"function parseWorkbook(wb){",
"  const D={},warn=[];let rowsOk=0,merged=0;",
"  const day=date=>D[date]||(D[date]={date,boxes:Array.from({length:BOXES},()=>null),returns:[]});",
"  wb.SheetNames.forEach(name=>{",
"    const rows=XLSX.utils.sheet_to_json(wb.Sheets[name],{header:1,raw:true,defval:\"\"});",
"    let hr=-1,map=null;for(let r=0;r<Math.min(rows.length,20);r++){const m=mapHeader(rows[r]);if(m.date!=null&&m.box!=null){hr=r;map=m;break}}",
"    if(hr<0)return;",
"    const isRet=map.amount!=null&&map.report==null&&map.cash==null;",
"    for(let r=hr+1;r<rows.length;r++){const R=rows[r];const g=k=>map[k]!=null?R[map[k]]:\"\";",
"      if(R.every(v=>v===\"\"||v==null))continue;",
"      const date=impDate(g(\"date\"));if(!date){warn.push(`${name} \u0633\u0637\u0631 ${r+1}: \u062a\u0627\u0631\u064a\u062e \u063a\u064a\u0631 \u0645\u0641\u0647\u0648\u0645`);continue}",
"      if(isRet){const a=num(g(\"amount\"));if(!a)continue;const bi=impBox(g(\"box\"));day(date).returns.push({amount:-Math.abs(a),box:bi==null?0:bi+1,note:String(g(\"notes\")||\"\")});rowsOk++;continue}",
"      const bi=impBox(g(\"box\"));if(bi==null){warn.push(`${name} \u0633\u0637\u0631 ${r+1}: \u0631\u0642\u0645 \u0635\u0646\u062f\u0648\u0642 \u063a\u064a\u0631 \u0645\u0639\u0631\u0648\u0641 (${g(\"box\")})`);continue}",
"      const vals={cash:num(g(\"cash\")),gulf:num(g(\"gulf\")),master:num(g(\"master\")),mada:num(g(\"mada\")),visa:num(g(\"visa\")),amex:num(g(\"amex\")),report:num(g(\"report\"))};",
"      const name2=String(g(\"cashier\")||\"\").trim();",
"      if(!Object.values(vals).some(Boolean))continue;",
"      const d=day(date);let o=d.boxes[bi];",
"      if(o){merged++;Object.keys(vals).forEach(k=>o[k]=r2(o[k]+vals[k]));if(name2&&o.cashier.split(\" / \").indexOf(name2)<0)o.cashier=o.cashier?o.cashier+\" / \"+name2:name2}",
"      else d.boxes[bi]=Object.assign({cashier:name2,shift:String(g(\"shift\")||\"\"),notes:String(g(\"notes\")||\"\")},vals);",
"      rowsOk++;",
"    }",
"  });",
"  const list=Object.values(D).sort((a,b)=>a.date<b.date?-1:1);",
"  return{list,warn,rowsOk,merged};",
"}",
"async function importExcel(f){",
"  try{await loadXLSX()}catch(e){toast(e.message);return}",
"  let wb;try{wb=XLSX.read(await f.arrayBuffer(),{type:\"array\"})}catch(e){toast(\"\u062a\u0639\u0630\u0651\u0631 \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0645\u0644\u0641. \u0625\u0630\u0627 \u0643\u0627\u0646 \u0645\u062d\u0645\u064a\u0627\u064b \u0628\u0643\u0644\u0645\u0629 \u0645\u0631\u0648\u0631 \u0627\u062d\u0641\u0638\u0647 \u0628\u062f\u0648\u0646 \u0643\u0644\u0645\u0629 \u0645\u0631\u0648\u0631 \u062b\u0645 \u0623\u0639\u062f \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629\");return}",
"  const P=parseWorkbook(wb);",
"  if(!P.list.length){sheet(\"\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0645\u0646 Excel\",`<div class=\"banner short\" style=\"margin:10px 0\">\u0644\u0645 \u0623\u062c\u062f \u0628\u064a\u0627\u0646\u0627\u062a \u0628\u0627\u0644\u0634\u0643\u0644 \u0627\u0644\u0645\u0637\u0644\u0648\u0628 \u0641\u064a \u0627\u0644\u0645\u0644\u0641.</div><p class=\"note\">\u062a\u0623\u0643\u062f \u0623\u0646 \u0641\u064a \u0627\u0644\u0645\u0644\u0641 \u0639\u0645\u0648\u062f\u0627\u064b \u0644\u0644\u062a\u0627\u0631\u064a\u062e \u0648\u0639\u0645\u0648\u062f\u0627\u064b \u0644\u0631\u0642\u0645 \u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u0641\u064a \u0635\u0641 \u0627\u0644\u0639\u0646\u0627\u0648\u064a\u0646\u060c \u0623\u0648 \u0627\u0633\u062a\u062e\u062f\u0645 \u00ab\u062a\u0646\u0632\u064a\u0644 \u0627\u0644\u0646\u0645\u0648\u0630\u062c\u00bb.</p>${P.warn.slice(0,6).map(w=>`<p class=\"note\">${esc(w)}</p>`).join(\"\")}`);return}",
"  const exist=P.list.filter(d=>days.has(d.date)&&!days.get(d.date).namesOnly).length;",
"  const tot=P.list.reduce((s,d)=>s+d.boxes.reduce((a,b)=>a+(b?b.report:0),0)+d.returns.reduce((a,r)=>a+r.amount,0),0);",
"  const body=`<div class=\"strip\" style=\"margin:10px 0\">",
"     <div class=\"stat\"><span>\u0623\u064a\u0627\u0645</span><b class=\"num\">${P.list.length}</b></div>",
"     <div class=\"stat\"><span>\u0625\u0642\u0641\u0627\u0644\u0627\u062a \u0635\u0646\u0627\u062f\u064a\u0642</span><b class=\"num\">${P.rowsOk}</b></div>",
"     <div class=\"stat wide\"><span>\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631</span><b class=\"num\">${fmt(tot)}</b></div></div>",
"   <p class=\"note\" style=\"margin:0 0 8px\">\u0627\u0644\u0641\u062a\u0631\u0629: <b class=\"num\">${dmy(P.list[0].date)}</b> \u0625\u0644\u0649 <b class=\"num\">${dmy(P.list[P.list.length-1].date)}</b>${P.merged?`. \u062f\u064f\u0645\u062c <b class=\"num\">${P.merged}</b> \u0633\u0637\u0631 \u0644\u0635\u0646\u062f\u0648\u0642 \u062a\u0643\u0631\u0631 \u0641\u064a \u0646\u0641\u0633 \u0627\u0644\u064a\u0648\u0645 (\u062c\u064f\u0645\u0639\u062a \u0645\u0628\u0627\u0644\u063a\u0647)`:\"\"}.</p>",
"   ${exist?`<div class=\"card\" style=\"padding:10px 12px\"><b>${exist} \u064a\u0648\u0645 \u0645\u0648\u062c\u0648\u062f \u0645\u0633\u0628\u0642\u0627\u064b \u0641\u064a \u0627\u0644\u0646\u0638\u0627\u0645</b>",
"     <label class=\"chk\"><input type=\"radio\" name=\"impMode\" value=\"skip\" checked>\u0625\u0628\u0642\u0627\u0621 \u0627\u0644\u0645\u0648\u062c\u0648\u062f \u0648\u062a\u062e\u0637\u064a \u0647\u0630\u0647 \u0627\u0644\u0623\u064a\u0627\u0645</label>",
"     <label class=\"chk\"><input type=\"radio\" name=\"impMode\" value=\"replace\">\u0627\u0633\u062a\u0628\u062f\u0627\u0644\u0647\u0627 \u0628\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0644\u0641</label></div>`:\"\"}",
"   <label class=\"chk\"><input type=\"checkbox\" id=\"impSheets\">\u0625\u0646\u0634\u0627\u0621 \u0648\u0631\u0642\u0629 \u0645\u0633\u062a\u0642\u0644\u0629 \u0644\u0643\u0644 \u064a\u0648\u0645 \u0641\u064a \u062c\u062f\u0648\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a (\u0623\u0628\u0637\u0623)</label>",
"   ${P.warn.length?`<details><summary class=\"note\">${P.warn.length} \u0633\u0637\u0631 \u0644\u0645 \u064a\u064f\u0642\u0631\u0623</summary>${P.warn.slice(0,30).map(w=>`<p class=\"note\" style=\"margin:2px 0\">${esc(w)}</p>`).join(\"\")}</details>`:\"\"}",
"   <div id=\"impProg\" hidden><div class=\"prog\" style=\"margin-top:12px;height:6px;border-radius:3px;background:var(--line)\"><i id=\"impBar\" style=\"display:block;height:100%;width:0;background:var(--accent);border-radius:3px\"></i></div><p class=\"note\" id=\"impTxt\"></p></div>`;",
"  const s=sheet(\"\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0645\u0646 Excel\",body,`<button class=\"btn primary\" id=\"impGo\">\u0627\u0633\u062a\u064a\u0631\u0627\u062f ${P.list.length} \u064a\u0648\u0645</button><button class=\"btn\" data-close>\u0625\u0644\u063a\u0627\u0621</button>`);",
"  $(\"#impGo\").onclick=async()=>{",
"    const mode=(s.el.querySelector('input[name=\"impMode\"]:checked')||{}).value||\"skip\",daySheets=$(\"#impSheets\").checked;",
"    const go=$(\"#impGo\");go.disabled=true;s.el.querySelectorAll(\"input\").forEach(x=>x.disabled=true);$(\"#impProg\").hidden=false;",
"    const step=daySheets?8:31;const R={added:0,replaced:0,skipped:0};let done=0;",
"    for(let k=0;k<P.list.length;k+=step){",
"      const part=P.list.slice(k,k+step).map(d=>({date:d.date,boxes:d.boxes.map(b=>b||{}),returns:d.returns}));",
"      $(\"#impTxt\").textContent=`\u062c\u0627\u0631\u064d \u0627\u0644\u0627\u0633\u062a\u064a\u0631\u0627\u062f: ${done} \u0645\u0646 ${P.list.length} \u064a\u0648\u0645\u2026`;",
"      try{const r=await api(\"importDays\",{days:part,mode,daySheets});R.added+=r.added;R.replaced+=r.replaced;R.skipped+=r.skipped}",
"      catch(e){$(\"#impTxt\").textContent=`\u062a\u0648\u0642\u0641 \u0627\u0644\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0639\u0646\u062f ${done} \u064a\u0648\u0645: ${e.msg||\"\u062e\u0637\u0623\"}. \u0623\u0639\u062f \u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0645\u0644\u0641 \u0648\u0627\u062e\u062a\u0631 \u00ab\u0625\u0628\u0642\u0627\u0621 \u0627\u0644\u0645\u0648\u062c\u0648\u062f\u00bb \u0644\u0625\u0643\u0645\u0627\u0644 \u0627\u0644\u0628\u0627\u0642\u064a.`;go.disabled=false;go.textContent=\"\u0625\u063a\u0644\u0627\u0642\";go.onclick=()=>s.close();lastOk=0;poll();return}",
"      done+=part.length;$(\"#impBar\").style.width=(done/P.list.length*100)+\"%\";",
"    }",
"    $(\"#impTxt\").textContent=`\u062a\u0645: \u0623\u064f\u0636\u064a\u0641 ${R.added} \u064a\u0648\u0645${R.replaced?`\u060c \u0648\u0627\u0633\u062a\u064f\u0628\u062f\u0644 ${R.replaced}`:\"\"}${R.skipped?`\u060c \u0648\u062a\u064f\u062e\u0637\u0651\u064a ${R.skipped} \u0645\u0648\u062c\u0648\u062f`:\"\"}.`;",
"    go.disabled=false;go.textContent=\"\u062a\u0645\";go.onclick=()=>{s.close();render()};poll();",
"  };",
"}",
"async function downloadTemplate(){",
"  try{await loadXLSX()}catch(e){toast(e.message);return}",
"  const ws=XLSX.utils.aoa_to_sheet([TPL_HEAD]);ws[\"!cols\"]=TPL_HEAD.map((h,i)=>({wch:i===2?18:i===10?20:13}));",
"  const wr=XLSX.utils.aoa_to_sheet([[\"\u0627\u0644\u062a\u0627\u0631\u064a\u062e\",\"\u0631\u0642\u0645 \u0627\u0644\u0635\u0646\u062f\u0648\u0642\",\"\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0631\u062a\u062c\u0639\",\"\u0645\u0644\u0627\u062d\u0638\u0627\u062a\"]]);",
"  const wb=XLSX.utils.book_new();wb.Workbook={Views:[{RTL:true}]};XLSX.utils.book_append_sheet(wb,ws,\"\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a\");XLSX.utils.book_append_sheet(wb,wr,\"\u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a\");",
"  XLSX.writeFile(wb,\"\u0646\u0645\u0648\u0630\u062c-\u0627\u0633\u062a\u064a\u0631\u0627\u062f-\u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642.xlsx\");",
"}",
"",
"/* ---------- cash & shortages (cashier lead) ---------- */",
"let sentLog=[];",
"function intlPhone(p){p=String(p||\"\").replace(/[\u0660-\u0669]/g,d=>\"\u0660\u0661\u0662\u0663\u0664\u0665\u0666\u0667\u0668\u0669\".indexOf(d)).replace(/[^\\d]/g,\"\");",
"  if(p.indexOf(\"00\")===0)p=p.slice(2);",
"  if(p.indexOf(\"05\")===0&&p.length===10)p=\"966\"+p.slice(1);else if(p.indexOf(\"5\")===0&&p.length===9)p=\"966\"+p;",
"  return p.length>=11?p:\"\"}",
"function phoneOf(name){const ph=settings.phones||{};return ph[String(name||\"\").trim()]||\"\"}",
"const timeOf=iso=>{try{return new Date(iso).toLocaleTimeString(\"ar-SA-u-nu-latn\",{hour:\"numeric\",minute:\"2-digit\",timeZone:\"Asia/Riyadh\"})}catch(e){return\"\"}};",
"const leadDiff=b=>b.diff!=null?r2(b.diff):r2(boxCalc(b).diff);",
"const leadHas=b=>!!(b&&(b.cashier||b.cash||b.diff||b.report));",
"let leadSel=\"\";",
"function leadDates(){const t=todayISO(),o=[];for(let k=0;k<LEADD;k++){const d=addDays(t,-k);o.push([d,k===0?\"\u0627\u0644\u064a\u0648\u0645\":k===1?\"\u0623\u0645\u0633\":dayName(d)])}return o}",
"function leadPick(){const L=leadDates();if(!L.some(x=>x[0]===leadSel))leadSel=L[0][0];",
"  return`<div class=\"seg ldays\" role=\"group\" aria-label=\"\u0627\u0644\u064a\u0648\u0645\">${L.map(([d,l])=>`<button data-ld=\"${d}\" aria-pressed=\"${d===leadSel}\">${l}<small class=\"num\">${dmy(d).slice(0,5)}</small></button>`).join(\"\")}</div>`}",
"function bindLead(re){$(\"#view\").querySelectorAll(\"[data-ld]\").forEach(b=>b.onclick=()=>{leadSel=b.dataset.ld;re()})}",
"function leadDay(date){const d=days.get(date);return d&&!d.namesOnly?normDay(d):null}",
"let APPURL=\"\";",
"const newTk=()=>{const A=\"abcdefghijklmnopqrstuvwxyz0123456789\",b=new Uint8Array(24);try{crypto.getRandomValues(b)}catch(e){for(let k=0;k<24;k++)b[k]=Math.random()*256|0}return[...b].map(x=>A[x%36]).join(\"\")};",
"/* staff are female unless the accountant marks them male in settings */",
"/* who may send to staff: the lead, or a cashier supervisor the accountant allowed */",
"const canSendStaff=()=>{const r=effectiveRole();return(r===\"lead\"||r===\"sup\")&&can(\"wa\")},senderTitle=()=>(ROLES[effectiveRole()]||ROLES.lead).name;",
"const meF=(f,m)=>effectiveRole()===\"sup\"?m:f;",
"const isM=n=>((settings.genders||{})[String(n||\"\").trim()])===\"m\",G=(n,f,m)=>isM(n)?m:f;",
"function shortMsg(day,i,tk){const b=day.boxes[i],d=leadDiff(b),short=d<0;",
"  const line=\"\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\";",
"  return [`*${settings.store}*`,`${settings.branch}`,line,`*${short?\"\u0625\u0634\u0639\u0627\u0631 \u0639\u062c\u0632 \u0641\u064a \u0627\u0644\u0635\u0646\u062f\u0648\u0642\":\"\u0625\u0634\u0639\u0627\u0631 \u0632\u064a\u0627\u062f\u0629 \u0641\u064a \u0627\u0644\u0635\u0646\u062f\u0648\u0642\"}*`,\"\",",
"    `${G(b.cashier,\"\u0627\u0644\u0645\u0648\u0638\u0641\u0629 \u0627\u0644\u0643\u0631\u064a\u0645\u0629\",\"\u0627\u0644\u0645\u0648\u0638\u0641 \u0627\u0644\u0643\u0631\u064a\u0645\")}: *${b.cashier||\"\"}*`,`\u0627\u0644\u062a\u0627\u0631\u064a\u062e: ${dayName(day.date)} ${dmy(day.date)}`,`\u0631\u0642\u0645 \u0627\u0644\u0635\u0646\u062f\u0648\u0642: ${BN(i)}`,`\u0627\u0644\u0643\u0627\u0634: ${fmt(b.cash)} \u0631\u064a\u0627\u0644`,",
"    `${short?\"\ud83d\udd34 \u0627\u0644\u0639\u062c\u0632\":\"\ud83d\udfe0 \u0627\u0644\u0632\u064a\u0627\u062f\u0629\"}: *${fmt(Math.abs(d))} \u0631\u064a\u0627\u0644*`,\"\",",
"    APPURL&&tk?`\u0644\u0639\u0631\u0636 \u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u0648\u062a\u0623\u0643\u064a\u062f \u0627\u0644\u0627\u0637\u0644\u0627\u0639 (\u064a\u064f\u0637\u0644\u0628 \u0645\u0646\u0643 \u0622\u062e\u0631 4 \u0623\u0631\u0642\u0627\u0645 \u0645\u0646 \u062c\u0648\u0627\u0644\u0643):\\n${APPURL}?n=${tk}`:\"\",line,",
"    `_\u062a\u0645 \u0625\u0631\u0633\u0627\u0644 \u0647\u0630\u0647 \u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u0628\u0648\u0627\u0633\u0637\u0629 ${senderTitle()}: ${me&&me.name||\"\"}_`].filter(x=>x!==\"\").join(\"\\n\").replace(/\\n\\n\\n+/g,\"\\n\\n\")}",
"const emailOf=n=>((settings.emails||{})[String(n||\"\").trim()])||\"\";",
"function sentPill(s){if(!s)return`<span class=\"note\">\u0644\u0645 \u064a\u064f\u0631\u0633\u0644 \u0628\u0639\u062f</span>`;",
"  return`<span class=\"pill saved\">\u0623\u064f\u0631\u0633\u0644 ${esc(s.ch||\"\u0648\u0627\u062a\u0633\u0627\u0628\")} ${esc(timeOf(s.at))}</span>${s.ack?`<span class=\"pill ackd\">\u2713 ${G(s.name,\"\u0623\u0643\u062f\u062a\",\"\u0623\u0643\u062f\")} \u0627\u0644\u0627\u0637\u0644\u0627\u0639 ${esc(String(s.ack).slice(11))}</span>`:s.seen?`<span class=\"pill seen\">\ud83d\udc41 ${G(s.name,\"\u0641\u062a\u062d\u062a\",\"\u0641\u062a\u062d\")} \u0627\u0644\u0625\u0634\u0639\u0627\u0631 ${esc(String(s.seen).slice(11))}</span>`:`<span class=\"pill wait\">${G(s.name,\"\u0644\u0645 \u062a\u0641\u062a\u062d\u0647\",\"\u0644\u0645 \u064a\u0641\u062a\u062d\u0647\")} \u0628\u0639\u062f</span>`}`}",
"function renderCash(){",
"  leadPick();$(\"#view\").innerHTML=leadPick()+leadDates().filter(x=>x[0]===leadSel).map(([date,lbl])=>{const day=leadDay(date);",
"    const rows=day?day.boxes.map((b,i)=>({b,i})).filter(x=>leadHas(x.b)):[];",
"    const tot=rows.reduce((s,x)=>s+(+x.b.cash||0),0);",
"    return `<div class=\"sec-h\"><h2>${lbl} \u2014 ${dayName(date)} <span class=\"num\">${dmy(date)}</span></h2></div>",
"     ${rows.length?`<div class=\"tbl-wrap\"><table><thead><tr><th>\u0627\u0644\u0635\u0646\u062f\u0648\u0642</th><th>\u0627\u0644\u0643\u0627\u0634\u064a\u0631</th><th class=\"n\">\u0627\u0644\u0643\u0627\u0634</th></tr></thead><tbody>",
"       ${rows.map(x=>`<tr><td class=\"num\">${BN(x.i)}</td><td>${esc(x.b.cashier)||\"\u2014\"}</td><td class=\"n num\">${fmt(x.b.cash)}</td></tr>`).join(\"\")}</tbody>",
"       <tfoot><tr><td colspan=\"2\">\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0643\u0627\u0634</td><td class=\"n num\">${fmt(tot)}</td></tr></tfoot></table></div>`",
"     :`<div class=\"card empty\">\u0644\u0645 \u062a\u064f\u062d\u0641\u0638 \u0635\u0646\u0627\u062f\u064a\u0642 \u0647\u0630\u0627 \u0627\u0644\u064a\u0648\u0645 \u0628\u0639\u062f.</div>`}`}).join(\"\");",
"  bindLead(renderCash);",
"}",
"function shortCard(day,x){const {b,i,d}=x;const ph=intlPhone(phoneOf(b.cashier)),em=emailOf(b.cashier);const s=sentOf(day.date,i);",
"  const tk=newTk(),url=ph?`https://wa.me/${ph}?text=${encodeURIComponent(shortMsg(day,i,tk))}`:\"\";const neg=d<0,lead=canSendStaff();",
"  return `<div class=\"card scard ${neg?\"is-short\":\"is-over\"}\">",
"   <div class=\"sec-h\"><b>\u0635\u0646\u062f\u0648\u0642 <span class=\"num\">${BN(i)}</span> \u2014 ${esc(b.cashier)||\"\u0628\u062f\u0648\u0646 \u0627\u0633\u0645\"}</b><span class=\"pill ${neg?\"err\":\"dirty\"}\">${neg?\"\u0639\u062c\u0632\":\"\u0632\u064a\u0627\u062f\u0629\"} <span class=\"num\">${fmt(Math.abs(d))}</span></span></div>",
"   <div class=\"mini\"><span>\u0627\u0644\u0643\u0627\u0634 <b class=\"num\">${fmt(b.cash)}</b></span></div>",
"   <div class=\"sent-row\">${sentPill(s)}${!lead&&s?`<span class=\"note\">\u0628\u0648\u0627\u0633\u0637\u0629 ${esc(s.by||\"\")}</span>`:\"\"}</div>",
"   ${lead?`<div class=\"send-btns\"><button class=\"btn small img ${s?\"\":\"primary\"}\" data-img=\"${day.date}|${i}\"><svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><circle cx=\"9\" cy=\"10\" r=\"2\"/><path d=\"M21 17l-5-5-9 8\"/></svg>${s?\"\u0625\u0639\u0627\u062f\u0629 \u0643\u0635\u0648\u0631\u0629\":\"\u0625\u0631\u0633\u0627\u0644 \u0643\u0635\u0648\u0631\u0629\"}</button>${url?`<a class=\"btn small wa\" href=\"${url}\" target=\"_blank\" rel=\"noopener\" data-send=\"${day.date}|${i}|${tk}\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 20l1.3-3.9A8 8 0 1 1 8 19z\"/></svg>${s?\"\u0625\u0639\u0627\u062f\u0629 \u0648\u0627\u062a\u0633\u0627\u0628\":\"\u0648\u0627\u062a\u0633\u0627\u0628\"}</a>`:`<span class=\"note\">\u0644\u0627 \u064a\u0648\u062c\u062f \u062c\u0648\u0627\u0644</span>`}",
"     ${em?`<button class=\"btn small mail\" data-mail=\"${day.date}|${i}\"><svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"M3 7l9 6 9-6\"/></svg>\u0625\u064a\u0645\u064a\u0644</button>`:`<span class=\"note\">\u0644\u0627 \u064a\u0648\u062c\u062f \u0625\u064a\u0645\u064a\u0644</span>`}</div>`:\"\"}</div>`}",
"function renderShort(){",
"  leadPick();const sec=leadDates().filter(x=>x[0]===leadSel).map(([date,lbl])=>{const day=leadDay(date);",
"    const items=day?day.boxes.map((b,i)=>({b,i,d:leadDiff(b)})).filter(x=>leadHas(x.b)&&x.d!==0).sort((a,b)=>a.d-b.d):[];",
"    const tot=items.filter(x=>x.d<0).reduce((s,x)=>s+x.d,0);",
"    const sent=items.filter(x=>sentLog.some(e=>e.date===date&&e.box===x.i)).length;",
"    return `<div class=\"sec-h\"><h2>${lbl} \u2014 ${dayName(date)} <span class=\"num\">${dmy(date)}</span></h2>${items.length?`<span class=\"note num\">\u0623\u064f\u0631\u0633\u0644 ${sent} \u0645\u0646 ${items.length}</span>`:\"\"}</div>",
"     ${items.length?`<div class=\"stat wide short\"><span>\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0639\u062c\u0632</span><b class=\"num\">${fmt(tot)}</b></div>`+items.map(x=>shortCard(day,x)).join(\"\"):`<div class=\"card empty\">${day?\"\u0644\u0627 \u064a\u0648\u062c\u062f \u0639\u062c\u0632 \u0623\u0648 \u0632\u064a\u0627\u062f\u0629 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u064a\u0648\u0645.\":\"\u0644\u0645 \u062a\u064f\u062d\u0641\u0638 \u0635\u0646\u0627\u062f\u064a\u0642 \u0647\u0630\u0627 \u0627\u0644\u064a\u0648\u0645 \u0628\u0639\u062f.\"}</div>`}`}).join(\"\");",
"  $(\"#view\").innerHTML=`${leadPick()}<div class=\"info\">${!canSendStaff()?`\u0627\u0644\u0639\u062c\u0632 \u0648\u0627\u0644\u0632\u064a\u0627\u062f\u0629 \u0644\u0635\u0646\u0627\u062f\u064a\u0642 \u0622\u062e\u0631 ${LEADD} \u0623\u064a\u0627\u0645 (\u0627\u0637\u0644\u0627\u0639 \u0641\u0642\u0637)\u060c \u0645\u0639 \u062d\u0627\u0644\u0629 \u0625\u0631\u0633\u0627\u0644\u0647\u0627 \u0644\u0644\u0645\u0648\u0638\u0641\u0627\u062a.`:`\u064a\u0638\u0647\u0631 \u0647\u0646\u0627 \u0627\u0644\u0639\u062c\u0632 \u0648\u0627\u0644\u0632\u064a\u0627\u062f\u0629 \u0644\u0635\u0646\u0627\u062f\u064a\u0642 \u0622\u062e\u0631 ${LEADD} \u0623\u064a\u0627\u0645 \u0641\u0642\u0637\u060c \u0648\u0645\u0627 \u0642\u0628\u0644\u0647\u0627 \u064a\u062e\u062a\u0641\u064a \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b. \u0645\u0646 \u0647\u0646\u0627 \u064a\u064f\u0631\u0633\u0644 \u0625\u0634\u0639\u0627\u0631 \u0643\u0644 \u0635\u0646\u062f\u0648\u0642 \u0644\u0635\u0627\u062d\u0628\u0647 \u0643\u0635\u0648\u0631\u0629 \u0623\u0648 \u0648\u0627\u062a\u0633\u0627\u0628 \u0623\u0648 \u0625\u064a\u0645\u064a\u0644\u060c \u0648\u064a\u0648\u0635\u0644\u0647 \u0631\u0627\u0628\u0637 \u064a\u0641\u062a\u062d \u0645\u0646\u0647 \u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u0648\u064a\u0624\u0643\u062f \u0627\u0637\u0644\u0627\u0639\u0647\u060c \u0648\u062a\u0638\u0647\u0631 \u0627\u0644\u062d\u0627\u0644\u0629 \u0647\u0646\u0627.`}</div>${sec}`;",
"  bindLead(renderShort);",
"  $(\"#view\").querySelectorAll(\"[data-send]\").forEach(a=>a.addEventListener(\"click\",()=>{const v=a.dataset.send.split(\"|\");markSent(v[0],+v[1],v[2])}));",
"  $(\"#view\").querySelectorAll(\"[data-img]\").forEach(bt=>bt.onclick=()=>{const v=bt.dataset.img.split(\"|\");sendAsImage(v[0],+v[1],bt)});",
"  $(\"#view\").querySelectorAll(\"[data-mail]\").forEach(bt=>bt.onclick=async()=>{const v=bt.dataset.mail.split(\"|\");bt.disabled=true;bt.textContent=\"\u062c\u0627\u0631\u064d \u0627\u0644\u0625\u0631\u0633\u0627\u0644\u2026\";",
"    let img=\"\";try{const day=leadDay(v[0]);if(day)img=await blobURL(await noticePNG(day,+v[1]))}catch(e){img=\"\"}",
"    try{sentLog=await api(\"sendMail\",{date:v[0],box:+v[1],img});toast(\"\u062a\u0645 \u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0625\u064a\u0645\u064a\u0644\");if(tab===\"short\"&&!layerOpen())renderShort()}catch(e){toast(e.msg||\"\u062a\u0639\u0630\u0651\u0631 \u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0625\u064a\u0645\u064a\u0644\");bt.disabled=false;bt.textContent=\"\u0625\u064a\u0645\u064a\u0644\"}});",
"}",
"async function markSent(date,i,token){try{sentLog=await api(\"markSent\",{date,box:i,token});if(tab===\"short\"&&!layerOpen())renderShort();toast(\"\u0633\u064f\u062c\u0651\u0644 \u0627\u0644\u0625\u0631\u0633\u0627\u0644\")}catch(e){toast(e.msg||\"\u062a\u0639\u0630\u0651\u0631 \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0625\u0631\u0633\u0627\u0644\")}}",
"",
"",
"/* ---------- weekly sales (branch manager) ---------- */",
"function weekSales(){return leadDates().map(([d,l])=>{const raw=days.get(d);const day=raw&&!raw.namesOnly?normDay(raw):null;return{d,l,t:day?dayCalc(day):null}})}",
"function renderSales(){",
"  const W=weekSales(),H=W.filter(x=>x.t&&x.t.count);",
"  const T=H.reduce((a,x)=>{a.s+=x.t.reportNet;a.c+=x.t.cashNet;a.n+=x.t.net;a.d+=x.t.diff;return a},{s:0,c:0,n:0,d:0});T.d=r2(T.d);",
"  $(\"#view\").innerHTML=`<div class=\"info\">\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a \u0627\u0644\u064a\u0648\u0645\u064a\u0629 \u0644\u0622\u062e\u0631 ${LEADD} \u0623\u064a\u0627\u0645 (\u0627\u0637\u0644\u0627\u0639 \u0641\u0642\u0637).</div>",
"  ${H.length?`<div class=\"strip\"><div class=\"stat\"><span>\u0645\u0628\u064a\u0639\u0627\u062a \u0627\u0644\u0623\u0633\u0628\u0648\u0639</span><b class=\"num\">${fmt(T.s)}</b></div>",
"   <div class=\"stat\"><span>\u0645\u062a\u0648\u0633\u0637 \u0627\u0644\u064a\u0648\u0645</span><b class=\"num\">${fmt(T.s/H.length)}</b></div>",
"   <div class=\"stat ${T.d<0?\"short\":T.d>0?\"over\":\"ok\"}\"><span>\u0635\u0627\u0641\u064a \u0627\u0644\u0639\u062c\u0632 / \u0627\u0644\u0632\u064a\u0627\u062f\u0629</span><b class=\"num\">${fmt(T.d)}</b></div></div>",
"   <div class=\"row-btns\"><button class=\"btn primary\" id=\"slPrint\">\u0637\u0628\u0627\u0639\u0629</button></div>`:\"\"}",
"  <div class=\"tbl-wrap\"><table><thead><tr><th>\u0627\u0644\u064a\u0648\u0645</th><th class=\"n\">\u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a</th><th class=\"n\">\u0627\u0644\u0643\u0627\u0634</th><th class=\"n\">\u0627\u0644\u0634\u0628\u0643\u0627\u062a</th><th class=\"n\">\u0627\u0644\u0641\u0631\u0642</th></tr></thead><tbody>",
"  ${W.map(x=>`<tr><td>${x.l===dayName(x.d)?x.l:x.l+\" \u2014 \"+dayName(x.d)}<div class=\"note num\">${dmy(x.d)}</div></td>${x.t&&x.t.count?`<td class=\"n num\"><b>${fmt(x.t.reportNet)}</b></td><td class=\"n num\">${fmt(x.t.cashNet)}</td><td class=\"n num\">${fmt(x.t.net)}</td><td class=\"n num ${x.t.diff<0?\"neg\":x.t.diff>0?\"pos\":\"\"}\">${fmt(x.t.diff)}</td>`:`<td class=\"n\" colspan=\"4\"><span class=\"note\">\u0644\u0627 \u062a\u0648\u062c\u062f \u0628\u064a\u0627\u0646\u0627\u062a</span></td>`}</tr>`).join(\"\")}</tbody>",
"  ${H.length?`<tfoot><tr><td>\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</td><td class=\"n num\">${fmt(T.s)}</td><td class=\"n num\">${fmt(T.c)}</td><td class=\"n num\">${fmt(T.n)}</td><td class=\"n num\">${fmt(T.d)}</td></tr></tfoot>`:\"\"}</table></div>`;",
"  const p=$(\"#slPrint\");if(p)p.onclick=()=>preview(\"\u0645\u0628\u064a\u0639\u0627\u062a \u0627\u0644\u0623\u0633\u0628\u0648\u0639\",rcptSales(W,T),`\u0645\u0628\u064a\u0639\u0627\u062a-\u0627\u0644\u0623\u0633\u0628\u0648\u0639-${todayISO()}.pdf`);",
"}",
"function rcptSales(W,T){",
"  const f=W[W.length-1].d,t=W[0].d;",
"  return`<div class=\"rcpt\">${head(\"\u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a \u0627\u0644\u064a\u0648\u0645\u064a\u0629\",`<div class=\"c\" style=\"font-weight:700\">\u0645\u0646 ${dmy(f)} \u0625\u0644\u0649 ${dmy(t)}</div>`)}",
"  <table><thead><tr><th>\u0627\u0644\u064a\u0648\u0645</th><th class=\"n\">\u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a</th><th class=\"n\">\u0627\u0644\u0641\u0631\u0642</th></tr></thead><tbody>",
"  ${W.slice().reverse().map(x=>`<tr><td>${dayName(x.d)} ${dmy(x.d).slice(0,5)}</td><td class=\"n\">${x.t&&x.t.count?fmt(x.t.reportNet):\"\u2014\"}</td><td class=\"n\">${x.t&&x.t.count?fmt(x.t.diff):\"\u2014\"}</td></tr>`).join(\"\")}</tbody>",
"  <tfoot><tr><td>\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</td><td class=\"n\">${fmt(T.s)}</td><td class=\"n\">${fmt(T.d)}</td></tr></tfoot></table></div>`;",
"}",
"/* ---------- shortage notices seen by the accountant ---------- */",
"function sentOf(date,i){const L=sentLog.filter(e=>e.date===date&&e.box===i);if(!L.length)return undefined;",
"  return Object.assign({},L[L.length-1],{ch:[...new Set(L.map(e=>e.ch||\"\u0648\u0627\u062a\u0633\u0627\u0628\"))].join(\" \u0648\"),ack:(L.filter(e=>e.ack).pop()||{}).ack||\"\",seen:(L.filter(e=>e.seen).map(e=>e.seen).sort()[0])||\"\"})}",
"function sentBadge(i){if(effectiveRole()!==\"acc\")return\"\";return sentOf(cur.date,i)?'<span class=\"sn\">\u2713 \u0623\u064f\u0631\u0633\u0644</span>':\"\"}",
"function sentInfo(i){",
"  if(effectiveRole()!==\"acc\")return\"\";const sv=days.get(cur.date),b=sv&&!sv.namesOnly&&sv.boxes?sv.boxes[i]:null;if(!b||!hasData(b))return\"\";",
"  const d=boxCalc(b).diff,s=sentOf(cur.date,i);",
"  if(s)return`<div class=\"info\" style=\"margin:8px 0\">\u062a\u0645 \u0625\u0631\u0633\u0627\u0644 ${d<0?\"\u0627\u0644\u0639\u062c\u0632\":d>0?\"\u0627\u0644\u0632\u064a\u0627\u062f\u0629\":\"\u0627\u0644\u062a\u0642\u0631\u064a\u0631\"} ${G(b.cashier,\"\u0644\u0644\u0645\u0648\u0638\u0641\u0629\",\"\u0644\u0644\u0645\u0648\u0638\u0641\")} \u0639\u0628\u0631 ${esc(s.ch||\"\u0648\u0627\u062a\u0633\u0627\u0628\")} \u2014 \u0628\u0648\u0627\u0633\u0637\u0629 <b>${esc(s.by||\"\")}</b> <span class=\"num\">${esc(timeOf(s.at))}</span>${s.ack?`<br>\u2713 ${G(b.cashier,\"\u0627\u0644\u0645\u0648\u0638\u0641\u0629 \u0641\u062a\u062d\u062a \u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u0648\u0623\u0643\u062f\u062a \u0627\u0637\u0644\u0627\u0639\u0647\u0627\",\"\u0627\u0644\u0645\u0648\u0638\u0641 \u0641\u062a\u062d \u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u0648\u0623\u0643\u062f \u0627\u0637\u0644\u0627\u0639\u0647\")} <span class=\"num\">${esc(s.ack)}</span>`:s.seen?`<br>\ud83d\udc41 ${G(b.cashier,\"\u0627\u0644\u0645\u0648\u0638\u0641\u0629 \u0641\u062a\u062d\u062a\",\"\u0627\u0644\u0645\u0648\u0638\u0641 \u0641\u062a\u062d\")} \u0627\u0644\u0625\u0634\u0639\u0627\u0631 <span class=\"num\">${esc(s.seen)}</span> ${G(b.cashier,\"\u0648\u0644\u0645 \u062a\u0624\u0643\u062f \u0628\u0639\u062f\",\"\u0648\u0644\u0645 \u064a\u0624\u0643\u062f \u0628\u0639\u062f\")}`:`<br><span class=\"note\">${G(b.cashier,\"\u0627\u0644\u0645\u0648\u0638\u0641\u0629 \u0644\u0645 \u062a\u0641\u062a\u062d\",\"\u0627\u0644\u0645\u0648\u0638\u0641 \u0644\u0645 \u064a\u0641\u062a\u062d\")} \u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u0628\u0639\u062f</span>`}</div>`;",
"  return d?`<p class=\"note\" style=\"margin:8px 0\">\u0644\u0645 \u064a\u064f\u0631\u0633\u0644 ${d<0?\"\u0627\u0644\u0639\u062c\u0632\":\"\u0627\u0644\u0632\u064a\u0627\u062f\u0629\"} ${G(b.cashier,\"\u0644\u0644\u0645\u0648\u0638\u0641\u0629\",\"\u0644\u0644\u0645\u0648\u0638\u0641\")} \u0628\u0639\u062f.</p>`:\"\";",
"}",
"function sentStrip(){",
"  if(effectiveRole()!==\"acc\"||!cur.isSaved)return\"\";",
"  const L=cur.boxes.map((b,i)=>({i,d:hasData(b)?boxCalc(b).diff:0})).filter(x=>x.d);if(!L.length)return\"\";",
"  const n=L.filter(x=>sentOf(cur.date,x.i)).length;",
"  return`<div class=\"info\">\u0625\u0634\u0639\u0627\u0631\u0627\u062a \u0627\u0644\u0639\u062c\u0632 \u0648\u0627\u0644\u0632\u064a\u0627\u062f\u0629 \u0644\u0644\u0645\u0648\u0638\u0641\u0627\u062a: \u0623\u064f\u0631\u0633\u0644 <b class=\"num\">${n}</b> \u0645\u0646 <b class=\"num\">${L.length}</b></div>`;",
"}",
"function noticeNewSent(list){",
"  const r=effectiveRole();if((r!==\"acc\"&&!canSendStaff())||!list)return;",
"  const key=e=>e.date+\"|\"+e.box+\"|\"+e.at,old=new Map(sentLog.map(e=>[key(e),e]));",
"  if(r===\"acc\"){const nw=list.filter(e=>!old.has(key(e)));",
"    if(nw.length===1)toast(`\u0623\u064f\u0631\u0633\u0644 \u062a\u0642\u0631\u064a\u0631 \u0635\u0646\u062f\u0648\u0642 ${BN(nw[0].box)}${nw[0].name?\" \u2014 \"+nw[0].name:\"\"} \u0628\u0648\u0627\u0633\u0637\u0629 ${nw[0].by}`);",
"    else if(nw.length>1)toast(`\u0623\u064f\u0631\u0633\u0644\u062a ${nw.length} \u062a\u0642\u0627\u0631\u064a\u0631 \u0639\u062c\u0632 \u0648\u0632\u064a\u0627\u062f\u0629 \u0644\u0644\u0645\u0648\u0638\u0641\u0627\u062a`)}",
"  list.forEach(e=>{const o=old.get(key(e));if(!o)return;",
"    if(e.ack&&!o.ack)toast(`\u2713 ${e.name||\"\u0627\u0644\u0645\u0648\u0638\u0641\u0629\"} ${G(e.name,\"\u0623\u0643\u062f\u062a\",\"\u0623\u0643\u062f\")} \u0627\u0644\u0627\u0637\u0644\u0627\u0639 \u0639\u0644\u0649 \u0625\u0634\u0639\u0627\u0631 \u0635\u0646\u062f\u0648\u0642 ${BN(e.box)}`);",
"    else if(e.seen&&!o.seen)toast(`\ud83d\udc41 ${e.name||\"\u0627\u0644\u0645\u0648\u0638\u0641\u0629\"} ${G(e.name,\"\u0641\u062a\u062d\u062a\",\"\u0641\u062a\u062d\")} \u0625\u0634\u0639\u0627\u0631 \u0635\u0646\u062f\u0648\u0642 ${BN(e.box)}`)});",
"}",
"",
"/* ---------- accountant: shortage notice centre ---------- */",
"function noticeItems(n){",
"  const t=todayISO(),out=[];",
"  for(let k=0;k<(n||7);k++){const d=addDays(t,-k),raw=days.get(d);if(!raw||raw.namesOnly)continue;",
"    normDay(raw).boxes.forEach((b,i)=>{if(!hasData(b))return;const df=boxCalc(b).diff;if(!df)return;out.push({date:d,i,name:b.cashier||\"\",d:df,s:sentOf(d,i)})})}",
"  return out;",
"}",
"function renderBell(){",
"  const bt=$(\"#bell\");if(!bt)return;const on=effectiveRole()===\"acc\";bt.hidden=!on;if(!on)return;",
"  const n=noticeItems().filter(x=>!x.s).length,i=$(\"#bellN\");i.hidden=!n;i.textContent=n>99?\"99+\":n;",
"  bt.title=n?`${n} \u0644\u0645 \u064a\u064f\u0631\u0633\u0644 \u0644\u0644\u0645\u0648\u0638\u0641\u0627\u062a`:\"\u0643\u0644 \u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0639\u062c\u0632 \u0623\u064f\u0631\u0633\u0644\u062a\";",
"}",
"function openBell(){",
"  const L=noticeItems(),un=L.filter(x=>!x.s).length;",
"  const byDay={};L.forEach(x=>(byDay[x.date]||(byDay[x.date]=[])).push(x));",
"  const body=L.length?`<div class=\"strip\" style=\"margin:8px 0\"><div class=\"stat ${un?\"short\":\"ok\"}\"><span>\u0644\u0645 \u064a\u064f\u0631\u0633\u0644</span><b class=\"num\">${un}</b></div><div class=\"stat ok\"><span>\u0623\u064f\u0631\u0633\u0644</span><b class=\"num\">${L.length-un}</b></div></div>",
"   <p class=\"note\">\u0627\u0644\u0625\u0631\u0633\u0627\u0644 \u0644\u0644\u0645\u0648\u0638\u0641\u064a\u0646 \u0645\u0646 \u0639\u0646\u062f \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0645\u0635\u0631\u0651\u062d \u0644\u0647 \u0628\u0627\u0644\u0625\u0631\u0633\u0627\u0644\u060c \u0648\u0647\u0646\u0627 \u062a\u062a\u0627\u0628\u0639 \u062d\u0627\u0644\u062a\u0647 \u0641\u0642\u0637. \u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u0623\u064a \u0633\u0637\u0631 \u0644\u0641\u062a\u062d \u0627\u0644\u064a\u0648\u0645.</p>",
"   ${Object.keys(byDay).sort().reverse().map(d=>`<div class=\"sec-h\" style=\"margin-top:10px\"><b>${dayName(d)} <span class=\"num\">${dmy(d)}</span></b><span class=\"note num\">\u0623\u064f\u0631\u0633\u0644 ${byDay[d].filter(x=>x.s).length} \u0645\u0646 ${byDay[d].length}</span></div>",
"     ${byDay[d].sort((a,b)=>(!!a.s)-(!!b.s)||a.d-b.d).map(x=>`<button class=\"ntc\" data-go=\"${d}\"><span><b class=\"num\">${BN(x.i)}</b> \u2014 ${esc(x.name)||\"\u0628\u062f\u0648\u0646 \u0627\u0633\u0645\"}<br><span class=\"num ${x.d<0?\"neg\":\"pos\"}\">${x.d<0?\"\u0639\u062c\u0632\":\"\u0632\u064a\u0627\u062f\u0629\"} ${fmt(Math.abs(x.d))}</span></span>",
"       ${x.s?`<span class=\"pill saved\">\u0623\u064f\u0631\u0633\u0644 ${esc(x.s.ch||\"\")} ${esc(timeOf(x.s.at))}<br><small>${esc(x.s.by||\"\")}${x.s.ack?\" \u00b7 \u2713 \u0623\u0643\u062f\u062a\":x.s.seen?\" \u00b7 \ud83d\udc41 \u0641\u062a\u062d\u062a\":\"\"}</small></span>`:`<span class=\"pill err\">\u0644\u0645 \u064a\u064f\u0631\u0633\u0644</span>`}</button>`).join(\"\")}`).join(\"\")}`",
"   :`<div class=\"card empty\">\u0644\u0627 \u064a\u0648\u062c\u062f \u0639\u062c\u0632 \u0623\u0648 \u0632\u064a\u0627\u062f\u0629 \u0641\u064a \u0622\u062e\u0631 7 \u0623\u064a\u0627\u0645.</div>`;",
"  const s=sheet(\"\u0625\u0634\u0639\u0627\u0631\u0627\u062a \u0627\u0644\u0639\u062c\u0632 \u0648\u0627\u0644\u0632\u064a\u0627\u062f\u0629\",body,`<button class=\"btn\" data-close>\u0625\u063a\u0644\u0627\u0642</button>`);",
"  s.el.querySelectorAll(\"[data-go]\").forEach(b=>b.onclick=()=>{s.close();tab=\"boxes\";goDate(b.dataset.go).then(()=>render())});",
"}",
"let bootNoticed=false;",
