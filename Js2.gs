"  if(bootNoticed||effectiveRole()!==\"acc\")return;bootNoticed=true;",
"  const t=todayISO(),n=noticeItems().filter(x=>!x.s&&x.date<t).length;let q=0;for(let k=0;k<7;k++){const L=rqList(addDays(t,-k));q+=L.boxes.length+L.rets.length}",
"  const msg=[q?`${q} \u0637\u0644\u0628 \u0627\u0639\u062a\u0645\u0627\u062f \u0645\u0646 \u0645\u0633\u0624\u0648\u0644 \u0627\u0644\u0643\u0627\u0634\u064a\u0631\u0627\u062a`:\"\",n?`${n} \u0639\u062c\u0632/\u0632\u064a\u0627\u062f\u0629 \u0645\u0646 \u0627\u0644\u0623\u064a\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642\u0629 \u0644\u0645 \u064a\u064f\u0631\u0633\u0644 \u0644\u0644\u0645\u0648\u0638\u0641\u0627\u062a`:\"\"].filter(Boolean).join(\"\u060c \u0648\");",
"  if(msg)setTimeout(()=>toast(\"\u062a\u0646\u0628\u064a\u0647: \"+msg),900);",
"}",
