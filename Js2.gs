"/* ---------- boxes: add, hide, delete, renumber, rename ---------- */",
"let boxEd=null;",
"function boxEdInit(){const n=BOXES;boxEd={n,rows:Array.from({length:n},(_,i)=>({no:BN(i),label:boxLabel(i),name:boxName(i),off:boxHidden(i),used:boxUsed(i)}))}}",
"function boxUsed(i){for(const d of days.values()){if(d&&!d.namesOnly&&d.boxes&&d.boxes[i]&&hasData(Object.assign(emptyBox(i),d.boxes[i])))return true}return false}",
"function boxSync(){document.querySelectorAll(\"[data-brow]\").forEach(r=>{const k=+r.dataset.brow,R=boxEd.rows[k];if(!R)return;R.no=parseInt(num(r.querySelector(\"[data-bf=no]\").value),10)||\"\";R.label=r.querySelector(\"[data-bf=label]\").value.trim();R.name=r.querySelector(\"[data-bf=name]\").value.trim()})}",
"function drawBoxCard(){",
"  if(!boxEd)boxEdInit();const C=$(\"#boxCard\");if(!C)return;",
"  const vis=boxEd.rows.filter(r=>!r.off).length;",
"  C.innerHTML=`<div class=\"sec-h\"><h2>\u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642</h2><button class=\"btn small primary\" id=\"bxAdd\" type=\"button\">+ \u0625\u0636\u0627\u0641\u0629 \u0635\u0646\u062f\u0648\u0642</button></div>",
"   <p class=\"note\" style=\"margin:4px 0 8px\">\u0631\u0642\u0645 \u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u0648\u0627\u0633\u0645\u0647 (\u0627\u062e\u062a\u064a\u0627\u0631\u064a) \u0648\u0627\u0644\u0645\u0648\u0638\u0641\u0629 \u0627\u0644\u0645\u0633\u062c\u0651\u0644\u0629 \u0639\u0644\u064a\u0647. \u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u0627\u0644\u0644\u064a \u0639\u0644\u064a\u0647 \u0628\u064a\u0627\u0646\u0627\u062a \u0633\u0627\u0628\u0642\u0629 \u064a\u064f\u062e\u0641\u0649 \u0628\u062f\u0644 \u0645\u0627 \u064a\u0646\u062d\u0630\u0641\u060c \u0639\u0634\u0627\u0646 \u062a\u0628\u0642\u0649 \u062a\u0642\u0627\u0631\u064a\u0631\u0647 \u0627\u0644\u0642\u062f\u064a\u0645\u0629 \u0633\u0644\u064a\u0645\u0629.</p>",
"   <p class=\"note\" style=\"margin:0 0 8px\">\u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642 \u0627\u0644\u0638\u0627\u0647\u0631\u0629: <b class=\"num\">${vis}</b> \u0645\u0646 <b class=\"num\">${boxEd.n}</b></p>",
"   <datalist id=\"dlBN\">${settings.cashiers.map(n=>`<option value=\"${esc(n)}\">`).join(\"\")}</datalist>",
"   ${boxEd.rows.map((r,k)=>`<div class=\"bxrow ${r.off?\"off\":\"\"}\" data-brow=\"${k}\">",
"     <input class=\"inp num\" data-bf=\"no\" inputmode=\"numeric\" value=\"${esc(r.no)}\" aria-label=\"\u0631\u0642\u0645 \u0627\u0644\u0635\u0646\u062f\u0648\u0642\">",
"     <input class=\"inp\" data-bf=\"label\" value=\"${esc(r.label)}\" placeholder=\"\u0627\u0633\u0645 \u0627\u0644\u0635\u0646\u062f\u0648\u0642\" aria-label=\"\u0627\u0633\u0645 \u0627\u0644\u0635\u0646\u062f\u0648\u0642\">",
"     <input class=\"inp\" data-bf=\"name\" list=\"dlBN\" autocomplete=\"off\" value=\"${esc(r.name)}\" placeholder=\"\u0627\u0644\u0645\u0648\u0638\u0641\u0629\" aria-label=\"\u0627\u0644\u0645\u0648\u0638\u0641\u0629\" data-bn=\"${k}\">",
"     ${r.off?`<button class=\"btn small\" type=\"button\" data-bshow=\"${k}\">\u0625\u0638\u0647\u0627\u0631</button>`:`<button class=\"btn small\" type=\"button\" data-bdel=\"${k}\">\u062d\u0630\u0641</button>`}</div>`).join(\"\")}`;",
"  $(\"#bxAdd\").onclick=()=>{boxSync();if(boxEd.n>=60){toast(\"\u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0639\u0644\u0649 60 \u0635\u0646\u062f\u0648\u0642\");return}const mx=Math.max(0,...boxEd.rows.map(r=>+r.no||0));boxEd.rows.push({no:mx+1,label:\"\",name:\"\",off:false,used:false});boxEd.n++;drawBoxCard();toast(\"\u0623\u064f\u0636\u064a\u0641 \u0635\u0646\u062f\u0648\u0642 \"+(mx+1)+\"\u060c \u0627\u0636\u063a\u0637 \u00ab\u062d\u0641\u0638 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a\u00bb\")};",
"  C.querySelectorAll(\"[data-bdel]\").forEach(b=>b.onclick=async()=>{boxSync();const k=+b.dataset.bdel,R=boxEd.rows[k];",
"    const last=k===boxEd.rows.length-1&&!R.used;",
"    const v=await ask(last?`\u062d\u0630\u0641 \u0635\u0646\u062f\u0648\u0642 ${R.no} \u0646\u0647\u0627\u0626\u064a\u0627\u064b\u061f`:`\u0625\u062e\u0641\u0627\u0621 \u0635\u0646\u062f\u0648\u0642 ${R.no}\u061f \u064a\u062e\u062a\u0641\u064a \u0645\u0646 \u0627\u0644\u0625\u062f\u062e\u0627\u0644 \u0648\u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u062c\u062f\u064a\u062f\u0629\u060c \u0648\u062a\u0628\u0642\u0649 \u0628\u064a\u0627\u0646\u0627\u062a\u0647 \u0627\u0644\u0633\u0627\u0628\u0642\u0629 \u0641\u064a \u062a\u0642\u0627\u0631\u064a\u0631\u0647\u0627.`,[{t:last?\"\u062d\u0630\u0641\":\"\u0625\u062e\u0641\u0627\u0621\",v:1,cls:\"danger\"},{t:\"\u0625\u0644\u063a\u0627\u0621\",v:0}]);",
"    if(!v)return;if(last){boxEd.rows.pop();boxEd.n--}else R.off=true;drawBoxCard()});",
"  C.querySelectorAll(\"[data-bshow]\").forEach(b=>b.onclick=()=>{boxSync();boxEd.rows[+b.dataset.bshow].off=false;drawBoxCard()});",
"}",
"function boxesRead(){",
"  if(!boxEd)return true;boxSync();const seen={};",
"  for(const r of boxEd.rows){if(!r.no||r.no<1){toast(\"\u0627\u0643\u062a\u0628 \u0631\u0642\u0645 \u0644\u0643\u0644 \u0635\u0646\u062f\u0648\u0642\");return false}if(seen[r.no]){toast(\"\u0631\u0642\u0645 \u0627\u0644\u0635\u0646\u062f\u0648\u0642 \"+r.no+\" \u0645\u0643\u0631\u0631\");return false}seen[r.no]=1}",
"  if(!boxEd.rows.some(r=>!r.off)){toast(\"\u0644\u0627\u0632\u0645 \u064a\u0628\u0642\u0649 \u0635\u0646\u062f\u0648\u0642 \u0648\u0627\u062d\u062f \u0638\u0627\u0647\u0631 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644\");return false}",
"  settings.boxSlots=boxEd.n;settings.boxNos=boxEd.rows.map(r=>r.no);settings.boxLabels=boxEd.rows.map(r=>r.label);settings.boxNames=boxEd.rows.map(r=>r.name);settings.boxOff=boxEd.rows.map(r=>!!r.off);",
"  boxEd=null;return true;",
"}",
"/* ---------- company logo ---------- */",
"function pickLogo(f){",
"  if(!/^image\\//.test(f.type)){toast(\"\u0627\u062e\u062a\u0631 \u0645\u0644\u0641 \u0635\u0648\u0631\u0629\");return}",
"  const rd=new FileReader();rd.onload=()=>{const im=new Image();im.onload=async()=>{",
"    const M=360,sc=Math.min(1,M/Math.max(im.width,im.height)),w=Math.max(1,Math.round(im.width*sc)),h=Math.max(1,Math.round(im.height*sc));",
"    const cv=document.createElement(\"canvas\");cv.width=w;cv.height=h;const g=cv.getContext(\"2d\");g.drawImage(im,0,0,w,h);",
"    let d=cv.toDataURL(\"image/png\");if(d.length>150000){const c2=document.createElement(\"canvas\");c2.width=w;c2.height=h;const g2=c2.getContext(\"2d\");g2.fillStyle=\"#fff\";g2.fillRect(0,0,w,h);g2.drawImage(im,0,0,w,h);d=c2.toDataURL(\"image/jpeg\",.85)}",
"    try{const r=await api(\"saveLogo\",{data:d});LOGO=d;try{ls.set(\"ccd-logo\",d);ls.set(\"ccd-logo-v\",r.v)}catch(e){}settings.logoV=r.v;paintLogo();toast(\"\u062a\u0645 \u062d\u0641\u0638 \u0627\u0644\u0634\u0639\u0627\u0631\");renderSettings()}catch(e){toast(e.msg||\"\u062a\u0639\u0630\u0651\u0631 \u062d\u0641\u0638 \u0627\u0644\u0634\u0639\u0627\u0631\")}};",
"    im.onerror=()=>toast(\"\u062a\u0639\u0630\u0651\u0631 \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0635\u0648\u0631\u0629\");im.src=rd.result};rd.readAsDataURL(f);",
"}",
