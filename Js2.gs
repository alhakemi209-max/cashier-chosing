"/* watermark picture: resized on the phone before upload */",
"function pickWm(f){",
"  if(!/^image\\//.test(f.type)){toast(\"\u0627\u062e\u062a\u0631 \u0645\u0644\u0641 \u0635\u0648\u0631\u0629\");return}",
"  const rd=new FileReader();rd.onload=()=>{const im=new Image();im.onload=async()=>{",
"    const M=600,sc=Math.min(1,M/Math.max(im.width,im.height)),w=Math.max(1,Math.round(im.width*sc)),h=Math.max(1,Math.round(im.height*sc));",
"    const cv=document.createElement(\"canvas\");cv.width=w;cv.height=h;cv.getContext(\"2d\").drawImage(im,0,0,w,h);",
"    let d=cv.toDataURL(\"image/png\");if(d.length>250000){const c2=document.createElement(\"canvas\");c2.width=w;c2.height=h;const g=c2.getContext(\"2d\");g.fillStyle=\"#fff\";g.fillRect(0,0,w,h);g.drawImage(im,0,0,w,h);d=c2.toDataURL(\"image/jpeg\",.8)}",
"    try{const r=await api(\"saveWm\",{data:d});WM=d;try{ls.set(\"ccd-wm\",d);ls.set(\"ccd-wm-v\",r.v)}catch(e){}settings.wmV=r.v;settings.logoWm=true;paintLogo();toast(\"\u062a\u0645 \u062d\u0641\u0638 \u0635\u0648\u0631\u0629 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u0645\u0627\u0626\u064a\u0629\");renderSettings()}catch(e){toast(e.msg||\"\u062a\u0639\u0630\u0651\u0631 \u0627\u0644\u062d\u0641\u0638\")}};",
"    im.onerror=()=>toast(\"\u062a\u0639\u0630\u0651\u0631 \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0635\u0648\u0631\u0629\");im.src=rd.result};rd.readAsDataURL(f);",
"}",
