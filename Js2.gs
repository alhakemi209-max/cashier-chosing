"/* which sections a user sees: users and branches belong to the system's main accountant */",
"function secVisible(k){return(k!==\"users\"&&k!==\"branches\")||!!(me&&me.admin)}",
"/* branches */",
"function secBranches(){const L=ALLBR||BRANCHES||[];return`<div class=\"card\"><div class=\"sec-h\"><h3 class=\"set-h\" style=\"margin:0\">\u0627\u0644\u0641\u0631\u0648\u0639</h3><button class=\"btn small primary\" id=\"brAdd\" type=\"button\">${svgI(\"plus\")}\u0641\u0631\u0639 \u062c\u062f\u064a\u062f</button></div>",
"   <div class=\"ulist\">${L.map(b=>`<button class=\"person\" type=\"button\" data-bre=\"${esc(b.id)}\"><span class=\"av\">${esc(String(b.name).trim().charAt(0))}</span><span class=\"p-txt\"><b>${esc(b.name)}</b><span class=\"p-tags\">${b.id===\"main\"?`<span class=\"tag ok\">\u0627\u0644\u0641\u0631\u0639 \u0627\u0644\u0631\u0626\u064a\u0633\u064a</span>`:\"\"}${b.id===BRC?`<span class=\"tag\">\u0627\u0644\u0645\u0641\u062a\u0648\u062d \u0627\u0644\u0622\u0646</span>`:\"\"}</span></span><span class=\"set-chev\">${svgI(\"chev\")}</span></button>`).join(\"\")}</div></div>",
"  <p class=\"note set-note\">\u0643\u0644 \u0641\u0631\u0639 \u0644\u0647 \u0635\u0646\u0627\u062f\u064a\u0642\u0647 \u0648\u0645\u0648\u0638\u0641\u0648\u0647 \u0648\u0625\u0639\u062f\u0627\u062f\u0627\u062a\u0647 \u0648\u062a\u0642\u0627\u0631\u064a\u0631\u0647 \u0628\u0634\u0643\u0644 \u0645\u0633\u062a\u0642\u0644\u060c \u0639\u0644\u0649 \u0646\u0641\u0633 \u0631\u0627\u0628\u0637 \u0627\u0644\u0646\u0638\u0627\u0645 \u0648\u062c\u062f\u0648\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a. \u062a\u0628\u062f\u0651\u0644 \u0628\u064a\u0646 \u0627\u0644\u0641\u0631\u0648\u0639 \u0645\u0646 \u0627\u0633\u0645 \u0627\u0644\u0641\u0631\u0639 \u0623\u0639\u0644\u0649 \u0627\u0644\u0634\u0627\u0634\u0629\u060c \u0648\u062a\u0637\u0644\u0639 \u062a\u0642\u0631\u064a\u0631 \u0645\u062c\u0645\u0651\u0639 \u0623\u0648 \u0644\u0643\u0644 \u0641\u0631\u0639 \u0645\u0646 \u0634\u0627\u0634\u0629 \u00ab\u0627\u0644\u0641\u0631\u0648\u0639\u00bb.</p>`}",
"function bindBranches(){",
"  const L=()=>ALLBR||BRANCHES||[];",
"  const edit=b=>{const s=sheet(b?\"\u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0641\u0631\u0639\":\"\u0641\u0631\u0639 \u062c\u062f\u064a\u062f\",`<div class=\"field\"><label for=\"brNm\">\u0627\u0633\u0645 \u0627\u0644\u0641\u0631\u0639</label><input class=\"inp\" id=\"brNm\" maxlength=\"60\" value=\"${esc(b?b.name:\"\")}\" placeholder=\"\u0645\u062b\u0627\u0644: \u0641\u0631\u0639 \u062c\u062f\u0629\"></div>${b?\"\":`<p class=\"note\">\u064a\u0628\u062f\u0623 \u0627\u0644\u0641\u0631\u0639 \u0627\u0644\u062c\u062f\u064a\u062f \u0628\u062f\u0648\u0646 \u0628\u064a\u0627\u0646\u0627\u062a. \u0628\u0639\u062f \u0625\u0636\u0627\u0641\u062a\u0647 \u0627\u0641\u062a\u062d\u0647 \u0645\u0646 \u0623\u0639\u0644\u0649 \u0627\u0644\u0634\u0627\u0634\u0629 \u0648\u0627\u0636\u0628\u0637 \u0635\u0646\u0627\u062f\u064a\u0642\u0647 \u0648\u0645\u0648\u0638\u0641\u064a\u0647\u060c \u0648\u0623\u0636\u0641 \u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0647 \u0645\u0646 \u00ab\u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0648\u0627\u0644\u0635\u0644\u0627\u062d\u064a\u0627\u062a\u00bb.</p>`}`,",
"     `${b&&b.id!==\"main\"?`<button class=\"btn danger\" id=\"brDel\">\u062d\u0630\u0641</button>`:\"\"}<button class=\"btn primary\" id=\"brSv\">\u062d\u0641\u0638</button>`);",
"    $(\"#brSv\").onclick=async()=>{const name=$(\"#brNm\").value.trim();if(!name){toast(\"\u0627\u0643\u062a\u0628 \u0627\u0633\u0645 \u0627\u0644\u0641\u0631\u0639\");return}",
"      try{const r=await api(\"saveBranch\",{id:b?b.id:\"\",name});ALLBR=r;BRANCHES=me.admin?r:BRANCHES;if(b&&b.id===BRC)settings.branch=name;cacheSave();s.close();renderSettings();renderTop();toast(b?\"\u062a\u0645 \u062d\u0641\u0638 \u0627\u0633\u0645 \u0627\u0644\u0641\u0631\u0639\":\"\u062a\u0645\u062a \u0625\u0636\u0627\u0641\u0629 \"+name)}catch(e){toast(e.msg||\"\u062a\u0639\u0630\u0651\u0631 \u0627\u0644\u062d\u0641\u0638\")}};",
"    const d=$(\"#brDel\");if(d)d.onclick=async()=>{s.close();if(!await ask(`\u062d\u0630\u0641 ${esc(b.name)}\u061f \u064a\u064f\u062d\u0630\u0641 \u0641\u0642\u0637 \u0625\u0630\u0627 \u0645\u0627 \u0639\u0644\u064a\u0647 \u0628\u064a\u0627\u0646\u0627\u062a \u0648\u0644\u0627 \u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646.`,[{t:\"\u062d\u0630\u0641\",v:1,cls:\"danger\"},{t:\"\u0625\u0644\u063a\u0627\u0621\",v:0}]))return;",
"      try{const r=await api(\"deleteBranch\",{id:b.id});ALLBR=r;BRANCHES=r;cacheSave();renderSettings();renderTop();toast(\"\u062a\u0645 \u062d\u0630\u0641 \u0627\u0644\u0641\u0631\u0639\")}catch(e){toast(e.msg||\"\u062a\u0639\u0630\u0651\u0631 \u0627\u0644\u062d\u0630\u0641\")}}};",
"  $(\"#brAdd\").onclick=()=>edit(null);",
"  document.querySelectorAll(\"[data-bre]\").forEach(x=>x.onclick=()=>edit(L().find(b=>b.id===x.dataset.bre)));",
"}",
"/* optional screens */",
