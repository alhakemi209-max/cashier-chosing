"   ${role===\"own\"?`<p class=\"note\">\u0627\u0644\u0645\u0627\u0644\u0643 \u0627\u0637\u0644\u0627\u0639 \u0641\u0642\u0637 \u0639\u0644\u0649 \u0627\u0644\u0641\u0631\u0648\u0639 \u0627\u0644\u0645\u062e\u062a\u0627\u0631\u0629 \u0628\u062f\u0648\u0646 \u062d\u062f \u0644\u0644\u0641\u062a\u0631\u0629\u060c \u0648\u064a\u0637\u0644\u0639 \u062a\u0642\u0631\u064a\u0631 \u0645\u062c\u0645\u0651\u0639 \u0623\u0648 \u0644\u0643\u0644 \u0641\u0631\u0639.</p>`:\"\"}",
"   ${role===\"own\"?`<label class=\"chk\"><input type=\"checkbox\" id=\"p-tot\" ${p.totals?\"checked\":\"\"}>\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\u0627\u062a \u0641\u0642\u0637: \u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0643\u0627\u0634 \u0648\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0634\u0628\u0643\u0627\u062a \u0648\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\u060c \u0628\u062f\u0648\u0646 \u0627\u0644\u0639\u062c\u0632 \u0648\u0627\u0644\u0632\u064a\u0627\u062f\u0629 \u0648\u0627\u0644\u0646\u0642\u0635</label>`:\"\"}",
"   <button class=\"btn small\" id=\"p-def\" type=\"button\">\u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a</button></div>`;",
"  $(\"#p-def\").onclick=()=>permsUI(role,null);",
"  // a supervisor follows the company default until the accountant picks one for him",
"  box.dataset.apSet=p&&typeof p.approve===\"boolean\"?\"1\":\"\";",
"  box.querySelectorAll(\"[data-ap]\").forEach(x=>x.onclick=()=>{box.dataset.apSet=\"1\";box.querySelectorAll(\"[data-ap]\").forEach(y=>y.setAttribute(\"aria-pressed\",y===x));",
"    $(\"#p-apNote\").textContent=x.dataset.ap===\"1\"?\"\u062a\u0638\u0647\u0631 \u0625\u062f\u062e\u0627\u0644\u0627\u062a\u0647 \u0644\u0644\u0645\u062d\u0627\u0633\u0628 \u00ab\u0628\u0627\u0646\u062a\u0638\u0627\u0631 \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f\u00bb\u060c \u0648\u0645\u0627 \u062a\u062f\u062e\u0644 \u0641\u064a \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0625\u0644\u0627 \u0628\u0639\u062f \u0645\u0627 \u064a\u0639\u062a\u0645\u062f\u0647\u0627.\":\"\u0625\u062f\u062e\u0627\u0644\u0627\u062a\u0647 \u062a\u062f\u062e\u0644 \u0641\u064a \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0623\u0648\u0644 \u0645\u0627 \u064a\u062d\u0641\u0638\u0647\u0627\u060c \u0628\u062f\u0648\u0646 \u0627\u0646\u062a\u0638\u0627\u0631 \u0627\u0639\u062a\u0645\u0627\u062f.\"});",
"  const tt=$(\"#p-tot\"),lock=()=>document.querySelectorAll(\"[data-pt]\").forEach(x=>{x.disabled=tt.checked;x.parentElement.style.opacity=tt.checked?.45:\"\"});if(tt){tt.onchange=lock;lock()}",
"  const w=$(\"#p-wa\"),sh=document.querySelector('[data-pt=\"short\"]');if(w&&sh&&role===\"sup\")w.onchange=()=>{if(w.checked)sh.checked=true};",
"}",
"const apOf=p=>typeof(p&&p.approve)===\"boolean\"?p.approve:settings.supApprove!==false;",
"function permsRead(){",
"  const role=$(\"#u-role\").value;if(role===\"acc\")return null;",
"  const tabs=[...document.querySelectorAll(\"[data-pt]\")].filter(x=>x.checked).map(x=>x.dataset.pt);",
"  const o={tabs:tabs.length?tabs:PERM_DEF[role].tabs};",
"  const x=$(\"#p-xlsx\");if(x)o.xlsx=x.checked;const w=$(\"#p-wa\");if(w)o.wa=w.checked;const d=$(\"#p-days\");if(d)o.days=+d.value;",
"  const tt=$(\"#p-tot\");if(tt)o.totals=tt.checked;",
"  const ap=document.querySelector('[data-ap][aria-pressed=\"true\"]');if(ap&&$(\"#u-perms\").dataset.apSet===\"1\")o.approve=ap.dataset.ap===\"1\";",
"  if(role===\"own\"){const bx=[...document.querySelectorAll(\"[data-ubr]\")];if(bx.length){const on=bx.filter(e=>e.checked).map(e=>e.dataset.ubr);o.branches=on.length===bx.length?\"*\":on}}",
"  return o;",
"}",
