"  <div class=\"card\"><h2>\u0637\u0628\u0627\u0639\u0629 \u0627\u0644\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u064a\u0648\u0645\u064a</h2><p class=\"note\" style=\"margin:4px 0 10px\">\u0627\u0644\u0645\u062c\u0645\u0651\u0639: \u0627\u0644\u0643\u0627\u0634 \u0648\u0627\u0644\u0634\u0628\u0643\u0627\u062a \u0645\u062c\u0645\u0651\u0639\u0629 \u0648\u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0648\u0627\u0644\u0632\u064a\u0627\u062f\u0629/\u0627\u0644\u0646\u0642\u0635. \u0627\u0644\u0645\u0641\u0635\u0651\u0644: \u0643\u0644 \u0634\u0628\u0643\u0629 \u0645\u0646\u0641\u0635\u0644\u0629.</p><div class=\"row-btns\"><button class=\"btn primary\" id=\"pdfA\">\u0627\u0644\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0645\u062c\u0645\u0651\u0639</button><button class=\"btn primary\" id=\"pdfB\">\u0627\u0644\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0645\u0641\u0635\u0651\u0644</button></div>${r!==\"sup\"?`<div class=\"row-btns\" style=\"margin-top:8px\"><button class=\"btn\" id=\"sumPdf\">\u062a\u0642\u0631\u064a\u0631 \u062a\u0641\u0635\u064a\u0644 \u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642</button><button class=\"btn\" id=\"sumXlsx\">\u062a\u0635\u062f\u064a\u0631 Excel</button></div>`:\"\"}</div>",
"  <h2>\u0645\u0644\u062e\u0635 \u0635\u0646\u0627\u062f\u064a\u0642 \u0627\u0644\u064a\u0648\u0645</h2>",
"  ${list.length?`<div class=\"tbl-wrap\"><table><thead><tr><th>\u0635</th><th>\u0627\u0644\u0643\u0627\u0634\u064a\u0631</th><th class=\"n\">\u0627\u0644\u0643\u0627\u0634</th><th class=\"n\">\u0645\u0631\u062a\u062c\u0639\u0627\u062a</th><th class=\"n\">\u0627\u0644\u0634\u0628\u0643\u0627\u062a</th><th class=\"n\">\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</th><th class=\"n\">\u0627\u0644\u062a\u0642\u0631\u064a\u0631</th><th class=\"n\">\u0627\u0644\u0641\u0631\u0642</th></tr></thead><tbody>${rows}</tbody>",
"   <tfoot><tr><td colspan=\"2\">\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</td><td class=\"n num\">${fmt(t.cash)}</td><td class=\"n num\">${fmt(t.ret)}</td><td class=\"n num\">${fmt(t.net)}</td><td class=\"n num\">${fmt(t.cash+t.net)}</td><td class=\"n num\">${fmt(t.report)}</td><td class=\"n num\">${fmtS(t.diff)}</td></tr></tfoot></table></div>`",
"   :`<div class=\"card empty\">\u0644\u0645 \u062a\u064f\u062f\u062e\u0644 \u0628\u064a\u0627\u0646\u0627\u062a \u0623\u064a \u0635\u0646\u062f\u0648\u0642 \u0644\u0647\u0630\u0627 \u0627\u0644\u064a\u0648\u0645 \u0628\u0639\u062f.<br>\u0627\u0641\u062a\u062d \u062a\u0628\u0648\u064a\u0628 \u00ab\u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642\u00bb \u0648\u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u0631\u0642\u0645 \u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u0644\u0625\u062f\u062e\u0627\u0644 \u0625\u0642\u0641\u0627\u0644\u0647.</div>`}",
"  <div class=\"card\"><h2 style=\"margin-bottom:6px\">\u062a\u0641\u0635\u064a\u0644 \u0627\u0644\u0634\u0628\u0643\u0627\u062a</h2>${NV().map(([k,l])=>`<div class=\"calc\" style=\"font-weight:400\"><span>${l}</span><span class=\"num\">${fmt(t.nets[k])}</span></div>`).join(\"\")}<div class=\"calc\"><span>\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0634\u0628\u0643\u0627\u062a</span><span class=\"num\">${fmt(t.net)}</span></div></div>",
"  ${fxSummaryCard(cur)}<div class=\"card\"><h2 style=\"margin-bottom:6px\">\u0627\u0644\u0645\u0637\u0627\u0628\u0642\u0629</h2>",
"   <div class=\"calc\" style=\"font-weight:400\"><span>\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0643\u0627\u0634 \u0642\u0628\u0644 \u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a</span><span class=\"num\">${fmt(t.cash)}</span></div>",
"   <div class=\"calc\" style=\"font-weight:400\"><span>\u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a</span><span class=\"num neg\">${fmt(t.ret)}</span></div>",
"   <div class=\"calc\"><span>\u0635\u0627\u0641\u064a \u0627\u0644\u0643\u0627\u0634</span><span class=\"num\">${fmt(t.cashNet)}</span></div>",
"   <div class=\"calc\"><span>\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0643\u0644\u064a (\u0643\u0627\u0634 + \u0634\u0628\u0643\u0627\u062a)</span><span class=\"num\">${fmt(t.total)}</span></div>",
"   <div class=\"calc\" style=\"font-weight:400\"><span>\u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645 \u0642\u0628\u0644 \u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a</span><span class=\"num\">${fmt(t.report)}</span></div>",
"   <div class=\"calc\"><span>\u0635\u0627\u0641\u064a \u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645</span><span class=\"num\">${fmt(t.reportNet)}</span></div>",
"   <div class=\"calc\"><span>\u0627\u0644\u0632\u064a\u0627\u062f\u0629 / \u0627\u0644\u0646\u0642\u0635</span><span class=\"num ${cls(t.diff)}\">${fmtS(t.diff)}</span></div>",
"   ${t.count?`<div class=\"banner ${statusOf(t.diff)[0]}\">${statusOf(t.diff)[1]}</div>`:\"\"}</div>",
"  ${cur.isSaved&&cur.savedBy?`<p class=\"note\" style=\"margin:0\">\u0622\u062e\u0631 \u062d\u0641\u0638: ${esc(cur.savedBy)}</p>`:\"\"}${cur.isSaved&&r===\"acc\"&&periodOpen(cur.date)?`<button class=\"btn danger block\" id=\"delDay\">\u062d\u0630\u0641 \u0628\u064a\u0627\u0646\u0627\u062a \u0647\u0630\u0627 \u0627\u0644\u064a\u0648\u0645</button>`:\"\"}`;",
"  $(\"#view\").querySelectorAll(\"[data-box]\").forEach(x=>x.onclick=()=>openBox(+x.dataset.box));",
"  const sx=$(\"#sumXlsx\");if(sx)sx.onclick=()=>xlsxDay(cur);const sp=$(\"#sumPdf\");if(sp)sp.onclick=()=>preview(\"\u062a\u0641\u0635\u064a\u0644 \u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642\",rcptDay(cur),`\u062a\u0641\u0635\u064a\u0644-\u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642-${cur.date}.pdf`);",
"  $(\"#pdfA\").onclick=()=>preview(\"\u0627\u0644\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0645\u062c\u0645\u0651\u0639\",rcptDayShort(cur,false),`\u0627\u0644\u062a\u0642\u0631\u064a\u0631-\u0627\u0644\u064a\u0648\u0645\u064a-\u0645\u062c\u0645\u0639-${cur.date}.pdf`);",
"  $(\"#pdfB\").onclick=()=>preview(\"\u0627\u0644\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0645\u0641\u0635\u0651\u0644\",p=>p===\"a4\"?rcptDayA4(cur):rcptDayShort(cur,true),`\u0627\u0644\u062a\u0642\u0631\u064a\u0631-\u0627\u0644\u064a\u0648\u0645\u064a-\u0645\u0641\u0635\u0644-${cur.date}.pdf`);",
"  const d=$(\"#delDay\");if(d)d.onclick=async()=>{const v=await ask(\"\u062d\u0630\u0641 \u062c\u0645\u064a\u0639 \u0628\u064a\u0627\u0646\u0627\u062a \u064a\u0648\u0645 \"+dmy(cur.date)+\" \u0646\u0647\u0627\u0626\u064a\u0627\u064b\u061f\",[{t:\"\u062d\u0630\u0641\",v:1,cls:\"danger\"},{t:\"\u0625\u0644\u063a\u0627\u0621\",v:0}]);if(v)deleteDay(cur.date)};",
"}",
