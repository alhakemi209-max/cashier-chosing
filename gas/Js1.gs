"  const fn=label.replace(/[\\s/]+/g,\"-\");const ps=$(\"#repSum\");if(ps)ps.onclick=()=>preview(\"\u0627\u0644\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0645\u0644\u062e\u0635\",rcptPeriod(A,label,false),`\u0645\u0644\u062e\u0635-${fn}.pdf`);const pa=$(\"#repAna\");if(pa)pa.onclick=()=>preview(\"\u0627\u0644\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u062a\u062d\u0644\u064a\u0644\u064a\",rcptPeriod(A,label,true),`\u062a\u062d\u0644\u064a\u0644\u064a-${fn}.pdf`);",
"  const c=$(\"#repCsv\");if(c)c.onclick=()=>xlsxReport(list,A,label);",
"}",
