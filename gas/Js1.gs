"async function logout(){",
"  if(!effectiveRole())return;",
"  const v=await ask(\"\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062e\u0631\u0648\u062c \u0645\u0646 \u0647\u0630\u0627 \u0627\u0644\u062c\u0647\u0627\u0632\u061f\"+(pendDates().length?\" \u062a\u0648\u062c\u062f \u062a\u0639\u062f\u064a\u0644\u0627\u062a \u0644\u0645 \u062a\u0635\u0644 \u0644\u0644\u062e\u0627\u062f\u0645 \u0628\u0639\u062f\u060c \u0648\u0633\u062a\u0628\u0642\u0649 \u0639\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u062c\u0647\u0627\u0632.\":\"\"),[{t:\"\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062e\u0631\u0648\u062c\",v:1,cls:\"primary\"},{t:\"\u0625\u0644\u063a\u0627\u0621\",v:0}]);",
"  if(!v)return;try{await api(\"logout\")}catch(e){}",
"  signOutLocal();render();",
"}",
