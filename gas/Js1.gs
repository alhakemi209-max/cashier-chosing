"/* ---------- commission tab ---------- */",
"function commCalc(list){",
"  const rate=+settings.rate||0;const T={sales:0,ret:0,base:0,comm:0,days:list.length,n:0};const byBox={},byCash={},byDay=[];",
"  list.forEach(d=>{const D={date:d.date,base:0,comm:0,n:0};",
"    d.boxes.forEach((b,i)=>{if(!hasData(b)||!comKeep(b,i))return;const sales=+b.report||0,ret=settings.rateNet?retOfBox(d,i):0,base=sales+ret,comm=base/1000*rate;",
"      const add=(M,key,label)=>{const X=M[key]||(M[key]={key,label,n:0,sales:0,ret:0,base:0,comm:0});X.n++;X.sales+=sales;X.ret+=ret;X.base+=base;X.comm+=comm};",
"      const nm=(b.cashier||\"\u0628\u062f\u0648\u0646 \u0627\u0633\u0645\").trim();add(byBox,i+1,\"\u0635\u0646\u062f\u0648\u0642 \"+BN(i));add(byCash,nm,nm);",
"      T.sales+=sales;T.ret+=ret;T.base+=base;T.comm+=comm;T.n++;D.base+=base;D.comm+=comm;D.n++});",
"    byDay.push(D)});",
"  return{T,rate,box:Object.values(byBox).sort((a,b)=>a.key-b.key),cash:Object.values(byCash).sort((a,b)=>b.comm-a.comm),day:byDay};",
"}",
"function renderCommission(){",
"  const list=periodDays(com),C=commCalc(list),label=periodRange(com)[2],T=C.T,g=com.group,nt=settings.rateNet;",
"  let th,rows,ft;",
"  if(g===\"day\"){th=`<th>\u0627\u0644\u062a\u0627\u0631\u064a\u062e</th><th>\u0627\u0644\u064a\u0648\u0645</th><th class=\"n\">\u0625\u0642\u0641\u0627\u0644\u0627\u062a</th><th class=\"n\">\u0635\u0627\u0641\u064a \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a</th><th class=\"n\">\u0627\u0644\u0646\u0633\u0628\u0629</th>`;",
"    rows=C.day.map(d=>`<tr><td class=\"num\">${dmy(d.date)}</td><td>${dayName(d.date)}</td><td class=\"n num\">${d.n}</td><td class=\"n num\">${fmt(d.base)}</td><td class=\"n num\"><b>${fmt(d.comm)}</b></td></tr>`).join(\"\");",
"    ft=`<td colspan=\"2\">\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</td><td class=\"n num\">${T.n}</td><td class=\"n num\">${fmt(T.base)}</td><td class=\"n num\">${fmt(T.comm)}</td>`}",
"  else{const L=g===\"box\"?C.box:C.cash;",
"    th=`<th>${g===\"box\"?\"\u0627\u0644\u0635\u0646\u062f\u0648\u0642\":\"\u0627\u0644\u0643\u0627\u0634\u064a\u0631\"}</th><th class=\"n\">\u0625\u0642\u0641\u0627\u0644\u0627\u062a</th><th class=\"n\">\u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a</th>${nt?`<th class=\"n\">\u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a</th><th class=\"n\">\u0627\u0644\u0635\u0627\u0641\u064a</th>`:\"\"}<th class=\"n\">\u0627\u0644\u0646\u0633\u0628\u0629</th>`;",
"    rows=L.map(x=>`<tr><td>${esc(x.label)}</td><td class=\"n num\">${x.n}</td><td class=\"n num\">${fmt(x.sales)}</td>${nt?`<td class=\"n num\">${fmt(x.ret)}</td><td class=\"n num\">${fmt(x.base)}</td>`:\"\"}<td class=\"n num\"><b>${fmt(x.comm)}</b></td></tr>`).join(\"\");",
"    ft=`<td>\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</td><td class=\"n num\">${T.n}</td><td class=\"n num\">${fmt(T.sales)}</td>${nt?`<td class=\"n num\">${fmt(T.ret)}</td><td class=\"n num\">${fmt(T.base)}</td>`:\"\"}<td class=\"n num\">${fmt(T.comm)}</td>`}",
"  $(\"#view\").innerHTML=`${periodCtrl(com)}",
"  <div class=\"info\">\u0627\u0644\u0646\u0633\u0628\u0629 \u0627\u0644\u0645\u0639\u062a\u0645\u062f\u0629: <b class=\"num\">${fmt(C.rate)}</b> \u0631\u064a\u0627\u0644 \u0644\u0643\u0644 <b class=\"num\">1,000</b> \u0631\u064a\u0627\u0644 ${nt?\"\u0645\u0646 \u0635\u0627\u0641\u064a \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a \u0628\u0639\u062f \u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a\":\"\u0645\u0646 \u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a\"}</div>",
"  ${list.length?`<div class=\"strip\">",
"   <div class=\"stat\"><span>\u0635\u0627\u0641\u064a \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a</span><b class=\"num\">${fmt(T.base)}</b></div>",
"   <div class=\"stat ok\"><span>\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0646\u0633\u0628\u0629</span><b class=\"num\">${fmt(T.comm)}</b></div>",
"   <div class=\"stat\"><span>\u0623\u064a\u0627\u0645 \u0645\u0633\u062c\u0651\u0644\u0629</span><b class=\"num\">${T.days}</b></div>",
"   <div class=\"stat\"><span>\u0645\u062a\u0648\u0633\u0637 \u0627\u0644\u0646\u0633\u0628\u0629 \u0627\u0644\u064a\u0648\u0645\u064a\u0629</span><b class=\"num\">${fmt(T.comm/(T.days||1))}</b></div></div>",
"  ${comBar(list)}<div class=\"row-btns\"><button class=\"btn primary\" id=\"comPdf\">\u0637\u0628\u0627\u0639\u0629 \u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0646\u0633\u0628\u0629</button><button class=\"btn\" id=\"comCsv\">\u062a\u0635\u062f\u064a\u0631 Excel</button></div>",
"  <div class=\"seg\" role=\"group\" aria-label=\"\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u0639\u0631\u0636\">${[[\"box\",\"\u062d\u0633\u0628 \u0627\u0644\u0635\u0646\u062f\u0648\u0642\"],[\"cash\",\"\u062d\u0633\u0628 \u0627\u0644\u0643\u0627\u0634\u064a\u0631\"],[\"day\",\"\u062d\u0633\u0628 \u0627\u0644\u064a\u0648\u0645\"]].map(([k,l])=>`<button data-grp=\"${k}\" aria-pressed=\"${g===k}\">${l}</button>`).join(\"\")}</div>",
"  <div class=\"tbl-wrap\"><table><thead><tr>${th}</tr></thead><tbody>${rows}</tbody><tfoot><tr>${ft}</tr></tfoot></table></div>`",
