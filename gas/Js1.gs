"  const hb=s.el.querySelector(\"#bHist\");if(hb)hb.onclick=()=>boxHistory(i);bindRqPanel(s.el,i);",
"  upd();",
"}",
"function openReturns(){",
"  const opts=i=>`<option value=\"0\">\u2014 \u0627\u062e\u062a\u0631 \u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u2014</option>`+cur.boxes.map((b,k)=>`<option value=\"${k+1}\" ${i===k+1?\"selected\":\"\"} ${boxHidden(k)&&i!==k+1?\"hidden\":\"\"}>\u0635\u0646\u062f\u0648\u0642 ${BN(k)}${b.cashier?\" \u2014 \"+esc(b.cashier):\"\"}</option>`).join(\"\");",
"  const lines=()=>cur.returns.map((r,j)=>`<div class=\"ret-line\" data-j=\"${j}\">",
"     <div><small>\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0631\u062a\u062c\u0639</small><input class=\"inp money\" data-f=\"amount\" inputmode=\"decimal\" placeholder=\"-0.00\" value=\"${r.amount?r2(r.amount):\"\"}\"></div>",
"     <div><small>\u064a\u064f\u062e\u0635\u0645 \u0643\u0627\u0634\u0647 \u0645\u0646</small><select class=\"inp\" data-f=\"box\">${opts(r.box)}</select></div>",
"     <button class=\"x\" data-del aria-label=\"\u062d\u0630\u0641 \u0627\u0644\u0633\u0637\u0631\">\u00d7</button>",
"     <div class=\"full\"><input class=\"inp\" data-f=\"note\" placeholder=\"\u0645\u0644\u0627\u062d\u0638\u0629 (\u0631\u0642\u0645 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629 \u0645\u062b\u0644\u0627\u064b)\" value=\"${esc(r.note)}\"></div></div>`).join(\"\");",
"  const body=`<p class=\"note\">\u062a\u064f\u0633\u062c\u0651\u0644 \u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0631\u062a\u062c\u0639 \u0628\u0627\u0644\u0633\u0627\u0644\u0628\u060c \u0641\u062a\u0646\u0642\u0635 \u0645\u0646 \u0625\u062c\u0645\u0627\u0644\u064a \u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645\u060c \u0648\u064a\u0642\u0627\u0628\u0644\u0647\u0627 \u0646\u0642\u0635 \u0628\u0646\u0641\u0633 \u0627\u0644\u0642\u064a\u0645\u0629 \u0645\u0646 \u0643\u0627\u0634 \u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u0627\u0644\u0645\u062e\u062a\u0627\u0631.</p>",
"   <div id=\"rl\">${lines()}</div><button class=\"btn small\" id=\"addRet\" style=\"margin-top:10px\">+ \u0625\u0636\u0627\u0641\u0629 \u0645\u0631\u062a\u062c\u0639</button>",
"   <div class=\"calc\" style=\"margin-top:8px\"><span>\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a</span><span class=\"num neg\" id=\"rt\"></span></div><div id=\"rwarn\"></div>`;",
"  const s=sheet(\"\u0635\u0646\u062f\u0648\u0642 \u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a\",body,`<button class=\"btn\" id=\"rPrev\">\u0627\u0644\u0625\u064a\u0635\u0627\u0644</button><button class=\"btn primary\" data-close>${canEditDay()?\"\u062d\u0641\u0638\":\"\u0625\u063a\u0644\u0627\u0642\"}</button>`,afterSheet);",
"  const upd=()=>{$(\"#rt\").textContent=fmt(cur.returns.reduce((a,r)=>a+r.amount,0));",
"    $(\"#rwarn\").innerHTML=cur.returns.some(r=>r.amount&&!r.box)?`<div class=\"banner short\">\u062d\u062f\u0651\u062f \u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u0627\u0644\u0630\u064a \u064a\u064f\u062e\u0635\u0645 \u0645\u0646\u0647 \u0643\u0644 \u0645\u0631\u062a\u062c\u0639</div>`:\"\"};",
"  const bind=()=>{s.el.querySelectorAll(\".ret-line\").forEach(L=>{const r=cur.returns[+L.dataset.j];if(!canEditRet(r)){L.querySelectorAll(\"input,select\").forEach(x=>x.disabled=true);L.querySelector(\"[data-del]\").hidden=true;L.classList.add(\"locked\")}",
"    L.querySelectorAll(\"[data-f]\").forEach(inp=>inp.addEventListener(inp.tagName===\"SELECT\"?\"change\":\"input\",()=>{const f=inp.dataset.f;",
"      r[f]=f===\"amount\"?-Math.abs(calc(inp.value)):f===\"box\"?+inp.value:inp.value;markRet(r);upd()}));",
"    const a=L.querySelector('[data-f=\"amount\"]');a.addEventListener(\"blur\",()=>{a.value=r.amount?r2(r.amount):\"\"});",
"    L.querySelector(\"[data-del]\").onclick=()=>{const rr=cur.returns[+L.dataset.j];cur.returns.splice(+L.dataset.j,1);markRetDel(rr.id);if(!cur.returns.length)cur.returns.push({id:rid(),amount:0,box:0,note:\"\"});$(\"#rl\").innerHTML=lines();bind();upd()}})};",
"  $(\"#addRet\").onclick=()=>{cur.returns.push({id:rid(),amount:0,box:0,note:\"\"});$(\"#rl\").innerHTML=lines();bind();upd()};",
"  $(\"#rPrev\").onclick=()=>preview(\"\u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a\",rcptReturns(cur),`\u0645\u0631\u062a\u062c\u0639\u0627\u062a-${cur.date}.pdf`);",
"  bind();upd();if(!canEditDay())$(\"#addRet\").hidden=true;",
"}",
