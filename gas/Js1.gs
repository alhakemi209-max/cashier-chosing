"     <tfoot><tr><td>\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</td><td class=\"n num\">${T.days}</td><td class=\"n num\">${fmt(T.cashNet)}</td><td class=\"n num\">${fmt(T.net)}</td><td class=\"n num\">${fmt(T.cashNet+T.net)}</td><td class=\"n num\">${fmt(T.ret)}</td><td class=\"n num\">${fmt(T.reportNet)}</td><td class=\"n num\">${fmtS(T.diff)}</td></tr></tfoot></table>`",
"   :`<table><thead><tr><th>\u0627\u0644\u062a\u0627\u0631\u064a\u062e</th><th>\u0627\u0644\u064a\u0648\u0645</th><th class=\"n\">\u0635\u0627\u0641\u064a \u0627\u0644\u0643\u0627\u0634</th><th class=\"n\">\u0627\u0644\u0634\u0628\u0643\u0627\u062a</th><th class=\"n\">\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</th><th class=\"n\">\u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a</th><th class=\"n\">\u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645</th><th class=\"n\">\u0627\u0644\u0641\u0631\u0642</th></tr></thead><tbody>",
"     ${A.rows.map(r=>`<tr class=\"click\" data-date=\"${r.date}\"><td class=\"num\">${dmy(r.date)}</td><td>${dayName(r.date)}</td><td class=\"n num\">${fmt(r.cashNet)}</td><td class=\"n num\">${fmt(r.net)}</td><td class=\"n num\">${fmt(r.cashNet+r.net)}</td><td class=\"n num\">${fmt(r.ret)}</td><td class=\"n num\">${fmt(r.reportNet)}</td><td class=\"n num ${cls(r.diff)}\">${fmtS(r.diff)}</td></tr>`).join(\"\")}</tbody>",
"     <tfoot><tr><td colspan=\"2\">\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</td><td class=\"n num\">${fmt(T.cashNet)}</td><td class=\"n num\">${fmt(T.net)}</td><td class=\"n num\">${fmt(T.cashNet+T.net)}</td><td class=\"n num\">${fmt(T.ret)}</td><td class=\"n num\">${fmt(T.reportNet)}</td><td class=\"n num\">${fmtS(T.diff)}</td></tr></tfoot></table>`;",
"  const chart=byMonth?A.months.map(m=>({v:m.reportNet,l:MONTHS[+m.key.slice(5)-1],s:String(+m.key.slice(5))})):A.rows.map(r=>({v:r.reportNet,l:dmy(r.date),s:String(+r.date.slice(8))}));",
"  const netTotal=T.net||1;",
"  $(\"#view\").innerHTML=`${periodCtrl(rep)}",
"  ${list.length?`",
"  <div class=\"strip\">",
"   <div class=\"stat\"><span>\u0635\u0627\u0641\u064a \u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645</span><b class=\"num\">${fmt(T.reportNet)}</b></div>",
"   <div class=\"stat\"><span>\u0623\u064a\u0627\u0645 \u0645\u0633\u062c\u0651\u0644\u0629</span><b class=\"num\">${T.days}</b></div>",
"   <div class=\"stat\"><span>\u0635\u0627\u0641\u064a \u0627\u0644\u0643\u0627\u0634</span><b class=\"num\">${fmt(T.cashNet)}</b></div>",
"   <div class=\"stat\"><span>\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0634\u0628\u0643\u0627\u062a</span><b class=\"num\">${fmt(T.net)}</b></div>",
"   <div class=\"stat\"><span>\u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a</span><b class=\"num\">${fmt(T.ret)}</b></div>",
"   <div class=\"stat\"><span>\u0645\u062a\u0648\u0633\u0637 \u0645\u0628\u064a\u0639\u0627\u062a \u0627\u0644\u064a\u0648\u0645</span><b class=\"num\">${fmt(T.reportNet/(T.days||1))}</b></div>",
"   <div class=\"stat short\"><span>\u0645\u062c\u0645\u0648\u0639 \u0627\u0644\u0639\u062c\u0632</span><b class=\"num\">${fmt(T.short)}</b></div>",
"   <div class=\"stat over\"><span>\u0645\u062c\u0645\u0648\u0639 \u0627\u0644\u0632\u064a\u0627\u062f\u0629</span><b class=\"num\">${fmt(T.over)}</b></div>",
"   <div class=\"stat wide ${statusOf(T.diff)[0]}\"><span>\u0635\u0627\u0641\u064a \u0627\u0644\u0632\u064a\u0627\u062f\u0629 / \u0627\u0644\u0646\u0642\u0635</span><b class=\"num\">${fmtS(T.diff)}</b></div></div>",
"  <div class=\"row-btns\"><button class=\"btn primary\" id=\"repSum\">\u062a\u0642\u0631\u064a\u0631 \u0645\u0644\u062e\u0635</button><button class=\"btn primary\" id=\"repAna\">\u062a\u0642\u0631\u064a\u0631 \u062a\u062d\u0644\u064a\u0644\u064a</button></div><button class=\"btn block\" id=\"repCsv\">\u062a\u0635\u062f\u064a\u0631 Excel</button>",
"  <div class=\"card\"><h2 style=\"margin-bottom:8px\">\u0635\u0627\u0641\u064a \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a ${byMonth?\"\u062d\u0633\u0628 \u0627\u0644\u0634\u0647\u0631\":\"\u062d\u0633\u0628 \u0627\u0644\u064a\u0648\u0645\"}</h2>${barsSVG(chart)}</div>",
"  <h2>${byMonth?\"\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0634\u0647\u0631\u064a\":\"\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u064a\u0648\u0645\u064a\"}</h2><div class=\"tbl-wrap\">${tbl}</div>",
"  <div class=\"sec-h\"><h2>\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0643\u0627\u0634\u064a\u0631\u0627\u062a</h2><span class=\"note\">\u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u0627\u0644\u0627\u0633\u0645 \u0644\u0637\u0628\u0627\u0639\u0629 \u0643\u0634\u0641 \u0627\u0644\u0639\u062c\u0632 \u0644\u0644\u062a\u0648\u0642\u064a\u0639</span></div>",
"  <div class=\"tbl-wrap\"><table><thead><tr><th>\u0627\u0644\u0643\u0627\u0634\u064a\u0631</th><th class=\"n\">\u0625\u0642\u0641\u0627\u0644\u0627\u062a</th><th class=\"n\">\u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a</th><th class=\"n\">\u0627\u0644\u0643\u0627\u0634</th><th class=\"n\">\u0627\u0644\u0634\u0628\u0643\u0627\u062a</th><th class=\"n\">\u0627\u0644\u0639\u062c\u0632</th><th class=\"n\">\u0627\u0644\u0632\u064a\u0627\u062f\u0629</th><th class=\"n\">\u0627\u0644\u0635\u0627\u0641\u064a</th></tr></thead><tbody>",
"   ${A.people.map(p=>`<tr class=\"click\" data-person=\"${esc(p.name)}\"><td>${esc(p.name)}</td><td class=\"n num\">${p.n}</td><td class=\"n num\">${fmt(p.sales)}</td><td class=\"n num\">${fmt(p.cash)}</td><td class=\"n num\">${fmt(p.net)}</td><td class=\"n num neg\">${fmt(p.short)}</td><td class=\"n num pos\">${fmt(p.over)}</td><td class=\"n num ${cls(p.diff)}\">${fmtS(p.diff)}</td></tr>`).join(\"\")}</tbody></table></div>",
"  <div class=\"card\"><h2 style=\"margin-bottom:10px\">\u062a\u0648\u0632\u064a\u0639 \u0627\u0644\u0634\u0628\u0643\u0627\u062a</h2><div class=\"mix\">${NV().map(([k,l])=>`<div class=\"r\"><span>${l}</span><span class=\"t\"><i style=\"width:${Math.max(0,T.nets[k]/netTotal*100).toFixed(1)}%\"></i></span><span class=\"num\" style=\"text-align:left\">${fmt(T.nets[k])}</span></div>`).join(\"\")}</div>",
"   <p class=\"note\" style=\"margin:10px 0 0\">\u0646\u0633\u0628\u0629 \u0627\u0644\u0634\u0628\u0643\u0627\u062a \u0645\u0646 \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a: <b class=\"num\">${T.total?((T.net/T.total)*100).toFixed(1):\"0.0\"}%</b> \u2014 \u0646\u0633\u0628\u0629 \u0627\u0644\u0643\u0627\u0634: <b class=\"num\">${T.total?((T.cashNet/T.total)*100).toFixed(1):\"0.0\"}%</b></p></div>`",
"  :`<div class=\"card empty\">\u0644\u0627 \u062a\u0648\u062c\u062f \u0623\u064a\u0627\u0645 \u0645\u062d\u0641\u0648\u0638\u0629 \u0641\u064a ${label}.<br>\u0628\u0639\u062f \u0625\u062f\u062e\u0627\u0644 \u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642 \u0627\u0636\u063a\u0637 \u00ab\u062d\u0641\u0638 \u0627\u0644\u064a\u0648\u0645\u00bb \u0644\u062a\u0638\u0647\u0631 \u0647\u0646\u0627.</div>`}`;",
"  bindPeriod(rep,renderReports);",
