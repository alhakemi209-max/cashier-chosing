"/* ---------- reports tab ---------- */",
"/* ---------- periods ---------- */",
"const PMODES=[[\"day\",\"\u064a\u0648\u0645\u064a\"],[\"week\",\"\u0623\u0633\u0628\u0648\u0639\u064a\"],[\"month\",\"\u0634\u0647\u0631\u064a\"],[\"year\",\"\u0633\u0646\u0648\u064a\"],[\"range\",\"\u0641\u062a\u0631\u0629\"]];",
"const weekStart=iso=>{const d=new Date(iso+\"T12:00:00\").getDay();return addDays(iso,-((d-6+7)%7))};",
"function periodRange(P){",
"  if(effectiveRole()===\"mgr\"&&!mgrModes().includes(P.mode))P.mode=mgrModes().includes(\"week\")?\"week\":\"day\";",
"  if(P.mode===\"day\")return[P.day,P.day,\"\u064a\u0648\u0645 \"+dayName(P.day)+\" \"+dmy(P.day)];",
"  if(P.mode===\"week\"){const s=weekStart(P.week),e=addDays(s,6);return[s,e,\"\u0627\u0644\u0623\u0633\u0628\u0648\u0639 \u0645\u0646 \"+dmy(s)+\" \u0625\u0644\u0649 \"+dmy(e)]}",
"  if(P.mode===\"month\"){const [y,m]=P.month.split(\"-\");return[P.month+\"-01\",P.month+\"-31\",\"\u0634\u0647\u0631 \"+MONTHS[+m-1]+\" \"+y]}",
"  if(P.mode===\"year\")return[P.year+\"-01-01\",P.year+\"-12-31\",\"\u0633\u0646\u0629 \"+P.year];",
"  const f=P.from<=P.to?P.from:P.to,t=P.from<=P.to?P.to:P.from;return[f,t,\"\u0645\u0646 \"+dmy(f)+\" \u0625\u0644\u0649 \"+dmy(t)];",
"}",
"function periodDays(P){const [f,t]=periodRange(P);return[...days.values()].map(normDay).filter(d=>d.date>=f&&d.date<=t).sort((a,b)=>a.date<b.date?-1:1)}",
"function periodCtrl(P){",
"  const years=[...new Set([...days.keys()].map(d=>d.slice(0,4)).concat([todayISO().slice(0,4)]))].sort().reverse();",
"  const c=P.mode===\"day\"?`<input type=\"date\" class=\"inp\" data-p=\"day\" value=\"${P.day}\" aria-label=\"\u0627\u0644\u064a\u0648\u0645\">`",
"   :P.mode===\"week\"?`<input type=\"date\" class=\"inp\" data-p=\"week\" value=\"${P.week}\" aria-label=\"\u0623\u064a \u064a\u0648\u0645 \u0641\u064a \u0627\u0644\u0623\u0633\u0628\u0648\u0639\">`",
"   :P.mode===\"month\"?`<input type=\"month\" class=\"inp\" data-p=\"month\" value=\"${P.month}\" aria-label=\"\u0627\u0644\u0634\u0647\u0631\">`",
"   :P.mode===\"year\"?`<select class=\"inp\" data-p=\"year\" aria-label=\"\u0627\u0644\u0633\u0646\u0629\">${years.map(y=>`<option ${y===P.year?\"selected\":\"\"}>${y}</option>`).join(\"\")}</select>`",
"   :`<input type=\"date\" class=\"inp\" data-p=\"from\" value=\"${P.from}\" aria-label=\"\u0645\u0646\"><input type=\"date\" class=\"inp\" data-p=\"to\" value=\"${P.to}\" aria-label=\"\u0625\u0644\u0649\">`;",
"  return`<div class=\"seg\" role=\"group\" aria-label=\"\u0646\u0648\u0639 \u0627\u0644\u0641\u062a\u0631\u0629\">${PMODES.filter(([k])=>effectiveRole()!==\"mgr\"||mgrModes().includes(k)).map(([k,l])=>`<button data-mode=\"${k}\" aria-pressed=\"${P.mode===k}\">${l}</button>`).join(\"\")}</div>",
"  <div class=\"period\">${c}</div><p class=\"note\" style=\"margin:-4px 0 0\">${periodRange(P)[2]}${P.mode===\"week\"?\" (\u0627\u0644\u0633\u0628\u062a \u0625\u0644\u0649 \u0627\u0644\u062c\u0645\u0639\u0629)\":\"\"}</p>`;",
"}",
"function bindPeriod(P,re){",
"  $(\"#view\").querySelectorAll(\"[data-mode]\").forEach(b=>b.onclick=()=>{P.mode=b.dataset.mode;re()});",
"  $(\"#view\").querySelectorAll(\"[data-p]\").forEach(e=>e.onchange=()=>{if(e.value){P[e.dataset.p]=e.value;re()}});",
"}",
"function aggregate(list){",
"  const T={cash:0,net:0,report:0,ret:0,cashNet:0,reportNet:0,total:0,diff:0,short:0,over:0,nets:{},days:list.length};NETS.forEach(([k])=>T.nets[k]=0);",
"  const rows=[],months={},people={};",
"  list.forEach(d=>{const t=dayCalc(d);rows.push({date:d.date,...t});",
"    [\"cash\",\"net\",\"report\",\"ret\",\"cashNet\",\"reportNet\",\"total\",\"diff\"].forEach(k=>T[k]+=t[k]);NETS.forEach(([k])=>T.nets[k]+=t.nets[k]);",
"    const mk=d.date.slice(0,7);const M=months[mk]||(months[mk]={key:mk,days:0,cashNet:0,net:0,reportNet:0,ret:0,diff:0});M.days++;[\"cashNet\",\"net\",\"reportNet\",\"ret\",\"diff\"].forEach(k=>M[k]+=t[k]);",
"    d.boxes.forEach(b=>{if(!hasData(b))return;const c=boxCalc(b);const key=(b.cashier||\"\u0628\u062f\u0648\u0646 \u0627\u0633\u0645\").trim();",
"      const P=people[key]||(people[key]={name:key,n:0,sales:0,cash:0,net:0,short:0,over:0,diff:0});P.n++;P.sales+=+b.report||0;P.cash+=+b.cash||0;P.net+=c.net;P.diff+=c.diff;",
"      if(c.diff<0){P.short+=c.diff;T.short+=c.diff}else if(c.diff>0){P.over+=c.diff;T.over+=c.diff}})});",
"  return{T,rows,months:Object.values(months).sort((a,b)=>a.key<b.key?-1:1),people:Object.values(people).sort((a,b)=>b.sales-a.sales)};",
"}",
"function barsSVG(items){",
"  if(!items.length)return\"\";const W=600,H=180,pl=6,pr=6,pt=12,pb=22;const max=Math.max(...items.map(i=>i.v),1);",
"  const bw=Math.min(48,(W-pl-pr)/items.length);const ticks=[0,.5,1].map(f=>max*f);",
"  return`<svg class=\"bars\" viewBox=\"0 0 ${W} ${H}\" role=\"img\" aria-label=\"\u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a \u062d\u0633\u0628 \u0627\u0644\u0641\u062a\u0631\u0629\">${ticks.map(v=>{const y=pt+(H-pt-pb)*(1-v/max);return`<line class=\"g\" x1=\"${pl}\" x2=\"${W-pr}\" y1=\"${y}\" y2=\"${y}\"/>`}).join(\"\")}",
"  ${items.map((it,i)=>{const h=(H-pt-pb)*(Math.max(it.v,0)/max);const x=W-pr-(i+1)*bw+bw*.15;const y=H-pb-h;return`<rect class=\"b\" x=\"${x}\" y=\"${y}\" width=\"${bw*.7}\" height=\"${h}\" rx=\"2\"><title>${esc(it.l)}: ${fmt(it.v)}</title></rect>${(items.length<=16||i%Math.ceil(items.length/16)===0)?`<text x=\"${x+bw*.35}\" y=\"${H-8}\" text-anchor=\"middle\">${esc(it.s)}</text>`:\"\"}`}).join(\"\")}${ticks.map(v=>{const y=pt+(H-pt-pb)*(1-v/max);return`<text class=\"tk\" x=\"${W-pr}\" y=\"${y-3}\" text-anchor=\"end\">${Math.round(v).toLocaleString(\"en-US\")}</text>`}).join(\"\")}</svg>`;",
"}",
