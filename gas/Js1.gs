"function cacheSave(){if(me)ls.set(\"ccd-cache\",{rev:lastRev,days:[...days.values()],settings,user:me,today:TODAY,sheetUrl,br:BRC,branches:BRANCHES,allBranches:ALLBR})}",
"function layerOpen(){return!!$(\"#layer\").firstChild}",
"function mergeCur(){savePend();loadDate(cur.date)}",
"",
"/* pending edits: kept on the device until the server confirms them */",
"function pendDates(){const out=new Set();if(cur&&hasPend())out.add(cur.date);",
"  try{for(let k=0;k<localStorage.length;k++){const key=localStorage.key(k);if(key&&key.indexOf(\"ccd-pend-\")===0)out.add(key.slice(9))}}catch(e){}",
"  return[...out]}",
"const pendEmpty=P=>!Object.keys(P.b).length&&!Object.keys(P.ru).length&&!P.rd.length;",
"async function flush(){",
"  if(flushing||!me)return;flushing=true;",
"  try{for(const d of pendDates())await flushDate(d)}finally{flushing=false}",
"  renderTop();",
"}",
"async function flushDate(date){",
"  const isCur=cur&&date===cur.date;const P=isCur?cur.pend:(ls.get(\"ccd-pend-\"+date)||emptyPend());",
"  if(pendEmpty(P)){if(!isCur)ls.del(\"ccd-pend-\"+date);return}",
"  const sent=JSON.parse(JSON.stringify(P));syncState=\"saving\";renderTop();",
"  try{",
"    const doc=await api(\"saveDay\",{date,boxes:sent.b,retUpsert:Object.values(sent.ru),retDelete:sent.rd});",
"    days.set(doc.date,doc);",
"    const Q=(cur&&date===cur.date)?cur.pend:P;",
"    Object.keys(sent.b).forEach(i=>{if(JSON.stringify(Q.b[i])===JSON.stringify(sent.b[i]))delete Q.b[i]});",
"    Object.keys(sent.ru).forEach(id=>{if(JSON.stringify(Q.ru[id])===JSON.stringify(sent.ru[id]))delete Q.ru[id]});",
"    Q.rd=Q.rd.filter(id=>sent.rd.indexOf(id)<0);",
"    if(cur&&date===cur.date){if(layerOpen()){savePend();needMerge=true}else mergeCur()}",
"    else{pendEmpty(Q)?ls.del(\"ccd-pend-\"+date):ls.set(\"ccd-pend-\"+date,Q)}",
"    syncState=\"ok\";cacheSave();",
"    if(doc.kept)toast(\"\u0628\u0639\u0636 \u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642 \u0645\u0642\u0641\u0644\u0629 \u0648\u0644\u0645 \u062a\u064f\u0639\u062f\u064e\u0651\u0644\");",
"    if(!layerOpen()&&tab!==\"settings\"&&!busyInput())render();",
"  }catch(e){",
"    if(e.net){syncState=\"error\";return}",
"    syncState=\"ok\";toast(e.msg||\"\u062a\u0639\u0630\u0651\u0631 \u0627\u0644\u062d\u0641\u0638\");",
"    if(cur&&date===cur.date){cur.pend=emptyPend();savePend();if(!layerOpen())loadDate(date)}else ls.del(\"ccd-pend-\"+date);",
"    if(!layerOpen())render();",
"  }",
"}",
"function busyInput(){const a=document.activeElement;return a&&a.closest&&a.closest(\"#view\")&&/INPUT|SELECT|TEXTAREA/.test(a.tagName)}",
"async function poll(){",
"  clearTimeout(pollT);if(!me)return;",
"  if(document.visibilityState===\"visible\"){",
"    try{const r=await api(\"poll\",{since:lastRev});lastOk=Date.now();",
"      if(r.now)clockSkew=Date.parse(r.now)-Date.now();",
"      if(r.today)TODAY=r.today;",
"      if(r.user&&me&&(r.user.role!==me.role||JSON.stringify(r.user.perms||{})!==JSON.stringify(me.perms||{}))){me=r.user;applyMe();if(!layerOpen())render()}",
"      if(r.rev>lastRev)applyRemote(r);",
"      else if(needMerge&&!layerOpen()){needMerge=false;mergeCur();if(tab!==\"settings\")render()}",
"    }catch(e){}",
"    if(pendDates().length&&!layerOpen())flush();",
"    renderTop();",
"  }",
"  if(me)pollT=setTimeout(poll,POLL_MS);",
"}",
"function applyRemote(r){",
"  lastRev=r.rev;if(r.settings){const lv=settings.logoV,wv=settings.wmV;settings=Object.assign(settings,r.settings);syncBoxes();if((settings.logoV||\"\")!==(lv||\"\"))loadLogo(settings.logoV||\"\");if((settings.wmV||\"\")!==(wv||\"\"))loadWm(settings.wmV||\"\");paintLogo()}if(r.sent){noticeNewSent(r.sent);sentLog=r.sent}",
"  noticeNewRq(r);(r.deleted||[]).forEach(d=>days.delete(d));(r.days||[]).forEach(d=>days.set(d.date,d));",
"  cacheSave();",
"  const touched=(r.days||[]).some(d=>d.date===cur.date)||(r.deleted||[]).indexOf(cur.date)>=0;",
"  if(layerOpen()){if(touched)needMerge=true;renderTop();return}",
"  if(touched||needMerge){needMerge=false;mergeCur()}",
"  if(tab===\"settings\"||busyInput()){renderTop();return}",
"  const y=window.scrollY;render();window.scrollTo(0,y);",
"}",
"async function deleteDay(date){",
"  try{await api(\"deleteDay\",{date});days.delete(date);ls.del(\"ccd-pend-\"+date);loadDate(date);cacheSave();render();toast(\"\u062a\u0645 \u062d\u0630\u0641 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u064a\u0648\u0645\")}",
"  catch(e){toast(e.msg||\"\u062a\u0639\u0630\u0651\u0631 \u0627\u0644\u062d\u0630\u0641\")}",
"}",
"async function saveSettings(){",
"  try{settings=Object.assign(settings,await api(\"saveSettings\",settings));syncBoxes();cacheSave();toast(\"\u062a\u0645 \u062d\u0641\u0638 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a\");renderNav();renderTop();return true}",
"  catch(e){toast(e.msg||\"\u062a\u0639\u0630\u0651\u0631 \u062d\u0641\u0638 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a\");return false}",
"}",
"function afterSheet(){if(needMerge){needMerge=false;mergeCur()}render();flush()}",
"/* ---------- UI helpers ---------- */",
"let toastT;function toast(m){let t=$(\".toast\");if(!t){t=document.createElement(\"div\");t.className=\"toast\";t.setAttribute(\"role\",\"status\");document.body.appendChild(t)}t.textContent=m;t.hidden=false;clearTimeout(toastT);toastT=setTimeout(()=>t.hidden=true,2600)}",
"function sheet(title,body,foot,onClose){",
"  const L=$(\"#layer\");L.innerHTML=`<div class=\"sheet-bg\"><div class=\"sheet\" role=\"dialog\" aria-modal=\"true\"><div class=\"sheet-h\"><h2>${title}</h2><button class=\"x\" data-close aria-label=\"\u0625\u063a\u0644\u0627\u0642\">\u00d7</button></div><div class=\"sheet-b\">${body}</div>${foot?`<div class=\"sheet-f\">${foot}</div>`:\"\"}</div></div>`;",
"  const bg=L.firstChild;const close=()=>{L.innerHTML=\"\";onClose&&onClose()};",
"  bg.addEventListener(\"click\",e=>{if(e.target===bg||e.target.closest(\"[data-close]\"))close()});",
"  return{el:bg,close};",
"}",
"function ask(msg,btns){return new Promise(res=>{const s=sheet(\"\u062a\u0623\u0643\u064a\u062f\",`<p style=\"margin:10px 0\">${msg}</p>`,btns.map((b,i)=>`<button class=\"btn ${b.cls||\"\"}\" data-i=\"${i}\">${b.t}</button>`).join(\"\"),()=>res(null));",
"  s.el.querySelectorAll(\"[data-i]\").forEach(x=>x.onclick=()=>{$(\"#layer\").innerHTML=\"\";res(btns[+x.dataset.i].v)})})}",
"",
"/* ---------- roles & permissions ---------- */",
"function effectiveRole(){return ready&&me?me.role:null}",
"const PERM_DEF={acc:{tabs:[\"boxes\",\"summary\",\"reports\",\"commission\",\"att\",\"log\",\"cashbox\",\"petty\",\"branches\",\"settings\"],xlsx:true,wa:false,days:0},own:{tabs:[\"branches\",\"summary\",\"reports\",\"sales\",\"short\"],xlsx:true,wa:false,days:0},mgr:{tabs:[\"short\",\"sales\"],xlsx:false,wa:false,days:7},sup:{tabs:[\"boxes\",\"summary\"],xlsx:true,wa:false,days:7},lead:{tabs:[\"cash\",\"short\"],xlsx:false,wa:true,days:7}};",
"const PERM_ALLOWED={acc:PERM_DEF.acc.tabs,own:[\"branches\",\"summary\",\"reports\",\"sales\",\"short\",\"boxes\",\"commission\",\"att\",\"log\",\"cashbox\",\"petty\"],mgr:[\"short\",\"sales\",\"boxes\",\"summary\",\"reports\",\"commission\",\"att\",\"log\",\"cashbox\",\"petty\"],sup:[\"boxes\",\"summary\",\"short\"],lead:[\"cash\",\"short\"]};",
"function myPerms(){const r=me&&me.role;if(!r||!PERM_DEF[r])return{tabs:[]};return Object.assign({},PERM_DEF[r],r===\"acc\"?{}:(me.perms||{}))}",
"/* screens can be switched off in settings, and the branches report only shows when there is more than one branch */",
"const modOn=k=>k==='cashbox'?settings.modCashbox!==false:k==='petty'?!!settings.modPetty:k==='branches'?(ALLBR||BRANCHES||[]).length>1:true;",
"function myTabs(){const r=me&&me.role;if(!r||!PERM_DEF[r])return[];const p=myPerms();let t=PERM_ALLOWED[r].filter(k=>(p.tabs||[]).indexOf(k)>=0);if(!t.length)t=PERM_DEF[r].tabs.slice();const v=t.filter(modOn);return[\"home\"].concat(v.length?v:t.slice(0,1))}",
"function can(k){return !!myPerms()[k]}",
"function mgrModes(){const d=myPerms().days||7;return d>=60?[\"day\",\"week\",\"month\",\"range\"]:d>=30?[\"day\",\"week\",\"month\"]:d>=7?[\"day\",\"week\"]:[\"day\"]}",
"const dateTabs=()=>myTabs().some(k=>[\"boxes\",\"summary\",\"reports\",\"commission\",\"att\",\"log\"].indexOf(k)>=0);",
"function applyMe(){const p=myPerms();if(p.days)LEADD=p.days;document.body.classList.toggle(\"no-xlsx\",!p.xlsx)}",
"const isFuture=d=>d>todayISO(),futureOk=d=>!isFuture(d)||!!settings.allowFuture;",
"function allowedDate(d){const r=effectiveRole();if(r===\"acc\"&&!futureOk(d))return false;if(r===\"mgr\"){const t=todayISO();return d<=t&&d>addDays(t,-(myPerms().days||7))}if(r!==\"sup\")return true;const t=todayISO();return d===t||(settings.supPrev&&d===addDays(t,-1))}",
"const nowMs=()=>Date.now()+clockSkew;",
"const lockMs=()=>(+settings.supHours||12)*3600e3;",
"function periodOpen(d){return d>=addDays(todayISO(),-ACCD)&&futureOk(d)}",
"function canEditDay(){const r=effectiveRole();return(r===\"acc\"&&periodOpen(cur.date))||(r===\"sup\"&&allowedDate(cur.date))}",
"function stampOpen(f){return !f||nowMs()-Date.parse(f)<lockMs()}",
"function canEditBox(i){const r=effectiveRole();if(r===\"acc\")return periodOpen(cur.date);if(r!==\"sup\"||!allowedDate(cur.date))return false;return stampOpen(cur.boxes[i].firstAt)}",
"function canEditRet(x){const r=effectiveRole();if(r===\"acc\")return periodOpen(cur.date);if(r!==\"sup\"||!allowedDate(cur.date))return false;return stampOpen(x.firstAt)}",
"function leftText(f){if(!f)return\"\";const m=Math.max(0,Math.round((lockMs()-(nowMs()-Date.parse(f)))/60000));return m>=60?Math.floor(m/60)+\" \u0633 \"+(m%60)+\" \u062f\":m+\" \u062f\"}",
"function renderNav(){",
"  const r=effectiveRole();const w=$(\"#tabsWrap\");$(\"#tabsNav\").hidden=!r;",
"  if(!r){w.innerHTML=\"\";return}",
