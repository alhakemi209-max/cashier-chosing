"  if(effectiveRole()===\"acc\"&&isFuture(date)){",
"    if(!settings.allowFuture){$(\"#datePick\").value=cur.date;toast(\"\u0645\u0627 \u064a\u0645\u0643\u0646 \u0627\u0644\u0625\u062f\u062e\u0627\u0644 \u0628\u062a\u0627\u0631\u064a\u062e \u0644\u0627\u062d\u0642 \u0644\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u064a\u0648\u0645. \u062a\u0642\u062f\u0631 \u062a\u0633\u0645\u062d \u0628\u0630\u0644\u0643 \u0645\u0646 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u2190 \u0642\u0648\u0627\u0639\u062f \u0627\u0644\u062a\u0634\u063a\u064a\u0644\");return}",
"    const v=await ask(`\u062a\u0627\u0631\u064a\u062e ${dayName(date)} <span class=\"num\">${dmy(date)}</span> \u0644\u0627\u062d\u0642 \u0644\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u064a\u0648\u0645. \u0645\u062a\u0623\u0643\u062f \u062a\u0628\u064a \u062a\u062f\u062e\u0644 \u0628\u064a\u0627\u0646\u0627\u062a \u0639\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u061f`,[{t:\"\u0646\u0639\u0645\u060c \u0645\u062a\u0627\u0628\u0639\u0629\",v:1,cls:\"primary\"},{t:\"\u0625\u0644\u063a\u0627\u0621\",v:0}]);",
"    if(!v){$(\"#datePick\").value=cur.date;return}}",
"  if(!allowedDate(date)){$(\"#datePick\").value=cur.date;toast(effectiveRole()===\"mgr\"?`\u0645\u062a\u0627\u062d \u0644\u0643 \u0622\u062e\u0631 ${myPerms().days||7} \u0623\u064a\u0627\u0645 \u0641\u0642\u0637`:\"\u0645\u0633\u0624\u0648\u0644 \u0627\u0644\u0643\u0627\u0634\u064a\u0631\u0627\u062a \u064a\u0639\u0645\u0644 \u0639\u0644\u0649 \u064a\u0648\u0645 \u0627\u0644\u064a\u0648\u0645 \u0641\u0642\u0637\");return}",
