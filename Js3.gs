"  if(effectiveRole()===\"acc\")return{hide:settings.comHide||[],boxes:settings.comBoxes||[]};",
"  const v=ls.get(\"ccd-comview\");return{hide:(v&&v.hide)||[],boxes:(v&&v.boxes)||[]};",
"}",
"function comKeep(b,i){const V=comView();if(V.boxes.length&&V.boxes.indexOf(BN(i))<0)return false;return V.hide.indexOf((b.cashier||\"\u0628\u062f\u0648\u0646 \u0627\u0633\u0645\").trim())<0}",
"function comNames(list){const s=new Set();list.forEach(d=>d.boxes.forEach(b=>{if(hasData(b))s.add((b.cashier||\"\u0628\u062f\u0648\u0646 \u0627\u0633\u0645\").trim())}));return[...s]}",
"function comBar(list){",
"  const V=comView(),on=V.hide.length||V.boxes.length,all=comNames(list),shown=all.filter(n=>V.hide.indexOf(n)<0).length;",
"  return`<div class=\"info lgbar\"><span>${on?`\u0627\u0644\u062a\u0642\u0631\u064a\u0631 \u0645\u062e\u0635\u0635: \u0645\u0639\u0631\u0648\u0636 <b class=\"num\">${shown}</b> \u0645\u0646 <b class=\"num\">${all.length}</b> \u0643\u0627\u0634\u064a\u0631${V.boxes.length?` \u2014 \u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642: <span class=\"num\">${V.boxes.join(\"\u060c \")}</span>`:\"\"}`:`\u0645\u0639\u0631\u0648\u0636 \u0643\u0644 \u0627\u0644\u0643\u0627\u0634\u064a\u0631\u0627\u062a \u0648\u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642`}</span>",
"   <span style=\"display:flex;gap:6px\">${on?`<button class=\"btn small\" id=\"comAll\">\u0625\u0638\u0647\u0627\u0631 \u0627\u0644\u0643\u0644</button>`:\"\"}<button class=\"btn small\" id=\"comView\">\u062a\u062e\u0635\u064a\u0635</button></span></div>`;",
"}",
"async function comViewSave(v){",
"  if(effectiveRole()===\"acc\"){settings.comHide=v.hide;settings.comBoxes=v.boxes;await saveSettings()}else ls.set(\"ccd-comview\",v);",
"  if(!layerOpen())renderCommission();",
"}",
"function comBind(list){const b=$(\"#comView\");if(b)b.onclick=()=>viewEditor(\"\u062a\u062e\u0635\u064a\u0635 \u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0646\u0633\u0628\u0629\",comNames(list),comView(),comViewSave);const a=$(\"#comAll\");if(a)a.onclick=()=>comViewSave({hide:[],boxes:[]})}",
"function viewEditor(title,names0,V,onSave){",
"  const names=[...new Set(names0.concat(V.hide))].sort((a,b)=>a.localeCompare(b,\"ar\"));",
"  const boxes=Array.from({length:BOXES},(_,i)=>i).filter(i=>!boxHidden(i)).map(BN);",
"  const s=sheet(title,`<p class=\"note\" style=\"margin:8px 0\">\u0627\u062e\u062a\u0631 \u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642 \u0627\u0644\u0644\u064a \u062a\u0628\u063a\u0627\u0647\u0627 \u0641\u064a \u0627\u0644\u062a\u0642\u0631\u064a\u0631\u060c \u0648\u0634\u064a\u0644 \u0627\u0644\u0635\u062d \u0639\u0646 \u0623\u064a \u0643\u0627\u0634\u064a\u0631 \u062a\u0628\u063a\u0649 \u062a\u062e\u0641\u064a\u0647.</p>",
"   <div class=\"sec-h\"><b>\u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642</b><span class=\"note\">\u0628\u062f\u0648\u0646 \u0627\u062e\u062a\u064a\u0627\u0631 = \u0643\u0644 \u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642</span></div>",
"   <div class=\"bxpick\">${boxes.map(b=>`<label class=\"chip\"><input type=\"checkbox\" data-vb=\"${b}\" ${V.boxes.indexOf(b)>=0?\"checked\":\"\"}><span class=\"num\">${b}</span></label>`).join(\"\")}</div>",
"   <div class=\"sec-h\" style=\"margin-top:12px\"><b>\u0627\u0644\u0643\u0627\u0634\u064a\u0631\u0627\u062a</b><span style=\"display:flex;gap:6px\"><button class=\"btn small\" id=\"vAllOn\" type=\"button\">\u0627\u0644\u0643\u0644</button><button class=\"btn small\" id=\"vAllOff\" type=\"button\">\u0644\u0627 \u0623\u062d\u062f</button></span></div>",
"   <input class=\"inp\" id=\"vFind\" placeholder=\"\u0628\u062d\u062b \u0628\u0627\u0644\u0627\u0633\u0645\" style=\"margin-bottom:8px\">",
"   <div class=\"ulist\">${names.map(n=>`<label class=\"chk vrow\"><input type=\"checkbox\" data-vn=\"${esc(n)}\" ${V.hide.indexOf(n)<0?\"checked\":\"\"}>${esc(n)}</label>`).join(\"\")||'<p class=\"note\">\u0644\u0627 \u062a\u0648\u062c\u062f \u0623\u0633\u0645\u0627\u0621 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0641\u062a\u0631\u0629.</p>'}</div>`,",
"   `<button class=\"btn primary\" id=\"vSave\">\u062d\u0641\u0638</button><button class=\"btn\" data-close>\u0625\u0644\u063a\u0627\u0621</button>`);",
"  $(\"#vFind\").oninput=e=>{const q=e.target.value.trim();s.el.querySelectorAll(\".vrow\").forEach(r=>r.hidden=q&&r.textContent.indexOf(q)<0)};",
"  $(\"#vAllOn\").onclick=()=>s.el.querySelectorAll(\"[data-vn]\").forEach(x=>{if(!x.closest(\".vrow\").hidden)x.checked=true});",
"  $(\"#vAllOff\").onclick=()=>s.el.querySelectorAll(\"[data-vn]\").forEach(x=>{if(!x.closest(\".vrow\").hidden)x.checked=false});",
"  $(\"#vSave\").onclick=async()=>{const v={hide:[...s.el.querySelectorAll(\"[data-vn]\")].filter(x=>!x.checked).map(x=>x.dataset.vn),boxes:[...s.el.querySelectorAll(\"[data-vb]\")].filter(x=>x.checked).map(x=>+x.dataset.vb)};s.close();await onSave(v)};",
"}",
"/* ---------- monthly shortage statement (for signature) ---------- */",
"function stmtFor(name,list,label){preview(\"\u0643\u0634\u0641 \u0627\u0644\u0639\u062c\u0632 \u2014 \"+name,rcptStmt(name,list,label),`\u0643\u0634\u0641-\u0627\u0644\u0639\u062c\u0632-${name}-${label.replace(/[\\s/]+/g,\"-\")}.pdf`)}",
"function rcptStmt(name,list,label){const rows=[];let sh=0,n=0;",
"  // the acknowledgement covers shortages only: a surplus on another day never reduces what the employee owes",
"  list.forEach(d=>d.boxes.forEach((b,i)=>{if(!hasData(b)||namesIn(b).indexOf(name)<0)return;n++;const df=r2(boxCalc(b).diff);if(df<0){sh=r2(sh+df);rows.push({date:d.date,box:BN(i),df})}}));",
"  return`<div class=\"rcpt\">${head(\"\u0625\u0642\u0631\u0627\u0631 \u0627\u0644\u0639\u062c\u0632\",`<div class=\"c\" style=\"font-weight:700\">${esc(name)} \u2014 ${label}</div>`)}${R(\"\u0639\u062f\u062f \u0627\u0644\u0625\u0642\u0641\u0627\u0644\u0627\u062a\",n)}${R(\"\u0623\u064a\u0627\u0645 \u0627\u0644\u0639\u062c\u0632\",rows.length)}",
"  <table><thead><tr><th>\u0627\u0644\u062a\u0627\u0631\u064a\u062e</th><th>\u0627\u0644\u0635\u0646\u062f\u0648\u0642</th><th class=\"n\">\u0627\u0644\u0639\u062c\u0632</th></tr></thead><tbody>${rows.map(r=>`<tr><td>${dmy(r.date)}</td><td>${r.box}</td><td class=\"n\">${fmt(r.df)}</td></tr>`).join(\"\")||`<tr><td colspan=\"3\" class=\"c\">\u0644\u0627 \u064a\u0648\u062c\u062f \u0639\u062c\u0632 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0641\u062a\u0631\u0629</td></tr>`}</tbody>",
"</table>",
"  ${R(\"\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0639\u062c\u0632\",fmt(sh),\"tot\")}",
"  <div style=\"margin-top:10px;font-size:1em;line-height:1.9\">\u0623\u0642\u0631 \u0623\u0646\u0627 \u0627\u0644\u0645\u0648\u0638\u0641\u0629 / ${esc(name)} \u0628\u0623\u0646\u0646\u064a \u0627\u0637\u0644\u0639\u062a \u0639\u0644\u0649 \u062a\u0642\u0627\u0631\u064a\u0631 \u0635\u0646\u062f\u0648\u0642\u064a \u0644\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0645\u0630\u0643\u0648\u0631\u0629 \u0623\u0639\u0644\u0627\u0647\u060c \u0648\u0623\u0646 \u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0639\u062c\u0632 \u0647\u0648 <b style=\"direction:ltr;unicode-bidi:isolate\">${fmt(Math.abs(sh))}</b> \u0631\u064a\u0627\u0644.</div>",
"  <div class=\"sig\"><div>\u062a\u0648\u0642\u064a\u0639 \u0627\u0644\u0645\u0648\u0638\u0641\u0629</div><div>\u0627\u0644\u0645\u062d\u0627\u0633\u0628</div></div><div class=\"foot\">${esc(settings.store)} \u2014 ${esc(settings.branch)}</div></div>`}",
"/* ---------- Excel export ---------- */",
"function XDate(iso){this.iso=iso}",
"const xd=iso=>new XDate(iso);",
"const serial=iso=>{const [y,m,d]=iso.split(\"-\").map(Number);return(Date.UTC(y,m-1,d)-Date.UTC(1899,11,30))/864e5};",
"async function xlsxSave(filename,sheets){",
"  try{await loadXLSX()}catch(e){toast(e.message);return}",
"  try{",
"    const wb=XLSX.utils.book_new();wb.Workbook={Views:[{RTL:true}]};",
"    sheets.forEach(sh=>{const ws={};let mc=0;",
"      sh.rows.forEach((r,R)=>(r||[]).forEach((v,C)=>{if(v===\"\"||v==null)return;mc=Math.max(mc,C);const a=XLSX.utils.encode_cell({r:R,c:C});",
"        if(v instanceof XDate)ws[a]={t:\"n\",v:serial(v.iso),z:\"dd/mm/yyyy\"};",
"        else if(typeof v===\"number\")ws[a]=(sh.ints||[]).includes(C)||R===0?{t:\"n\",v}:{t:\"n\",v,z:\"#,##0.00\"};",
"        else ws[a]={t:\"s\",v:String(v)}}));",
"      ws[\"!ref\"]=XLSX.utils.encode_range({s:{r:0,c:0},e:{r:Math.max(0,sh.rows.length-1),c:mc}});",
"      ws[\"!cols\"]=(sh.rows[0]||[]).map((h,i)=>({wch:(sh.cols&&sh.cols[i])||Math.max(10,String(h).length+4)}));",
"      XLSX.utils.book_append_sheet(wb,ws,sh.name.slice(0,31))});",
"    const out=XLSX.write(wb,{bookType:\"xlsx\",type:\"array\"});",
"    saveFile(filename,new Blob([out],{type:\"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\"}));",
"  }catch(e){toast(\"\u062a\u0639\u0630\u0651\u0631 \u0625\u0646\u0634\u0627\u0621 \u0645\u0644\u0641 Excel\")}",
"}",
"const xname=s=>String(s).replace(/[\\s/\\\\:*?\"<>|]+/g,\"-\");",
"function xDetail(list){",
"  const H=[\"\u0627\u0644\u062a\u0627\u0631\u064a\u062e\",\"\u0627\u0644\u064a\u0648\u0645\",\"\u0627\u0644\u0635\u0646\u062f\u0648\u0642\",\"\u0623\u0645\u064a\u0646 \u0627\u0644\u0635\u0646\u062f\u0648\u0642\",\"\u0627\u0644\u0648\u0631\u062f\u064a\u0629\",\"\u0627\u0644\u0643\u0627\u0634\",\"\u0645\u0631\u062a\u062c\u0639\u0627\u062a \u0645\u0635\u0631\u0648\u0641\u0629\",\"\u0635\u0627\u0641\u064a \u0627\u0644\u0643\u0627\u0634\",...NV().map(n=>n[1]),\"\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0634\u0628\u0643\u0627\u062a\",\"\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0643\u0644\u064a\",\"\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645\",\"\u0627\u0644\u0632\u064a\u0627\u062f\u0629 / \u0627\u0644\u0646\u0642\u0635\",\"\u0645\u0644\u0627\u062d\u0638\u0627\u062a\"];",
"  const rows=[H];",
"  list.forEach(d=>{d.boxes.forEach((b,i)=>{if(!hasData(b))return;const c=boxCalc(b),rt=retOfBox(d,i);",
"      rows.push([xd(d.date),dayName(d.date),BN(i),b.cashier,b.shift,r2(b.cash),r2(rt),r2((+b.cash||0)+rt),...NV().map(([k])=>r2(b[k])),r2(c.net),r2(c.total),r2(b.report),r2(c.diff),b.notes||\"\"])});",
"    d.returns.filter(r=>r.amount).forEach(r=>rows.push([xd(d.date),dayName(d.date),\"\u0645\u0631\u062a\u062c\u0639\u0627\u062a\",r.box?\"\u0645\u0646 \u0635\u0646\u062f\u0648\u0642 \"+BN(r.box-1):\"\",\"\",0,r2(r.amount),r2(r.amount),...NV().map(()=>0),0,r2(r.amount),r2(r.amount),0,r.note||\"\"]))});",
"  return{name:\"\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0625\u0642\u0641\u0627\u0644\u0627\u062a\",rows,ints:[2],cols:[12,10,9,18,10]};",
"}",
"function xDaily(A){",
"  const rows=[[\"\u0627\u0644\u062a\u0627\u0631\u064a\u062e\",\"\u0627\u0644\u064a\u0648\u0645\",\"\u0627\u0644\u0643\u0627\u0634\",\"\u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a\",\"\u0635\u0627\u0641\u064a \u0627\u0644\u0643\u0627\u0634\",...NV().map(n=>n[1]),\"\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0634\u0628\u0643\u0627\u062a\",\"\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0643\u0644\u064a\",\"\u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645\",\"\u0635\u0627\u0641\u064a \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631\",\"\u0627\u0644\u0632\u064a\u0627\u062f\u0629 / \u0627\u0644\u0646\u0642\u0635\",\"\u0639\u062f\u062f \u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642\"]];",
"  A.rows.forEach(r=>rows.push([xd(r.date),dayName(r.date),r2(r.cash),r2(r.ret),r2(r.cashNet),...NV().map(([k])=>r2(r.nets[k])),r2(r.net),r2(r.total),r2(r.report),r2(r.reportNet),r2(r.diff),r.count]));",
"  const T=A.T;rows.push([\"\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\",\"\",r2(T.cash),r2(T.ret),r2(T.cashNet),...NV().map(([k])=>r2(T.nets[k])),r2(T.net),r2(T.total),r2(T.report),r2(T.reportNet),r2(T.diff),\"\"]);",
"  return{name:\"\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u064a\u0648\u0645\u064a\",rows,ints:[NV().length+10],cols:[12,10]};",
