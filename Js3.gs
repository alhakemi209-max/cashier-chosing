"    L.forEach(x=>rows.push([x.label,x.n,r2(x.sales),...(nt?[r2(x.ret),r2(x.base)]:[]),r2(x.comm)]));",
"    rows.push([\"\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\",C.T.n,r2(C.T.sales),...(nt?[r2(C.T.ret),r2(C.T.base)]:[]),r2(C.T.comm)]);return rows};",
"  const byDay=[[\"\u0627\u0644\u062a\u0627\u0631\u064a\u062e\",\"\u0627\u0644\u064a\u0648\u0645\",\"\u0625\u0642\u0641\u0627\u0644\u0627\u062a\",\"\u0635\u0627\u0641\u064a \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a\",\"\u0627\u0644\u0646\u0633\u0628\u0629\"]];C.day.forEach(d=>byDay.push([xd(d.date),dayName(d.date),d.n,r2(d.base),r2(d.comm)]));",
"  const det=[[\"\u0627\u0644\u062a\u0627\u0631\u064a\u062e\",\"\u0627\u0644\u064a\u0648\u0645\",\"\u0627\u0644\u0635\u0646\u062f\u0648\u0642\",\"\u0623\u0645\u064a\u0646 \u0627\u0644\u0635\u0646\u062f\u0648\u0642\",\"\u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a\",\"\u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a\",\"\u0635\u0627\u0641\u064a \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a\",\"\u0627\u0644\u0646\u0633\u0628\u0629 \u0644\u0643\u0644 1000\",\"\u0645\u0628\u0644\u063a \u0627\u0644\u0646\u0633\u0628\u0629\"]];",
"  list.forEach(d=>d.boxes.forEach((b,i)=>{if(!hasData(b))return;const s=+b.report||0,rt=nt?retOfBox(d,i):0,base=s+rt;det.push([xd(d.date),dayName(d.date),BN(i),b.cashier,r2(s),r2(rt),r2(base),C.rate,r2(base/1000*C.rate)])}));",
"  xlsxSave(`\u0646\u0633\u0628\u0629-\u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a-${xname(label)}.xlsx`,[",
"    {name:\"\u0627\u0644\u0645\u0644\u062e\u0635\",rows:[[\"\u0627\u0644\u0628\u064a\u0627\u0646\",\"\u0627\u0644\u0642\u064a\u0645\u0629\"],[\"\u0627\u0644\u0641\u062a\u0631\u0629\",label],[\"\u0627\u0644\u0646\u0633\u0628\u0629 \u0644\u0643\u0644 1000 \u0631\u064a\u0627\u0644\",C.rate],[\"\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a\",r2(C.T.sales)],[\"\u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a\",r2(C.T.ret)],[\"\u0635\u0627\u0641\u064a \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a\",r2(C.T.base)],[\"\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0646\u0633\u0628\u0629\",r2(C.T.comm)]],cols:[24,22]},",
"    {name:\"\u062d\u0633\u0628 \u0627\u0644\u0635\u0646\u062f\u0648\u0642\",rows:g(C.box,\"\u0627\u0644\u0635\u0646\u062f\u0648\u0642\"),ints:[1],cols:[14]},{name:\"\u062d\u0633\u0628 \u0627\u0644\u0643\u0627\u0634\u064a\u0631\",rows:g(C.cash,\"\u0627\u0644\u0643\u0627\u0634\u064a\u0631\"),ints:[1],cols:[18]},",
"    {name:\"\u062d\u0633\u0628 \u0627\u0644\u064a\u0648\u0645\",rows:byDay,ints:[2],cols:[12,10]},{name:\"\u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644\",rows:det,ints:[2],cols:[12,10,9,18]}]);",
"}",
"function xlsxAtt(A,label){",
"  const sum=[[\"\u0627\u0644\u0645\u0648\u0638\u0641\u0629\",\"\u0646\u0648\u0639 \u0627\u0644\u062f\u0648\u0627\u0645\",\"\u064a\u0648\u0645 \u0627\u0644\u0623\u0648\u0641\",\"\u062d\u0636\u0648\u0631\",\"\u063a\u064a\u0627\u0628\",\"\u0623\u0648\u0641\",\"\u0639\u0645\u0644 \u0641\u064a \u064a\u0648\u0645 \u0627\u0644\u0623\u0648\u0641\"]];",
"  A.rows.forEach(r=>sum.push([r.name,r.type||\"\",r.off||\"\",r.c.p+r.c.po,r.c.a,r.c.o,r.c.po]));",
"  const code={p:\"\u062d\",po:\"\u062d*\",a:\"\u063a\",o:\"\u0623\"};",
