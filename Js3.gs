"  const D=cbData,T=D.totals,tr=(a,b,c)=>`<tr><td class=\"num\">${a}</td><td>${b}</td><td class=\"num\">${c}</td></tr>`;",
"  return`<div class=\"rcpt\">${head(\"\u062d\u0631\u0643\u0629 \u0627\u0644\u0635\u0646\u062f\u0648\u0642\",`<div class=\"c\" style=\"font-weight:700\">${monthName(D.month)}</div>`)}",
"   <table><tbody><tr><td>\u0627\u0644\u0631\u0635\u064a\u062f \u0627\u0644\u0627\u0641\u062a\u062a\u0627\u062d\u064a</td><td class=\"num\">${fmt(T.opening)}</td></tr><tr><td>\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u062f\u062e\u0644\u0627\u062a</td><td class=\"num\">${fmt(T.inTotal)}</td></tr>",
"   <tr><td>\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u062e\u0631\u062c\u0627\u062a</td><td class=\"num\">${fmt(T.out)}</td></tr><tr><td>\u0627\u0644\u0635\u0627\u0641\u064a</td><td class=\"num\">${fmtS(T.net)}</td></tr><tr><td><b>\u0631\u0635\u064a\u062f \u0627\u0644\u0625\u0642\u0641\u0627\u0644</b></td><td class=\"num\"><b>${fmt(T.closing)}</b></td></tr></tbody></table>",
"   <div class=\"t3\" style=\"margin-top:10px\">\u0628\u064a\u0627\u0646 \u0627\u0644\u0645\u062f\u062e\u0644\u0627\u062a</div>",
"   <table><thead><tr><th>\u0627\u0644\u062a\u0627\u0631\u064a\u062e</th><th>\u0627\u0644\u0628\u064a\u0627\u0646</th><th>\u0627\u0644\u0645\u0628\u0644\u063a</th></tr></thead><tbody>${ins.map(e=>tr(dmy(e.date).slice(0,5),esc(e.desc),fmt(e.amount))).join(\"\")||`<tr><td colspan=\"3\">\u0644\u0627 \u062a\u0648\u062c\u062f \u0645\u062f\u062e\u0644\u0627\u062a</td></tr>`}",
"   <tr><td></td><td><b>\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</b></td><td class=\"num\"><b>${fmt(T.inTotal)}</b></td></tr></tbody></table>",
"   <div class=\"t3\" style=\"margin-top:10px\">\u0628\u064a\u0627\u0646 \u0627\u0644\u0645\u062e\u0631\u062c\u0627\u062a</div>",
"   <table><thead><tr><th>\u0627\u0644\u062a\u0627\u0631\u064a\u062e</th><th>\u0627\u0644\u0628\u064a\u0627\u0646</th><th>\u0627\u0644\u0645\u0628\u0644\u063a</th></tr></thead><tbody>${outs.map(e=>tr(dmy(e.date).slice(0,5),esc(e.desc),fmt(e.amount))).join(\"\")||`<tr><td colspan=\"3\">\u0644\u0627 \u062a\u0648\u062c\u062f \u0645\u062e\u0631\u062c\u0627\u062a</td></tr>`}",
"   <tr><td></td><td><b>\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</b></td><td class=\"num\"><b>${fmt(T.out)}</b></td></tr></tbody></table>",
"   ${D.carried?`<div class=\"c\" style=\"margin-top:8px\">\u0631\u064f\u062d\u0651\u0644 \u0631\u0635\u064a\u062f \u0627\u0644\u0625\u0642\u0641\u0627\u0644 \u0625\u0644\u0649 ${monthName(shiftMonth(D.month,1))}</div>`:\"\"}",
"   <div class=\"sig\"><div>\u0623\u0645\u064a\u0646 \u0627\u0644\u0635\u0646\u062f\u0648\u0642</div><div>\u0627\u0644\u0645\u062d\u0627\u0633\u0628</div></div></div>`;",
"}",
"function cbExcel(ins,outs){",
"  const D=cbData,T=D.totals,rows=[[\"\u062d\u0631\u0643\u0629 \u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u2014 \"+monthName(D.month),\"\",\"\",\"\"],[],[\"\u0627\u0644\u0631\u0635\u064a\u062f \u0627\u0644\u0627\u0641\u062a\u062a\u0627\u062d\u064a\",T.opening],[\"\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u062f\u062e\u0644\u0627\u062a\",T.inTotal],[\"\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u062e\u0631\u062c\u0627\u062a\",T.out],[\"\u0627\u0644\u0635\u0627\u0641\u064a\",T.net],[\"\u0631\u0635\u064a\u062f \u0627\u0644\u0625\u0642\u0641\u0627\u0644\",T.closing],[],[\"\u0627\u0644\u0646\u0648\u0639\",\"\u0627\u0644\u062a\u0627\u0631\u064a\u062e\",\"\u0627\u0644\u0628\u064a\u0627\u0646\",\"\u0627\u0644\u0645\u0628\u0644\u063a\"]];",
"  ins.forEach(e=>rows.push([\"\u0645\u062f\u062e\u0644\",xd(e.date),e.desc,e.amount]));outs.forEach(e=>rows.push([\"\u0645\u062e\u0631\u062c\",xd(e.date),e.desc,e.amount]));",
"  xlsxSave(`\u062d\u0631\u0643\u0629-\u0627\u0644\u0635\u0646\u062f\u0648\u0642-${D.month}.xlsx`,[{name:\"\u062d\u0631\u0643\u0629 \u0627\u0644\u0635\u0646\u062f\u0648\u0642\",rows,cols:[14,14,46,16]}]);",
"}",
"/* ---------- roles, screen names and icons added in this version ---------- */",
"ROLES.own={name:\"\u0627\u0644\u0645\u0627\u0644\u0643\",desc:\"\u0627\u0644\u0627\u0637\u0644\u0627\u0639 \u0639\u0644\u0649 \u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0641\u0631\u0648\u0639\",tabs:[]};",
"Object.assign(TABN,{branches:\"\u0627\u0644\u0641\u0631\u0648\u0639\",petty:\"\u0627\u0644\u0639\u0647\u062f\u0629\",home:\"\u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629\"});",
"Object.assign(ICONS,{",
" branches:'<svg viewBox=\"0 0 24 24\"><path d=\"M3 21h18\"/><path d=\"M4 21V10l4-3 4 3v11\"/><path d=\"M12 21V6l4-3 4 3v15\"/><path d=\"M7 14h2M15 10h2M15 14h2\"/></svg>',",
" petty:'<svg viewBox=\"0 0 24 24\"><path d=\"M4 7h13a3 3 0 0 1 3 3v7a3 3 0 0 1-3 3H4z\"/><path d=\"M4 7l10-3 2 3\"/><circle cx=\"16\" cy=\"13.5\" r=\"1.4\"/></svg>',",
" home:'<svg viewBox=\"0 0 24 24\"><path d=\"M4 11l8-7 8 7\"/><path d=\"M6 10v10h12V10\"/><path d=\"M10 20v-5h4v5\"/></svg>'});",
"",
"/* ---------- branch switcher ---------- */",
"const brName=id=>((ALLBR||BRANCHES||[]).find(b=>b.id===id)||{}).name||\"\";",
"function paintBranch(){",
"  const b=$(\"#brSw\");if(!b)return;const many=(BRANCHES||[]).length>1&&!!me;",
"  b.hidden=!many;$(\"#branchName\").hidden=many;",
"  if(many)b.innerHTML=`${esc(brName(BRC)||settings.branch||\"\")} <span aria-hidden=\"true\">\u25be</span>`;",
"}",
"function pickBranchUI(){",
"  if(!(BRANCHES||[]).length)return;",
"  const s=sheet(\"\u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0641\u0631\u0639\",`<div class=\"br-list\">${BRANCHES.map(b=>`<button class=\"set-row\" type=\"button\" data-brp=\"${esc(b.id)}\"><span class=\"set-ic\">${ICONS.branches}</span><span class=\"set-txt\"><b>${esc(b.name)}</b>${b.id===BRC?`<span class=\"note\">\u0627\u0644\u0641\u0631\u0639 \u0627\u0644\u062d\u0627\u0644\u064a</span>`:\"\"}</span>${b.id===BRC?`<span class=\"pill saved\">\u2713</span>`:\"\"}</button>`).join(\"\")}</div>`,\"\");",
"  s.el.querySelectorAll(\"[data-brp]\").forEach(x=>x.onclick=()=>{s.close();switchBranch(x.dataset.brp)});",
"}",
"async function switchBranch(id){",
"  if(id===BRC)return;",
"  if(pendDates().length){toast(\"\u0641\u064a\u0647 \u062a\u0639\u062f\u064a\u0644\u0627\u062a \u0645\u0627 \u0648\u0635\u0644\u062a \u0644\u0644\u062e\u0627\u062f\u0645 \u0628\u0639\u062f\u060c \u0627\u0646\u062a\u0638\u0631 \u0627\u0644\u062d\u0641\u0638 \u062b\u0645 \u0628\u062f\u0651\u0644 \u0627\u0644\u0641\u0631\u0639\");flush();return}",
"  const keep=BRC;BRC=id;",
"  $(\"#view\").innerHTML=`<div class=\"card empty\">\u062c\u0627\u0631\u064d \u0641\u062a\u062d \u0641\u0631\u0639 ${esc(brName(id))}\u2026</div>`;",
"  try{const b=await api(\"boot\",{});days.clear();sentLog=[];cbData=null;ptData=null;usersCache=null;applyBoot(b);tab=myTabs().indexOf(\"home\")>=0?\"home\":myTabs()[0];render();toast(\"\u0641\u0631\u0639 \"+brName(BRC))}",
"  catch(e){BRC=keep;toast(e.msg||\"\u062a\u0639\u0630\u0651\u0631 \u0641\u062a\u062d \u0627\u0644\u0641\u0631\u0639\");render()}",
"}",
"",
"/* ---------- branches report: one branch, several, or all of them combined ---------- */",
"let brP=null,brSel=null,brMode=\"sum\",brRows=null,brKey=\"\";",
"function renderBranches(){",
"  if(!brP)brP=Object.assign(mkP(),{mode:\"month\"});",
"  const list=ALLBR||BRANCHES||[];if(!brSel)brSel=list.map(b=>b.id);",
"  const [f,t,label]=periodRange(brP),key=f+\"|\"+t+\"|\"+brSel.join(\",\");",
"  const head=`${periodCtrl(brP)}",
"   <div class=\"card br-pick\"><div class=\"sec-h\"><h3 class=\"set-h\" style=\"margin:0\">\u0627\u0644\u0641\u0631\u0648\u0639</h3><button class=\"btn small\" id=\"brAll\" type=\"button\">${brSel.length===list.length?\"\u0625\u0644\u063a\u0627\u0621 \u0627\u0644\u0643\u0644\":\"\u0627\u0644\u0643\u0644\"}</button></div>",
"    <div class=\"br-chips\">${list.map(b=>`<label class=\"chip-ck\"><input type=\"checkbox\" data-brk=\"${esc(b.id)}\" ${brSel.indexOf(b.id)>=0?\"checked\":\"\"}><span>${esc(b.name)}</span></label>`).join(\"\")}</div>",
"    <div class=\"seg\" role=\"group\" aria-label=\"\u0634\u0643\u0644 \u0627\u0644\u062a\u0642\u0631\u064a\u0631\"><button type=\"button\" data-brm=\"sum\" aria-pressed=\"${brMode===\"sum\"}\">\u062a\u0642\u0631\u064a\u0631 \u0645\u062c\u0645\u0651\u0639</button><button type=\"button\" data-brm=\"each\" aria-pressed=\"${brMode===\"each\"}\">\u0644\u0643\u0644 \u0641\u0631\u0639</button></div></div>`;",
"  if(brKey!==key||!brRows){",
"    $(\"#view\").innerHTML=head+`<div class=\"card empty\">\u062c\u0627\u0631\u064d \u062a\u062c\u0647\u064a\u0632 \u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0641\u0631\u0648\u0639\u2026</div>`;bindBr();",
"    if(!brSel.length){$(\"#view\").lastElementChild.textContent=\"\u0627\u062e\u062a\u0631 \u0641\u0631\u0639\u0627\u064b \u0648\u0627\u062d\u062f\u0627\u064b \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644.\";return}",
"    brKey=key;brRows=null;",
"    api(\"brReport\",{from:f,to:t,ids:brSel}).then(r=>{if(brKey===key){brRows=r;if(tab===\"branches\"&&!layerOpen())renderBranches()}}).catch(e=>{if(brKey===key){brRows=[];toast(e.msg||\"\u062a\u0639\u0630\u0651\u0631 \u062a\u062c\u0647\u064a\u0632 \u0627\u0644\u062a\u0642\u0631\u064a\u0631\")}});",
"    return}",
"  const R=brRows,T=brTotal(R);if(totOnly())return renderBrTotals(head,R,T,label);",
"  const card=(o,title)=>`<div class=\"card br-card\"><div class=\"sec-h\"><h3 class=\"set-h\" style=\"margin:0\">${title}</h3><span class=\"note num\">${o.days} \u064a\u0648\u0645</span></div>",
"    <div class=\"strip\"><div class=\"stat\"><span>\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</span><b class=\"num\">${fmt(o.total)}</b></div><div class=\"stat\"><span>\u0627\u0644\u0643\u0627\u0634</span><b class=\"num\">${fmt(o.cash)}</b></div>",
"     <div class=\"stat\"><span>\u0627\u0644\u0634\u0628\u0643\u0627\u062a</span><b class=\"num\">${fmt(o.net)}</b></div><div class=\"stat\"><span>\u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645</span><b class=\"num\">${fmt(o.report)}</b></div>",
"     <div class=\"stat ${o.short<0?\"short\":\"\"}\"><span>\u0627\u0644\u0639\u062c\u0632</span><b class=\"num\">${fmt(o.short)}</b></div><div class=\"stat\"><span>\u0627\u0644\u0632\u064a\u0627\u062f\u0629</span><b class=\"num\">${fmt(o.over)}</b></div>",
"     <div class=\"stat\"><span>\u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a</span><b class=\"num\">${fmt(o.ret)}</b></div><div class=\"stat ${o.diff<0?\"short\":o.diff>0?\"over\":\"\"}\"><span>\u0627\u0644\u0635\u0627\u0641\u064a (\u0632\u064a\u0627\u062f\u0629 / \u0646\u0642\u0635)</span><b class=\"num\">${fmtS(o.diff)}</b></div></div></div>`;",
"  $(\"#view\").innerHTML=head+`<p class=\"note\" style=\"margin:0 2px 8px\">${label}</p>",
"   ${brMode===\"sum\"?card(T,R.length>1?`\u0645\u062c\u0645\u0651\u0639 ${R.length} \u0641\u0631\u0648\u0639`:esc(R[0]?R[0].name:\"\")):\"\"}",
"   <div class=\"tbl-wrap\"><table class=\"br-tbl\"><thead><tr><th>\u0627\u0644\u0641\u0631\u0639</th><th>\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</th><th>\u0627\u0644\u0643\u0627\u0634</th><th>\u0627\u0644\u0634\u0628\u0643\u0627\u062a</th><th>\u0627\u0644\u0639\u062c\u0632</th><th>\u0627\u0644\u0635\u0627\u0641\u064a</th></tr></thead><tbody>",
"    ${R.map(o=>`<tr><td><b>${esc(o.name)}</b></td><td class=\"num\">${fmt(o.total)}</td><td class=\"num\">${fmt(o.cash)}</td><td class=\"num\">${fmt(o.net)}</td><td class=\"num\">${fmt(o.short)}</td><td class=\"num\">${fmtS(o.diff)}</td></tr>`).join(\"\")}",
"    ${R.length>1?`<tr class=\"tot\"><td>\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</td><td class=\"num\">${fmt(T.total)}</td><td class=\"num\">${fmt(T.cash)}</td><td class=\"num\">${fmt(T.net)}</td><td class=\"num\">${fmt(T.short)}</td><td class=\"num\">${fmtS(T.diff)}</td></tr>`:\"\"}</tbody></table></div>",
"   ${brMode===\"each\"?R.map(o=>card(o,esc(o.name))).join(\"\"):\"\"}",
"   <div class=\"row-btns\"><button class=\"btn primary\" id=\"brPdf\" type=\"button\">\u0637\u0628\u0627\u0639\u0629</button><button class=\"btn\" id=\"brX\" type=\"button\">\u062a\u0635\u062f\u064a\u0631 Excel</button></div>`;",
"  bindBr();",
"  $(\"#brPdf\").onclick=()=>preview(\"\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0641\u0631\u0648\u0639\",rcptBranches(R,T,label),`\u062a\u0642\u0631\u064a\u0631-\u0627\u0644\u0641\u0631\u0648\u0639-${xname(label)}.pdf`);",
"  $(\"#brX\").onclick=()=>brExcel(R,T,label);",
"}",
"/* owner limited to totals: cash, networks and their total, per branch and combined */",
"function totOnly(){return!!(me&&me.role===\"own\"&&me.perms&&me.perms.totals)}",
"function renderBrTotals(head,R,T,label){",
"  const card=(o,title)=>`<div class=\"card br-card\"><div class=\"sec-h\"><h3 class=\"set-h\" style=\"margin:0\">${title}</h3><span class=\"note num\">${o.days} \u064a\u0648\u0645</span></div>",
"    <div class=\"strip\"><div class=\"stat\"><span>\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0643\u0627\u0634</span><b class=\"num\">${fmt(o.cash)}</b></div><div class=\"stat\"><span>\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0634\u0628\u0643\u0627\u062a</span><b class=\"num\">${fmt(o.net)}</b></div>",
"     <div class=\"stat\"><span>\u0627\u0644\u0643\u0627\u0634 \u0648\u0627\u0644\u0634\u0628\u0643\u0627\u062a</span><b class=\"num\">${fmt(o.total)}</b></div></div></div>`;",
"  const tr=(n,o,b)=>`<tr${b?' class=\"tot\"':\"\"}><td>${b?n:`<b>${n}</b>`}</td><td class=\"num\">${fmt(o.cash)}</td><td class=\"num\">${fmt(o.net)}</td><td class=\"num\">${fmt(o.total)}</td></tr>`;",
"  $(\"#view\").innerHTML=head+`<p class=\"note\" style=\"margin:0 2px 8px\">${label}</p>",
"   ${brMode===\"sum\"?card(T,R.length>1?`\u0645\u062c\u0645\u0651\u0639 ${R.length} \u0641\u0631\u0648\u0639`:esc(R[0]?R[0].name:\"\")):\"\"}",
"   <div class=\"tbl-wrap\"><table class=\"br-tbl\"><thead><tr><th>\u0627\u0644\u0641\u0631\u0639</th><th>\u0627\u0644\u0643\u0627\u0634</th><th>\u0627\u0644\u0634\u0628\u0643\u0627\u062a</th><th>\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</th></tr></thead><tbody>",
"    ${R.map(o=>tr(esc(o.name),o)).join(\"\")}${R.length>1?tr(\"\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\",T,1):\"\"}</tbody></table></div>",
"   ${brMode===\"each\"?R.map(o=>card(o,esc(o.name))).join(\"\"):\"\"}",
"   <div class=\"row-btns\"><button class=\"btn primary\" id=\"brPdf\" type=\"button\">\u0637\u0628\u0627\u0639\u0629</button>${me.perms.xlsx?`<button class=\"btn\" id=\"brX\" type=\"button\">\u062a\u0635\u062f\u064a\u0631 Excel</button>`:\"\"}</div>`;",
"  bindBr();",
"  $(\"#brPdf\").onclick=()=>preview(\"\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\u0627\u062a\",rcptBrTotals(R,T,label),`\u062a\u0642\u0631\u064a\u0631-\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\u0627\u062a-${xname(label)}.pdf`);",
"  const x=$(\"#brX\");if(x)x.onclick=()=>{const H=[\"\u0627\u0644\u0641\u0631\u0639\",\"\u0627\u0644\u0623\u064a\u0627\u0645\",\"\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0643\u0627\u0634\",\"\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0634\u0628\u0643\u0627\u062a\",\"\u0627\u0644\u0643\u0627\u0634 \u0648\u0627\u0644\u0634\u0628\u0643\u0627\u062a\"],L=(n,o)=>[n,o.days,o.cash,o.net,o.total];",
"    const sh=[{name:\"\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\u0627\u062a\",rows:[H].concat(R.map(o=>L(o.name,o))).concat(R.length>1?[L(\"\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\",T)]:[]),cols:[22,8,16,16,16],ints:[1]}];",
"    if(brMode===\"each\")R.forEach(o=>sh.push({name:String(o.name).slice(0,28),rows:[[\"\u0627\u0644\u062a\u0627\u0631\u064a\u062e\",\"\u0627\u0644\u0643\u0627\u0634\",\"\u0627\u0644\u0634\u0628\u0643\u0627\u062a\",\"\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\"]].concat(o.perDay.map(d=>[xd(d.date),d.cash,d.net,d.total])),cols:[14,14,14,14]}));",
"    xlsxSave(`\u062a\u0642\u0631\u064a\u0631-\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\u0627\u062a-${xname(label)}.xlsx`,sh)};",
"}",
"function rcptBrTotals(R,T,label){",
"  const row=(n,o,b)=>`<tr${b?' style=\"font-weight:700\"':\"\"}><td>${n}</td><td class=\"num\">${fmt(o.cash)}</td><td class=\"num\">${fmt(o.net)}</td><td class=\"num\">${fmt(o.total)}</td></tr>`;",
"  return`<div class=\"rcpt\">${head(\"\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\u0627\u062a\",`<div class=\"c\" style=\"font-weight:700\">${label}</div><div class=\"c\">${brMode===\"sum\"?\"\u062a\u0642\u0631\u064a\u0631 \u0645\u062c\u0645\u0651\u0639\":\"\u062a\u0642\u0631\u064a\u0631 \u0644\u0643\u0644 \u0641\u0631\u0639\"} \u2014 ${R.length} \u0641\u0631\u0639</div>`)}",
"   <table><thead><tr><th>\u0627\u0644\u0641\u0631\u0639</th><th>\u0627\u0644\u0643\u0627\u0634</th><th>\u0627\u0644\u0634\u0628\u0643\u0627\u062a</th><th>\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</th></tr></thead><tbody>",
"   ${R.map(o=>row(esc(o.name),o)).join(\"\")}${R.length>1?row(\"\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\",T,1):\"\"}</tbody></table>",
"   ${brMode===\"each\"?R.map(o=>`<div class=\"t3\" style=\"margin-top:10px\">${esc(o.name)}</div><table><thead><tr><th>\u0627\u0644\u062a\u0627\u0631\u064a\u062e</th><th>\u0627\u0644\u0643\u0627\u0634</th><th>\u0627\u0644\u0634\u0628\u0643\u0627\u062a</th><th>\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</th></tr></thead><tbody>${o.perDay.map(d=>`<tr><td class=\"num\">${dmy(d.date).slice(0,5)}</td><td class=\"num\">${fmt(d.cash)}</td><td class=\"num\">${fmt(d.net)}</td><td class=\"num\">${fmt(d.total)}</td></tr>`).join(\"\")||`<tr><td colspan=\"4\">\u0644\u0627 \u062a\u0648\u062c\u062f \u0628\u064a\u0627\u0646\u0627\u062a</td></tr>`}</tbody></table>`).join(\"\"):\"\"}</div>`;",
"}",
"function brTotal(R){const T={days:0,cash:0,ret:0,net:0,total:0,report:0,diff:0,short:0,over:0};R.forEach(o=>Object.keys(T).forEach(k=>T[k]=r2(T[k]+(+o[k]||0))));T.days=Math.max(0,...R.map(o=>o.days));return T}",
"function bindBr(){",
"  bindPeriod(brP,()=>{brRows=null;renderBranches()});",
"  document.querySelectorAll(\"[data-brk]\").forEach(x=>x.onchange=()=>{brSel=[...document.querySelectorAll(\"[data-brk]\")].filter(e=>e.checked).map(e=>e.dataset.brk);brRows=null;renderBranches()});",
"  document.querySelectorAll(\"[data-brm]\").forEach(x=>x.onclick=()=>{brMode=x.dataset.brm;renderBranches()});",
"  const a=$(\"#brAll\");if(a)a.onclick=()=>{const L=(ALLBR||BRANCHES||[]).map(b=>b.id);brSel=brSel.length===L.length?[]:L;brRows=null;renderBranches()};",
"}",
"function rcptBranches(R,T,label){",
"  const row=(n,o,b)=>`<tr${b?' style=\"font-weight:700\"':\"\"}><td>${n}</td><td class=\"num\">${fmt(o.total)}</td><td class=\"num\">${fmt(o.cash)}</td><td class=\"num\">${fmt(o.net)}</td><td class=\"num\">${fmt(o.short)}</td><td class=\"num\">${fmtS(o.diff)}</td></tr>`;",
"  return`<div class=\"rcpt\">${head(\"\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0641\u0631\u0648\u0639\",`<div class=\"c\" style=\"font-weight:700\">${label}</div><div class=\"c\">${brMode===\"sum\"?\"\u062a\u0642\u0631\u064a\u0631 \u0645\u062c\u0645\u0651\u0639\":\"\u062a\u0642\u0631\u064a\u0631 \u0644\u0643\u0644 \u0641\u0631\u0639\"} \u2014 ${R.length} \u0641\u0631\u0639</div>`)}",
"   <table><thead><tr><th>\u0627\u0644\u0641\u0631\u0639</th><th>\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</th><th>\u0627\u0644\u0643\u0627\u0634</th><th>\u0627\u0644\u0634\u0628\u0643\u0627\u062a</th><th>\u0627\u0644\u0639\u062c\u0632</th><th>\u0627\u0644\u0635\u0627\u0641\u064a</th></tr></thead><tbody>",
"   ${R.map(o=>row(esc(o.name),o)).join(\"\")}${R.length>1?row(\"\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\",T,1):\"\"}</tbody></table>",
"   ${brMode===\"each\"?R.map(o=>`<div class=\"t3\" style=\"margin-top:10px\">${esc(o.name)}</div><table><thead><tr><th>\u0627\u0644\u062a\u0627\u0631\u064a\u062e</th><th>\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</th><th>\u0627\u0644\u062a\u0642\u0631\u064a\u0631</th><th>\u0627\u0644\u0635\u0627\u0641\u064a</th></tr></thead><tbody>${o.perDay.map(d=>`<tr><td class=\"num\">${dmy(d.date).slice(0,5)}</td><td class=\"num\">${fmt(d.total)}</td><td class=\"num\">${fmt(d.report)}</td><td class=\"num\">${fmtS(d.diff)}</td></tr>`).join(\"\")||`<tr><td colspan=\"4\">\u0644\u0627 \u062a\u0648\u062c\u062f \u0628\u064a\u0627\u0646\u0627\u062a</td></tr>`}</tbody></table>`).join(\"\"):\"\"}</div>`;",
"}",
"function brExcel(R,T,label){",
"  const H=[\"\u0627\u0644\u0641\u0631\u0639\",\"\u0627\u0644\u0623\u064a\u0627\u0645\",\"\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\",\"\u0627\u0644\u0643\u0627\u0634\",\"\u0627\u0644\u0634\u0628\u0643\u0627\u062a\",\"\u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a\",\"\u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645\",\"\u0627\u0644\u0639\u062c\u0632\",\"\u0627\u0644\u0632\u064a\u0627\u062f\u0629\",\"\u0627\u0644\u0635\u0627\u0641\u064a\"];",
"  const line=(n,o)=>[n,o.days,o.total,o.cash,o.net,o.ret,o.report,o.short,o.over,o.diff];",
"  const sheets=[{name:\"\u0627\u0644\u0641\u0631\u0648\u0639\",rows:[H].concat(R.map(o=>line(o.name,o))).concat(R.length>1?[line(\"\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\",T)]:[]),cols:[22,8,14,14,14,12,14,12,12,12],ints:[1]}];",
"  if(brMode===\"each\")R.forEach(o=>sheets.push({name:String(o.name).slice(0,28),rows:[[\"\u0627\u0644\u062a\u0627\u0631\u064a\u062e\",\"\u0627\u0644\u0643\u0627\u0634\",\"\u0627\u0644\u0634\u0628\u0643\u0627\u062a\",\"\u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a\",\"\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\",\"\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645\",\"\u0627\u0644\u0635\u0627\u0641\u064a\"]].concat(o.perDay.map(d=>[xd(d.date),d.cash,d.net,d.ret,d.total,d.report,d.diff])),cols:[12,14,14,12,14,14,12]}));",
"  xlsxSave(`\u062a\u0642\u0631\u064a\u0631-\u0627\u0644\u0641\u0631\u0648\u0639-${xname(label)}.xlsx`,sheets);",
"}",
"/* ---------- petty cash custody ---------- */",
"let ptData=null,ptRev=0,ptSel=\"\";",
"const PT_KIND={fund:\"\u0635\u0631\u0641 / \u062a\u0639\u0632\u064a\u0632\",exp:\"\u0645\u0635\u0631\u0648\u0641\",ret:\"\u0625\u0631\u062c\u0627\u0639 \u0646\u0642\u062f\u064a\"};",
"async function loadPt(){try{ptData=await api(\"petty\");ptRev=lastRev}catch(e){ptData={error:e.msg||\"\u062a\u0639\u0630\u0651\u0631 \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0639\u0647\u062f\"}}}",
"const ptEdit=()=>effectiveRole()===\"acc\";",
"function renderPetty(){",
"  if(!ptData||(ptRev!==lastRev&&!ptData.error)){",
"    if(!ptData)$(\"#view\").innerHTML=`<div class=\"card empty\">\u062c\u0627\u0631\u064d \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0639\u0647\u062f\u2026</div>`;",
"    loadPt().then(()=>{if(tab===\"petty\"&&!layerOpen())drawPetty()});if(ptData)drawPetty();return}",
"  drawPetty();",
"}",
"function drawPetty(){",
"  const D=ptData;if(!D)return;",
"  if(D.error){$(\"#view\").innerHTML=`<div class=\"card empty\">${esc(D.error)}<br><br><button class=\"btn small\" id=\"ptRe\">\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629</button></div>`;$(\"#ptRe\").onclick=()=>{ptData=null;renderPetty()};return}",
"  const P=D.people.find(x=>x.id===ptSel);if(P){drawPerson(P);return}ptSel=\"\";",
"  const act=D.people.filter(p=>p.active),T=act.reduce((a,p)=>({bal:a.bal+p.balance,open:a.open+p.openExp}),{bal:0,open:0});",
"  $(\"#view\").innerHTML=`<div class=\"pt-head\"><div><span class=\"note\">\u0623\u0631\u0635\u062f\u0629 \u0627\u0644\u0639\u0647\u062f \u0627\u0644\u062d\u0627\u0644\u064a\u0629</span><b class=\"num\">${fmt(T.bal)}</b></div><div><span class=\"note\">\u0645\u0635\u0631\u0648\u0641\u0627\u062a \u0644\u0645 \u062a\u064f\u0635\u0641\u064e\u0651</span><b class=\"num\">${fmt(T.open)}</b></div></div>",
"   <div class=\"sec-h cb-h\"><h2>\u0623\u0635\u062d\u0627\u0628 \u0627\u0644\u0639\u0647\u062f</h2>${ptEdit()?`<button class=\"btn small primary\" id=\"ptAdd\" type=\"button\">+ \u0635\u0627\u062d\u0628 \u0639\u0647\u062f\u0629</button>`:\"\"}</div>",
"   <div class=\"card set-people\">${D.people.length?D.people.map(p=>`<button class=\"person\" type=\"button\" data-ptp=\"${esc(p.id)}\"><span class=\"av ${p.active?\"\":\"off\"}\">${esc(p.name.trim().charAt(0))}</span>",
"     <span class=\"p-txt\"><b>${esc(p.name)}</b><span class=\"p-tags\"><span class=\"tag\">\u0627\u0644\u0639\u0647\u062f\u0629 ${fmt(p.amount)}</span>${p.openCount?`<span class=\"tag miss\">${p.openCount} \u0641\u0627\u062a\u0648\u0631\u0629 \u0644\u0645 \u062a\u064f\u0635\u0641\u064e\u0651</span>`:`<span class=\"tag ok\">\u0645\u0635\u0641\u0651\u0627\u0629</span>`}${p.active?\"\":`<span class=\"tag\">\u0645\u0648\u0642\u0648\u0641\u0629</span>`}</span></span>",
"     <span class=\"pt-bal\"><span class=\"note\">\u0627\u0644\u0631\u0635\u064a\u062f</span><b class=\"num\">${fmt(p.balance)}</b></span></button>`).join(\"\")",
"     :`<div class=\"empty\">\u0644\u0627 \u062a\u0648\u062c\u062f \u0639\u0647\u062f \u0628\u0639\u062f.${ptEdit()?\" \u0623\u0636\u0641 \u0623\u0648\u0644 \u0635\u0627\u062d\u0628 \u0639\u0647\u062f\u0629 \u0645\u0646 \u0632\u0631 \u00ab+ \u0635\u0627\u062d\u0628 \u0639\u0647\u062f\u0629\u00bb.\":\"\"}</div>`}</div>",
"   <p class=\"note\">\u0627\u0644\u0639\u0647\u062f\u0629 \u0645\u0628\u0644\u063a \u064a\u064f\u0635\u0631\u0641 \u0644\u0645\u0648\u0638\u0641 \u064a\u0646\u0641\u0642 \u0645\u0646\u0647 \u0628\u0641\u0648\u0627\u062a\u064a\u0631\u060c \u062b\u0645 \u062a\u064f\u0635\u0641\u0651\u0649 \u0627\u0644\u0641\u0648\u0627\u062a\u064a\u0631 \u0648\u062a\u064f\u0633\u062a\u0639\u0627\u0636.</p>`;",
"  const a=$(\"#ptAdd\");if(a)a.onclick=()=>ptPersonUI(null);",
"  document.querySelectorAll(\"[data-ptp]\").forEach(b=>b.onclick=()=>{ptSel=b.dataset.ptp;drawPetty();window.scrollTo(0,0)});",
"}",
"function drawPerson(P){",
"  const D=ptData,ed=ptEdit(),tx=D.tx.filter(t=>t.pid===P.id),open=tx.filter(t=>!t.settle),st=D.settles.filter(s=>s.pid===P.id);",
"  const row=t=>`<button class=\"cb-row\" type=\"button\" ${ed&&!t.settle?`data-tx=\"${esc(t.id)}\"`:\"disabled\"}><span class=\"cb-d num\">${dmy(t.date).slice(0,5)}</span><span class=\"cb-t\"><b>${esc(t.desc)}</b><span class=\"note\">${PT_KIND[t.kind]}${t.ref?\" \u00b7 \u0641\u0627\u062a\u0648\u0631\u0629 \"+esc(t.ref):\"\"}</span></span><span class=\"cb-a num ${t.kind===\"exp\"||t.kind===\"ret\"?\"neg\":\"\"}\">${t.kind===\"fund\"?\"\":\"\u2212\"}${fmt(t.amount)}</span></button>`;",
"  $(\"#view\").innerHTML=`<div class=\"set-top\"><button class=\"set-back\" id=\"ptBack\" type=\"button\">${svgI(\"back\")}<span>\u0627\u0644\u0639\u0647\u062f</span></button>",
"    <div class=\"set-title\"><span class=\"av\">${esc(P.name.trim().charAt(0))}</span><div><h2>${esc(P.name)}</h2><p class=\"note\">\u0645\u0628\u0644\u063a \u0627\u0644\u0639\u0647\u062f\u0629 ${fmt(P.amount)}${P.active?\"\":\" \u00b7 \u0645\u0648\u0642\u0648\u0641\u0629\"}</p></div>${ed?`<button class=\"btn small\" id=\"ptEditP\" type=\"button\" style=\"margin-inline-start:auto\">\u062a\u0639\u062f\u064a\u0644</button>`:\"\"}</div></div>",
"   <div class=\"card cb-sum\">",
"    <div class=\"cb-l\"><span>\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0635\u0631\u0648\u0641 \u0644\u0647</span><b class=\"num\">${fmt(P.funded)}</b></div>",
"    <div class=\"cb-l out\"><span>\u0627\u0644\u0645\u0635\u0631\u0648\u0641\u0627\u062a</span><b class=\"num\">${fmt(P.spent)}</b></div>",
"    ${P.returned?`<div class=\"cb-l\"><span>\u0627\u0644\u0645\u064f\u0631\u062c\u064e\u0639 \u0646\u0642\u062f\u0627\u064b</span><b class=\"num\">${fmt(P.returned)}</b></div>`:\"\"}",
"    <div class=\"cb-l\"><span>\u0645\u0635\u0631\u0648\u0641\u0627\u062a \u0644\u0645 \u062a\u064f\u0635\u0641\u064e\u0651</span><b class=\"num\">${fmt(P.openExp)}</b></div>",
"    <div class=\"cb-l close\"><span>\u0627\u0644\u0631\u0635\u064a\u062f \u0627\u0644\u062d\u0627\u0644\u064a \u0645\u0639 \u0635\u0627\u062d\u0628 \u0627\u0644\u0639\u0647\u062f\u0629</span><b class=\"num\">${fmt(P.balance)}</b></div></div>",
"   ${ed?`<div class=\"row-btns\"><button class=\"btn primary\" id=\"ptExp\" type=\"button\">+ \u0645\u0635\u0631\u0648\u0641 \u0628\u0641\u0627\u062a\u0648\u0631\u0629</button><button class=\"btn\" id=\"ptFund\" type=\"button\">+ \u0635\u0631\u0641 / \u062a\u0639\u0632\u064a\u0632</button><button class=\"btn\" id=\"ptRet\" type=\"button\">+ \u0625\u0631\u062c\u0627\u0639 \u0646\u0642\u062f\u064a</button></div>`:\"\"}",
"   <div class=\"sec-h cb-h\"><h2>\u0627\u0644\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0645\u0641\u062a\u0648\u062d\u0629</h2><span class=\"note num\">${open.length}</span></div>",
"   <div class=\"card cb-list\">${open.length?open.map(row).join(\"\"):`<div class=\"empty\">\u0644\u0627 \u062a\u0648\u062c\u062f \u062d\u0631\u0643\u0627\u062a \u0645\u0641\u062a\u0648\u062d\u0629.</div>`}</div>",
"   ${ed?`<div class=\"card cb-close\"><div><span class=\"note\">\u062c\u0627\u0647\u0632 \u0644\u0644\u062a\u0635\u0641\u064a\u0629</span><b class=\"num\">${fmt(P.openExp)}</b></div><button class=\"btn primary block\" id=\"ptSettle\" type=\"button\" ${P.openCount?\"\":\"disabled\"}>\u062a\u0635\u0641\u064a\u0629 \u0627\u0644\u0639\u0647\u062f\u0629</button>",
"     <p class=\"note\">\u0627\u0644\u062a\u0635\u0641\u064a\u0629 \u062a\u0642\u0641\u0644 \u0627\u0644\u0641\u0648\u0627\u062a\u064a\u0631 \u0627\u0644\u0645\u0641\u062a\u0648\u062d\u0629 \u0648\u062a\u0637\u0628\u0639 \u0646\u0645\u0648\u0630\u062c \u0627\u0644\u062a\u0635\u0641\u064a\u0629. \u0648\u0639\u0646\u062f \u0627\u0644\u0627\u0633\u062a\u0639\u0627\u0636\u0629 \u064a\u064f\u0635\u0631\u0641 \u0644\u0635\u0627\u062d\u0628 \u0627\u0644\u0639\u0647\u062f\u0629 \u0645\u0628\u0644\u063a \u0645\u0627 \u0623\u0646\u0641\u0642\u0647\u060c \u0641\u062a\u0631\u062c\u0639 \u0639\u0647\u062f\u062a\u0647 \u0643\u0627\u0645\u0644\u0629.</p></div>`:\"\"}",
"   ${st.length?`<div class=\"sec-h cb-h\"><h2>\u0627\u0644\u062a\u0635\u0641\u064a\u0627\u062a \u0627\u0644\u0633\u0627\u0628\u0642\u0629</h2></div><div class=\"card cb-list\">${st.map(s=>`<button class=\"cb-row\" type=\"button\" data-pst=\"${esc(s.id)}\"><span class=\"cb-d num\">${dmy(s.date).slice(0,5)}</span><span class=\"cb-t\"><b>\u062a\u0635\u0641\u064a\u0629 \u0631\u0642\u0645 ${s.no}</b><span class=\"note\">\u0645\u0646 ${dmy(s.from)} \u0625\u0644\u0649 ${dmy(s.to)}${s.refill?\" \u00b7 \u0645\u0639 \u0627\u0644\u0627\u0633\u062a\u0639\u0627\u0636\u0629\":\"\"}</span></span><span class=\"cb-a num\">${fmt(s.exp)}</span></button>`).join(\"\")}</div>",
"     ${ed?`<button class=\"btn small\" id=\"ptUn\" type=\"button\">\u0625\u0644\u063a\u0627\u0621 \u0622\u062e\u0631 \u062a\u0635\u0641\u064a\u0629</button>`:\"\"}`:\"\"}`;",
"  $(\"#ptBack\").onclick=()=>{ptSel=\"\";drawPetty();window.scrollTo(0,0)};",
"  if(ed){$(\"#ptEditP\").onclick=()=>ptPersonUI(P);$(\"#ptExp\").onclick=()=>ptTxUI(P,null,\"exp\");$(\"#ptFund\").onclick=()=>ptTxUI(P,null,\"fund\");$(\"#ptRet\").onclick=()=>ptTxUI(P,null,\"ret\");",
"    document.querySelectorAll(\"[data-tx]\").forEach(b=>b.onclick=()=>ptTxUI(P,D.tx.find(t=>t.id===b.dataset.tx)));",
"    const s=$(\"#ptSettle\");if(s)s.onclick=()=>ptSettleUI(P);const u=$(\"#ptUn\");if(u)u.onclick=()=>ptUnsettleUI(P)}",
"  document.querySelectorAll(\"[data-pst]\").forEach(b=>b.onclick=()=>ptPrint(P,D.settles.find(s=>s.id===b.dataset.pst)));",
"}",
"async function ptCall(action,p,msg){try{ptData=await api(action,p);ptRev=lastRev;drawPetty();if(msg)toast(msg);return ptData}catch(e){toast(e.msg||\"\u062a\u0639\u0630\u0651\u0631 \u0627\u0644\u062d\u0641\u0638\");return null}}",
"function ptPersonUI(P){",
"  const s=sheet(P?\"\u062a\u0639\u062f\u064a\u0644 \u0635\u0627\u062d\u0628 \u0627\u0644\u0639\u0647\u062f\u0629\":\"\u0635\u0627\u062d\u0628 \u0639\u0647\u062f\u0629 \u062c\u062f\u064a\u062f\",`<datalist id=\"ptDl\">${phoneNames().map(n=>`<option value=\"${esc(n)}\">`).join(\"\")}</datalist>",
"   <div class=\"field\"><label for=\"ptName\">\u0627\u0644\u0627\u0633\u0645</label><input class=\"inp\" id=\"ptName\" list=\"ptDl\" maxlength=\"60\" autocomplete=\"off\" value=\"${esc(P?P.name:\"\")}\"></div>",
"   <div class=\"field\"><label for=\"ptAmt\">\u0645\u0628\u0644\u063a \u0627\u0644\u0639\u0647\u062f\u0629</label><input class=\"inp money\" id=\"ptAmt\" inputmode=\"decimal\" value=\"${P?esc(P.amount):\"\"}\" placeholder=\"0.00\"></div>",
"   ${P?`<label class=\"chk\"><input type=\"checkbox\" id=\"ptAct\" ${P.active?\"checked\":\"\"}>\u0627\u0644\u0639\u0647\u062f\u0629 \u0641\u0639\u0651\u0627\u0644\u0629</label><p class=\"note\">\u062a\u063a\u064a\u064a\u0631 \u0645\u0628\u0644\u063a \u0627\u0644\u0639\u0647\u062f\u0629 \u0647\u0646\u0627 \u0645\u0627 \u064a\u0635\u0631\u0641 \u0634\u064a\u060c \u0644\u0644\u0635\u0631\u0641 \u0627\u0633\u062a\u062e\u062f\u0645 \u00ab\u0635\u0631\u0641 / \u062a\u0639\u0632\u064a\u0632\u00bb.</p>`:`<p class=\"note\">\u064a\u064f\u0633\u062c\u064e\u0651\u0644 \u0645\u0628\u0644\u063a \u0627\u0644\u0639\u0647\u062f\u0629 \u0643\u0623\u0648\u0644 \u0635\u0631\u0641 \u0644\u0635\u0627\u062d\u0628\u0647\u0627 \u0628\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u064a\u0648\u0645.</p>`}`,",
"   `<button class=\"btn primary\" id=\"ptSave\">\u062d\u0641\u0638</button><button class=\"btn\" data-close>\u0625\u0644\u063a\u0627\u0621</button>`);",
"  $(\"#ptSave\").onclick=async()=>{const name=$(\"#ptName\").value.trim(),amount=num($(\"#ptAmt\").value);if(!name){toast(\"\u0627\u0643\u062a\u0628 \u0627\u0644\u0627\u0633\u0645\");return}",
"    const b=$(\"#ptSave\");b.disabled=true;const r=await ptCall(\"ptPerson\",{id:P?P.id:\"\",name,amount,active:P?$(\"#ptAct\").checked:true},\"\u062a\u0645 \u0627\u0644\u062d\u0641\u0638\");",
"    if(r){s.close();if(!P){const n=r.people.find(x=>x.name===name.replace(/\\s+/g,\" \"));if(n){ptSel=n.id;drawPetty()}}}else b.disabled=false};",
"}",
"function ptTxUI(P,t,kind){",
"  kind=t?t.kind:kind;const tdy=todayISO();",
"  const s=sheet(`${t?\"\u062a\u0639\u062f\u064a\u0644\":\"\u0625\u0636\u0627\u0641\u0629\"} ${PT_KIND[kind]}`,`",
"   <div class=\"field\"><label for=\"ptDate\">\u0627\u0644\u062a\u0627\u0631\u064a\u062e</label><input class=\"inp\" id=\"ptDate\" type=\"date\" ${settings.allowFuture?\"\":`max=\"${tdy}\"`} value=\"${t?t.date:tdy}\"></div>",
"   <div class=\"field\"><label for=\"ptDesc\">\u0627\u0644\u0628\u064a\u0627\u0646</label><input class=\"inp\" id=\"ptDesc\" maxlength=\"120\" autocomplete=\"off\" value=\"${esc(t?t.desc:kind===\"fund\"?\"\u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u0639\u0647\u062f\u0629\":kind===\"ret\"?\"\u0625\u0631\u062c\u0627\u0639 \u0646\u0642\u062f\u064a \u0645\u0646 \u0627\u0644\u0639\u0647\u062f\u0629\":\"\")}\" placeholder=\"${kind===\"exp\"?\"\u0645\u062b\u0627\u0644: \u0645\u0648\u0627\u062f \u0646\u0638\u0627\u0641\u0629\":\"\"}\"></div>",
"   ${kind===\"exp\"?`<div class=\"field\"><label for=\"ptRef\">\u0631\u0642\u0645 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629</label><input class=\"inp\" id=\"ptRef\" maxlength=\"40\" dir=\"ltr\" autocomplete=\"off\" value=\"${esc(t?t.ref:\"\")}\" placeholder=\"\u0627\u062e\u062a\u064a\u0627\u0631\u064a\"></div>`:\"\"}",
"   <div class=\"field\"><label for=\"ptAm\">\u0627\u0644\u0645\u0628\u0644\u063a</label><input class=\"inp money\" id=\"ptAm\" inputmode=\"decimal\" value=\"${t?esc(t.amount):\"\"}\" placeholder=\"0.00\"></div>",
"   ${kind===\"exp\"&&P.balance>0?`<p class=\"note\">\u0631\u0635\u064a\u062f \u0627\u0644\u0639\u0647\u062f\u0629 \u0627\u0644\u062d\u0627\u0644\u064a ${fmt(P.balance)}</p>`:\"\"}`,",
"   `${t?`<button class=\"btn danger\" id=\"ptDel\">\u062d\u0630\u0641</button>`:\"\"}<button class=\"btn primary\" id=\"ptSv\">\u062d\u0641\u0638</button>`);",
"  $(\"#ptSv\").onclick=async()=>{const date=$(\"#ptDate\").value,desc=$(\"#ptDesc\").value.trim(),amount=num($(\"#ptAm\").value),ref=kind===\"exp\"?$(\"#ptRef\").value.trim():\"\";",
"    if(!date){toast(\"\u0627\u062e\u062a\u0631 \u0627\u0644\u062a\u0627\u0631\u064a\u062e\");return}if(isFuture(date)&&!settings.allowFuture){toast(\"\u0645\u0627 \u064a\u0645\u0643\u0646 \u0627\u0644\u0625\u062f\u062e\u0627\u0644 \u0628\u062a\u0627\u0631\u064a\u062e \u0644\u0627\u062d\u0642\");return}if(!desc){toast(\"\u0627\u0643\u062a\u0628 \u0627\u0644\u0628\u064a\u0627\u0646\");return}if(!(amount>0)){toast(\"\u0627\u0643\u062a\u0628 \u0645\u0628\u0644\u063a\u0627\u064b \u0623\u0643\u0628\u0631 \u0645\u0646 \u0635\u0641\u0631\");return}",
"    if(kind===\"exp\"&&!t&&amount>P.balance+0.001&&!await ask(`\u0627\u0644\u0645\u0635\u0631\u0648\u0641 (${fmt(amount)}) \u0623\u0643\u0628\u0631 \u0645\u0646 \u0631\u0635\u064a\u062f \u0627\u0644\u0639\u0647\u062f\u0629 (${fmt(P.balance)}). \u062a\u0633\u062c\u0651\u0644\u0647\u061f`,[{t:\"\u062a\u0633\u062c\u064a\u0644\",v:1,cls:\"primary\"},{t:\"\u0625\u0644\u063a\u0627\u0621\",v:0}]))return;",
"    const b=$(\"#ptSv\");if(b)b.disabled=true;if(await ptCall(\"ptTx\",{id:t?t.id:\"\",pid:P.id,kind,date,desc,ref,amount},\"\u062a\u0645 \u0627\u0644\u062d\u0641\u0638\"))$(\"#layer\").innerHTML=\"\";else if(b)b.disabled=false};",
"  const d=$(\"#ptDel\");if(d)d.onclick=async()=>{s.close();if(await ask(`\u062d\u0630\u0641 \u00ab${esc(t.desc)}\u00bb \u0628\u0645\u0628\u0644\u063a ${fmt(t.amount)}\u061f`,[{t:\"\u062d\u0630\u0641\",v:1,cls:\"danger\"},{t:\"\u0625\u0644\u063a\u0627\u0621\",v:0}]))await ptCall(\"ptDel\",{id:t.id},\"\u062a\u0645 \u0627\u0644\u062d\u0630\u0641\")};",
"}",
"function ptSettleUI(P){",
"  const open=ptData.tx.filter(t=>t.pid===P.id&&!t.settle&&t.kind===\"exp\");",
"  const s=sheet(\"\u062a\u0635\u0641\u064a\u0629 \u0627\u0644\u0639\u0647\u062f\u0629\",`<p style=\"margin:6px 0\">\u062a\u0635\u0641\u064a\u0629 <b>${open.length}</b> \u0641\u0627\u062a\u0648\u0631\u0629 \u0644\u0640 <b>${esc(P.name)}</b> \u0628\u0625\u062c\u0645\u0627\u0644\u064a <b class=\"num\">${fmt(P.openExp)}</b>.</p>",
"   <label class=\"chk\"><input type=\"checkbox\" id=\"ptRefill\" checked>\u0627\u0633\u062a\u0639\u0627\u0636\u0629 \u0627\u0644\u0645\u0635\u0631\u0648\u0641 (\u064a\u064f\u0635\u0631\u0641 \u0644\u0647 ${fmt(P.openExp)} \u0644\u062a\u0631\u062c\u0639 \u0639\u0647\u062f\u062a\u0647)</label>",
"   <p class=\"note\">\u0628\u0639\u062f \u0627\u0644\u062a\u0635\u0641\u064a\u0629 \u062a\u062a\u0642\u0641\u0644 \u0647\u0630\u0647 \u0627\u0644\u0641\u0648\u0627\u062a\u064a\u0631 \u0639\u0646 \u0627\u0644\u062a\u0639\u062f\u064a\u0644\u060c \u0648\u064a\u0637\u0644\u0639 \u0646\u0645\u0648\u0630\u062c \u0627\u0644\u062a\u0635\u0641\u064a\u0629 \u0644\u0644\u0637\u0628\u0627\u0639\u0629 \u0648\u0627\u0644\u062a\u0648\u0642\u064a\u0639.</p>`,",
"   `<button class=\"btn primary\" id=\"ptGo\">\u062a\u0635\u0641\u064a\u0629</button><button class=\"btn\" data-close>\u0625\u0644\u063a\u0627\u0621</button>`);",
"  $(\"#ptGo\").onclick=async()=>{const refill=$(\"#ptRefill\").checked;s.close();const r=await ptCall(\"ptSettle\",{pid:P.id,refill},\"\u062a\u0645\u062a \u062a\u0635\u0641\u064a\u0629 \u0627\u0644\u0639\u0647\u062f\u0629\");",
"    if(r&&r.settled){const P2=r.people.find(x=>x.id===P.id),S=r.settles.find(x=>x.id===r.settled);if(P2&&S)ptPrint(P2,S)}};",
"}",
"async function ptUnsettleUI(P){",
"  const last=ptData.settles.filter(s=>s.pid===P.id)[0];if(!last)return;",
"  if(await ask(`\u0625\u0644\u063a\u0627\u0621 \u0627\u0644\u062a\u0635\u0641\u064a\u0629 \u0631\u0642\u0645 ${last.no}\u061f \u062a\u0631\u062c\u0639 \u0641\u0648\u0627\u062a\u064a\u0631\u0647\u0627 \u0645\u0641\u062a\u0648\u062d\u0629${last.refill?\"\u060c \u0648\u062a\u064f\u062d\u0630\u0641 \u0627\u0644\u0627\u0633\u062a\u0639\u0627\u0636\u0629 \u0627\u0644\u0645\u0631\u062a\u0628\u0637\u0629 \u0628\u0647\u0627\":\"\"}.`,[{t:\"\u0625\u0644\u063a\u0627\u0621 \u0627\u0644\u062a\u0635\u0641\u064a\u0629\",v:1,cls:\"danger\"},{t:\"\u0631\u062c\u0648\u0639\",v:0}]))await ptCall(\"ptUnsettle\",{pid:P.id},\"\u062a\u0645 \u0625\u0644\u063a\u0627\u0621 \u0627\u0644\u062a\u0635\u0641\u064a\u0629\");",
"}",
"function ptPrint(P,S){",
"  const items=ptData.tx.filter(t=>t.settle===S.id&&t.kind===\"exp\");",
"  const html=`<div class=\"rcpt\">${head(\"\u0646\u0645\u0648\u0630\u062c \u062a\u0635\u0641\u064a\u0629 \u0639\u0647\u062f\u0629\",`<div class=\"c\" style=\"font-weight:700\">\u062a\u0635\u0641\u064a\u0629 \u0631\u0642\u0645 ${S.no} \u2014 ${esc(P.name)}</div><div class=\"c\">\u0627\u0644\u0641\u062a\u0631\u0629 \u0645\u0646 ${dmy(S.from)} \u0625\u0644\u0649 ${dmy(S.to)}</div>`)}",
"   <table><thead><tr><th>\u0627\u0644\u062a\u0627\u0631\u064a\u062e</th><th>\u0627\u0644\u0628\u064a\u0627\u0646</th><th>\u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629</th><th>\u0627\u0644\u0645\u0628\u0644\u063a</th></tr></thead><tbody>",
"   ${items.map(t=>`<tr><td class=\"num\">${dmy(t.date).slice(0,5)}</td><td>${esc(t.desc)}</td><td class=\"num\">${esc(t.ref||\"\u2014\")}</td><td class=\"num\">${fmt(t.amount)}</td></tr>`).join(\"\")}",
"   <tr><td></td><td><b>\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0635\u0631\u0648\u0641\u0627\u062a</b></td><td></td><td class=\"num\"><b>${fmt(S.exp)}</b></td></tr></tbody></table>",
"   <table><tbody><tr><td>\u0645\u0628\u0644\u063a \u0627\u0644\u0639\u0647\u062f\u0629</td><td class=\"num\">${fmt(P.amount)}</td></tr><tr><td>\u0627\u0644\u0627\u0633\u062a\u0639\u0627\u0636\u0629</td><td class=\"num\">${S.refill?fmt(S.refill):\"\u0628\u062f\u0648\u0646\"}</td></tr><tr><td><b>\u0627\u0644\u0631\u0635\u064a\u062f \u0628\u0639\u062f \u0627\u0644\u062a\u0635\u0641\u064a\u0629</b></td><td class=\"num\"><b>${fmt(S.balance)}</b></td></tr></tbody></table>",
"   <div class=\"sig\"><div>\u0635\u0627\u062d\u0628 \u0627\u0644\u0639\u0647\u062f\u0629</div><div>\u0627\u0644\u0645\u062d\u0627\u0633\u0628</div></div><div class=\"sig\"><div>\u0627\u0644\u0645\u062f\u064a\u0631</div><div></div></div></div>`;",
"  preview(\"\u0646\u0645\u0648\u0630\u062c \u062a\u0635\u0641\u064a\u0629 \u0639\u0647\u062f\u0629\",html,`\u062a\u0635\u0641\u064a\u0629-\u0639\u0647\u062f\u0629-${xname(P.name)}-${S.no}.pdf`);",
"}",
"/* ---------- foreign currencies received in a box ---------- */",
"const FXL=[[\"USD\",\"\u062f\u0648\u0644\u0627\u0631 \u0623\u0645\u0631\u064a\u0643\u064a\",3.75],[\"AED\",\"\u062f\u0631\u0647\u0645 \u0625\u0645\u0627\u0631\u0627\u062a\u064a\",1.02],[\"KWD\",\"\u062f\u064a\u0646\u0627\u0631 \u0643\u0648\u064a\u062a\u064a\",12.2],[\"BHD\",\"\u062f\u064a\u0646\u0627\u0631 \u0628\u062d\u0631\u064a\u0646\u064a\",9.95],[\"QAR\",\"\u0631\u064a\u0627\u0644 \u0642\u0637\u0631\u064a\",1.03],[\"OMR\",\"\u0631\u064a\u0627\u0644 \u0639\u0645\u0627\u0646\u064a\",9.74]];",
"const fxCfg=()=>settings.fx||{};",
"const fxName=c=>(FXL.find(x=>x[0]===c)||[c,c])[1];",
"const fxList=()=>{const F=fxCfg();return F.on?FXL.filter(x=>((F.cur||{})[x[0]]||{}).on):[]};",
"const fxOn=()=>fxList().length>0;",
"const fxTrack=()=>fxCfg().mode===\"track\";",
"const fxRateNow=c=>+(((fxCfg().cur||{})[c]||{}).rate)||(FXL.find(x=>x[0]===c)||[0,0,0])[2];",
"const fxRate=(b,c)=>+((b.fxr||{})[c])||fxRateNow(c);",
"const fmtR=v=>(+v||0).toLocaleString(\"en-US\",{minimumFractionDigits:2,maximumFractionDigits:4});",
"const fxSar=b=>r2(Object.keys(b.fxd||{}).reduce((a,c)=>a+(+b.fxd[c]||0)*fxRate(b,c),0));",
"const fxHas=b=>!!b&&Object.keys(b.fxd||{}).some(c=>+b.fxd[c]>0);",
"const fxCashSar=b=>b.cashSar!=null?+b.cashSar:r2((+b.cash||0)-fxSar(b));",
"function fxSync(b){if(b.cashSar==null&&!fxHas(b))return;b.cash=r2((+b.cashSar||0)+fxSar(b))}",
"function fxShown(b){const L=fxList().map(x=>x[0]);Object.keys(b.fxd||{}).forEach(c=>{if(L.indexOf(c)<0&&+b.fxd[c]>0)L.push(c)});return L}",
"function fxBlock(b){",
"  const L=fxShown(b);if(!L.length)return\"\";",
"  return`<div class=\"group-h\">\u0639\u0645\u0644\u0627\u062a \u0623\u062c\u0646\u0628\u064a\u0629</div>${L.map(c=>`<div class=\"field\"><label for=\"fx-${c}\">${fxName(c)} <span class=\"note num\" dir=\"ltr\">\u00d7 ${fmtR(fxRate(b,c))}</span></label><div class=\"mwrap\"><input class=\"inp money\" id=\"fx-${c}\" data-fx=\"${c}\" inputmode=\"decimal\" autocomplete=\"off\" placeholder=\"0\" value=\"${+((b.fxd||{})[c])?esc(b.fxd[c]):\"\"}\"><small class=\"xh\" id=\"fxs-${c}\"></small></div></div>`).join(\"\")}",
"   <div class=\"calc\"><span>\u0627\u0644\u0639\u0645\u0644\u0627\u062a \u0628\u0627\u0644\u0631\u064a\u0627\u0644</span><span class=\"num\" id=\"o-fx\"></span></div><div class=\"calc\"><span>\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0643\u0627\u0634 (\u0631\u064a\u0627\u0644 + \u0639\u0645\u0644\u0627\u062a)</span><span class=\"num\" id=\"o-cashall\"></span></div>`;",
"}",
"function fxInput(b,x){",
"  const c=x.dataset.fx,v=num(x.value),sar=fxCashSar(b);",
"  b.fxd=Object.assign({},b.fxd);b.fxr=Object.assign({},b.fxr);",
"  if(v>0){b.fxd[c]=v;if(!b.fxr[c])b.fxr[c]=fxRateNow(c)}else{delete b.fxd[c];delete b.fxr[c]}",
"  b.cashSar=sar;fxSync(b);fxPaint(b);",
"}",
"function fxPaint(b){",
"  fxShown(b).forEach(c=>{const e=$(\"#fxs-\"+c);if(e)e.textContent=+((b.fxd||{})[c])?\"= \"+fmt((b.fxd[c])*fxRate(b,c))+\" \u0631\u064a\u0627\u0644\":\"\"});",
"  const a=$(\"#o-fx\");if(a)a.textContent=fmt(fxSar(b));const t=$(\"#o-cashall\");if(t)t.textContent=fmt(b.cash);",
"}",
"/* the day's currencies, for the summary screen */",
"function fxDay(day){",
"  const T={};(day.boxes||[]).forEach((b,i)=>{if(!fxHas(b))return;Object.keys(b.fxd).forEach(c=>{const a=+b.fxd[c]||0;if(!a)return;const o=T[c]||(T[c]={amt:0,sar:0,boxes:[]});o.amt+=a;o.sar+=a*fxRate(b,c);o.boxes.push(BN(i))})});",
"  return T;",
"}",
"function fxSummaryCard(day){",
"  const T=fxDay(day),K=Object.keys(T);if(!K.length)return\"\";",
"  const tot=r2(K.reduce((a,c)=>a+T[c].sar,0));",
"  return`<div class=\"card\"><h2 style=\"margin-bottom:6px\">\u0627\u0644\u0639\u0645\u0644\u0627\u062a \u0627\u0644\u0623\u062c\u0646\u0628\u064a\u0629</h2>${K.map(c=>`<div class=\"calc\" style=\"font-weight:400\"><span>${fxName(c)} <span class=\"note num\">${fmtR(T[c].amt)}</span><span class=\"note\"> \u00b7 \u0635\u0646\u0627\u062f\u064a\u0642 ${T[c].boxes.join(\"\u060c \")}</span></span><span class=\"num\">${fmt(T[c].sar)}</span></div>`).join(\"\")}",
"   <div class=\"calc\"><span>\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a \u0628\u0627\u0644\u0631\u064a\u0627\u0644${fxTrack()?\"\":\" (\u0645\u0636\u0627\u0641 \u0644\u0644\u0643\u0627\u0634)\"}</span><span class=\"num\">${fmt(tot)}</span></div>${fxTrack()?`<p class=\"note\" style=\"margin:6px 0 0\">\u0627\u0644\u0639\u0645\u0644\u0627\u062a \u0645\u062d\u0633\u0648\u0628\u0629 \u0636\u0645\u0646 \u0643\u0627\u0634 \u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642\u060c \u0648\u062a\u0638\u0647\u0631 \u0647\u0646\u0627 \u0648\u0641\u064a \u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u0645\u0646\u0641\u0635\u0644\u0629 \u0644\u0644\u0645\u062a\u0627\u0628\u0639\u0629.</p>`:\"\"}</div>`;",
"}",
