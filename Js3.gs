"  A.months.forEach(m=>rows.push([MONTHS[+m.key.slice(5)-1]+\" \"+m.key.slice(0,4),m.days,r2(m.cashNet),r2(m.net),r2(m.ret),r2(m.reportNet),r2(m.diff)]));",
"  return{name:\"\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0634\u0647\u0631\u064a\",rows,ints:[1],cols:[16]};",
"}",
